    <string name="app_example_dishwasher_a_name">雨涵</string>
    <string name="app_example_dishwasher_a">你又把碗放上层了。碗放上面从来洗不干净，下层就是放碗的。</string>
    <string name="app_example_dishwasher_b_name">子豪</string>
    <string name="app_example_dishwasher_b">上层放得下啊，下层正好留给锅。我这么放好几年了，从来都洗得干干净净。</string>
    <string name="app_example_bill_a_name">佳怡</string>
    <string name="app_example_bill_a">我一口酒都没喝，不该摊四分之一的酒钱吧。菜钱平摊我没意见。</string>
    <string name="app_example_bill_b_name">俊杰</string>
    <string name="app_example_bill_b">我们一直都是四个人平摊。每次都算谁吃了什么太麻烦了，反正也差不了多少。</string>
    <string name="app_example_thermostat_a_name">婷婷</string>
    <string name="app_example_thermostat_a">屋里才 19 度，我穿着卫衣还冷。把空调调到 22 度不算过分吧。</string>
    <string name="app_example_thermostat_b_name">浩宇</string>
    <string name="app_example_thermostat_b">22 度太热了，根本睡不着。你可以再加件衣服，我可没法再脱了。</string>
    <string name="app_example_road_trip_a_name">志明</string>
    <string name="app_example_road_trip_a">去的时候六个小时全是我开的。回来该你开了，这才公平。</string>
    <string name="app_example_road_trip_b_name">晓峰</string>
    <string name="app_example_road_trip_b">出发前我就说过我最怕开夜车，可我们晚上 7 点才往回走。下次出去，早上那段都归我开。</string>
    <string name="app_example_seat_a_name">文静</string>
    <string name="app_example_seat_a">我的座椅能往后放，我就放了。这是红眼航班，大家都想睡觉。</string>
    <string name="app_example_seat_b_name">大伟</string>
    <string name="app_example_seat_b">我身高一米九，膝盖本来就顶着你的椅背了。你一下子放到底之前，至少问一声吧。</string>
    <string name="app_example_spoiler_a_name">小雪</string>
    <string name="app_example_spoiler_a">我最后一集还没点开，你就把凶手是谁说出来了。我等这一集等了一整个星期。</string>
    <string name="app_example_spoiler_b_name">阿杰</string>
    <string name="app_example_spoiler_b">都播了三个星期了，你自己也说看完了。谁看到哪一集，我哪记得过来。</string>
    <string name="app_example_jacket_a_name">欣然</string>
    <string name="app_example_jacket_a">你没问我一声，就穿我的牛仔外套去看演唱会了，还回来一股烟味。</string>
    <string name="app_example_jacket_b_name">宇轩</string>
    <string name="app_example_jacket_b">它就挂在门口，你又从来不穿。我本来想问的，可你在睡觉，我又已经迟到了。</string>
    <string name="app_example_last_slice_a_name">大鹏</string>
    <string name="app_example_last_slice_a">电影开场前我就说了“最后一块披萨是我的”，大家都听见了。</string>
    <string name="app_example_last_slice_b_name">佳佳</string>
    <string name="app_example_last_slice_b">说了“是我的”，然后两个小时都不碰，这可不行。放在那儿都凉了，我就吃了。</string>
