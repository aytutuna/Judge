    <string name="app_example_dishwasher_a_name">Ana</string>
    <string name="app_example_dishwasher_a">Sklede si spet zložil v zgornjo košaro. Tam se nikoli ne pomijejo do konca, za to je spodnja.</string>
    <string name="app_example_dishwasher_b_name">Matic</string>
    <string name="app_example_dishwasher_b">Zgoraj čisto lepo gredo, spodaj pa ostane prostor za lonce. Pomivalni stroj tako polnim že leta in še nikoli ni nič ostalo umazano.</string>
    <string name="app_example_bill_a_name">Petra</string>
    <string name="app_example_bill_a">Nisem nič pila, zato ne bi smela plačati četrtine vina. Hrano pa lahko razdelimo na enake dele, s tem se strinjam.</string>
    <string name="app_example_bill_b_name">Jure</string>
    <string name="app_example_bill_b">Vedno vse razdelimo na štiri. Vsakič računati, kdo je kaj imel, je muka, razlika pa tako ali tako ni velika.</string>
    <string name="app_example_thermostat_a_name">Nina</string>
    <string name="app_example_thermostat_a">Tukaj je 19 stopinj in me zebe celo v puloverju s kapuco. 22 stopinj res ni pretirano.</string>
    <string name="app_example_thermostat_b_name">Gašper</string>
    <string name="app_example_thermostat_b">Pri 22 stopinjah se ne da spati, prevroče je. Ti lahko oblečeš še eno plast, jaz pa ne morem sleči ničesar več.</string>
    <string name="app_example_road_trip_a_name">Tina</string>
    <string name="app_example_road_trip_a">Celih šest ur tja sem vozila jaz. Pošteno je, da nazaj voziš ti.</string>
    <string name="app_example_road_trip_b_name">Rok</string>
    <string name="app_example_road_trip_b">Že pred odhodom sem rekel, da ponoči ne maram voziti, odhajamo pa ob sedmih zvečer. Na naslednjem izletu bom zjutraj vozil jaz.</string>
    <string name="app_example_seat_a_name">Sara</string>
    <string name="app_example_seat_a">Moj sedež se da nagniti, zato ga nagnem. Nočni let je, vsi poskušajo spati.</string>
    <string name="app_example_seat_b_name">Blaž</string>
    <string name="app_example_seat_b">Visok sem 1,91 m in s koleni že tako tiščim v tvoj sedež. Lahko bi vsaj vprašala, preden ga spustiš čisto nazaj.</string>
    <string name="app_example_spoiler_a_name">Maja</string>
    <string name="app_example_spoiler_a">Povedal si mi, kdo je morilec, še preden sem sploh začela zadnjo epizodo. Ves teden sem čakala nanjo.</string>
    <string name="app_example_spoiler_b_name">Jan</string>
    <string name="app_example_spoiler_b">Serija je izšla pred tremi tedni, ti pa si rekla, da si jo že pogledala do konca. Ne morem si zapomniti, do kod je kdo prišel.</string>
    <string name="app_example_jacket_a_name">Matej</string>
    <string name="app_example_jacket_a">Mojo jeans jakno si brez vprašanja oblekla na koncert. Vrnila si mi jo vso prepojeno z dimom.</string>
    <string name="app_example_jacket_b_name">Eva</string>
    <string name="app_example_jacket_b">Visela je pri vratih, ti pa je nikoli ne nosiš. Vprašala bi te, ampak si spal, jaz pa sem že tako zamujala.</string>
    <string name="app_example_last_slice_a_name">Nejc</string>
    <string name="app_example_last_slice_a">Še pred filmom sem rekel: „Zadnji kos je moj.“ Vsi so slišali.</string>
    <string name="app_example_last_slice_b_name">Lara</string>
    <string name="app_example_last_slice_b">Ne moreš si rezervirati kosa in se ga potem dve uri ne dotakniti. Kar ležal je tam in se hladil, zato sem ga pojedla.</string>
