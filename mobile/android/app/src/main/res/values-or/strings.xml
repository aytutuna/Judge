    <string name="app_example_dishwasher_a_name">Alex</string>
    <string name="app_example_dishwasher_a">You put the bowls on the top rack again. They never come out clean up there, that\'s what the bottom is for.</string>
    <string name="app_example_dishwasher_b_name">Sam</string>
    <string name="app_example_dishwasher_b">They fit fine up there and it leaves the bottom free for the pans. I\'ve loaded it like this for years and nothing\'s come out dirty.</string>
    <string name="app_example_bill_a_name">Priya</string>
    <string name="app_example_bill_a">I didn\'t drink anything, so I shouldn\'t pay a quarter of the wine. Splitting the food evenly is fine with me.</string>
    <string name="app_example_bill_b_name">Jordan</string>
    <string name="app_example_bill_b">We always just split it four ways. Working out who had what every time is a pain, and it\'s not much of a difference anyway.</string>
    <string name="app_example_thermostat_a_name">Taylor</string>
    <string name="app_example_thermostat_a">It\'s 19 degrees in here and I\'m cold even in a hoodie. Turning it up to 22 isn\'t crazy.</string>
    <string name="app_example_thermostat_b_name">Chris</string>
    <string name="app_example_thermostat_b">22 is way too warm to sleep in. You can put on another layer, I can\'t take anything else off.</string>
    <string name="app_example_road_trip_a_name">Morgan</string>
    <string name="app_example_road_trip_a">I drove the whole six hours there. It\'s only fair that you drive us back.</string>
    <string name="app_example_road_trip_b_name">Riley</string>
    <string name="app_example_road_trip_b">I said before we left that I hate driving at night, and we\'re leaving at 7. I\'ll take the morning drives next trip.</string>
    <string name="app_example_seat_a_name">Jamie</string>
    <string name="app_example_seat_a">My seat reclines, so I\'m reclining it. It\'s a night flight and everyone\'s trying to sleep.</string>
    <string name="app_example_seat_b_name">Casey</string>
    <string name="app_example_seat_b">I\'m 6\'3\" and my knees are already pressed into your seat. You could at least ask before dropping it all the way back.</string>
    <string name="app_example_spoiler_a_name">Maya</string>
    <string name="app_example_spoiler_a">You told me who the killer was before I\'d even started the last episode. I\'d been waiting all week for it.</string>
    <string name="app_example_spoiler_b_name">Leo</string>
    <string name="app_example_spoiler_b">It came out three weeks ago and you said you\'d finished it. I can\'t keep track of where everyone is.</string>
    <string name="app_example_jacket_a_name">Noah</string>
    <string name="app_example_jacket_a">You wore my denim jacket to the concert without asking. It came back smelling like smoke.</string>
    <string name="app_example_jacket_b_name">Ava</string>
    <string name="app_example_jacket_b">It was hanging by the door and you never wear it. I would\'ve asked, but you were asleep and I was already late.</string>
    <string name="app_example_last_slice_a_name">Ben</string>
    <string name="app_example_last_slice_a">I called dibs on the last slice before the movie started. Everyone heard me.</string>
    <string name="app_example_last_slice_b_name">Lily</string>
    <string name="app_example_last_slice_b">You can\'t call dibs and then not touch it for two hours. It was just sitting there going cold, so I ate it.</string>
