    <string name="app_home_example">試試範例</string>
    <string name="app_example_dishwasher_a_name">怡君</string>
    <string name="app_example_dishwasher_a">你又把碗放在上層了。放上面根本洗不乾淨，下層就是放碗的地方。</string>
    <string name="app_example_dishwasher_b_name">家豪</string>
    <string name="app_example_dishwasher_b">碗放上面剛剛好，下層還能空出來放鍋子。我這樣放好幾年了，從來沒洗不乾淨過。</string>
    <string name="app_example_bill_a_name">雅婷</string>
    <string name="app_example_bill_a">我一口酒都沒喝，不該分攤四分之一的酒錢。菜錢平分我沒意見。</string>
    <string name="app_example_bill_b_name">冠宇</string>
    <string name="app_example_bill_b">我們每次都直接四個人平分啊。一項一項算誰點了什麼很麻煩，反正也差不了多少。</string>
    <string name="app_example_thermostat_a_name">佩珊</string>
    <string name="app_example_thermostat_a">冷氣開 22 度，我穿帽T還是冷。調到 26 度不過分吧。</string>
    <string name="app_example_thermostat_b_name">俊傑</string>
    <string name="app_example_thermostat_b">26 度太熱了，根本睡不著。你可以多穿一件，我已經沒東西可以脫了。</string>
    <string name="app_example_road_trip_a_name">詩涵</string>
    <string name="app_example_road_trip_a">去程六個小時都是我開的。回程換你開才公平。</string>
    <string name="app_example_road_trip_b_name">志豪</string>
    <string name="app_example_road_trip_b">出發前我就說過我很討厭開夜車，回程又是晚上 7 點才出發。下次出去玩，早上的路段都我來開。</string>
    <string name="app_example_seat_a_name">佳穎</string>
    <string name="app_example_seat_a">我的椅背可以往後倒，我就倒啊。這是夜間航班，大家都想睡覺。</string>
    <string name="app_example_seat_b_name">宗翰</string>
    <string name="app_example_seat_b">我身高 190 公分，膝蓋早就頂到你的椅背了。你要整個倒到底之前，至少可以先問一下吧。</string>
    <string name="app_example_spoiler_a_name">欣怡</string>
    <string name="app_example_spoiler_a">我最後一集都還沒開始看，你就跟我說兇手是誰。那集我等了一整個禮拜。</string>
    <string name="app_example_spoiler_b_name">柏翰</string>
    <string name="app_example_spoiler_b">那集三週前就播了，而且你說你看完了。我哪記得每個人看到哪裡。</string>
    <string name="app_example_jacket_a_name">承恩</string>
    <string name="app_example_jacket_a">你沒問我就穿我的牛仔外套去演唱會。還回來的時候一身菸味。</string>
    <string name="app_example_jacket_b_name">子晴</string>
    <string name="app_example_jacket_b">外套就掛在門邊，你又從來不穿。我本來想問你，但你在睡覺，我又已經遲到了。</string>
    <string name="app_example_last_slice_a_name">彥廷</string>
    <string name="app_example_last_slice_a">電影開始前我就喊了「最後一片披薩是我的」，大家都有聽到。</string>
    <string name="app_example_last_slice_b_name">品妤</string>
    <string name="app_example_last_slice_b">喊了「我的」卻兩個小時都不碰，哪有這樣的。披薩放在那邊都快冷掉了，我就吃掉了。</string>
