    <string name="app_example_dishwasher_b">Ne mahtuvat sinne ihan hyvin, ja alas jää tilaa kattiloille. Olen täyttänyt koneen näin vuosia, eikä mikään ole tullut likaisena ulos.</string>
    <string name="app_example_bill_a_name">Anna</string>
    <string name="app_example_bill_a">En juonut mitään, joten minun ei pitäisi maksaa neljäsosaa viineistä. Ruoan voi minun puolestani jakaa tasan.</string>
    <string name="app_example_bill_b_name">Jussi</string>
    <string name="app_example_bill_b">Jaamme laskun aina neljään osaan. On rasittavaa laskea joka kerta, kuka söi ja joi mitäkin, eikä ero ole edes iso.</string>
    <string name="app_example_thermostat_a_name">Sanna</string>
    <string name="app_example_thermostat_a">Täällä on 19 astetta, ja minulla on kylmä hupparissakin. Ei ole mitenkään hullua nostaa lämpöä 22 asteeseen.</string>
    <string name="app_example_thermostat_b_name">Antti</string>
    <string name="app_example_thermostat_b">22 astetta on aivan liian lämmin nukkumiseen. Sinä voit pukea lisää päälle, minä en voi riisua enempää.</string>
    <string name="app_example_road_trip_a_name">Elina</string>
    <string name="app_example_road_trip_a">Ajoin koko kuuden tunnin matkan sinne. On vain reilua, että sinä ajat takaisin.</string>
    <string name="app_example_road_trip_b_name">Tuomas</string>
    <string name="app_example_road_trip_b">Sanoin jo ennen lähtöä, että inhoan ajamista pimeällä, ja lähdemme vasta seitsemältä illalla. Seuraavalla reissulla ajan minä aamuisin.</string>
    <string name="app_example_seat_a_name">Johanna</string>
    <string name="app_example_seat_a">Selkänojani kallistuu, joten kallistan sitä. On yölento, ja kaikki yrittävät nukkua.</string>
    <string name="app_example_seat_b_name">Petri</string>
    <string name="app_example_seat_b">Olen 190-senttinen, ja polveni painavat jo valmiiksi penkkiäsi. Olisit voinut edes kysyä ennen kuin laskit selkänojan ihan pohjaan.</string>
    <string name="app_example_spoiler_a_name">Emilia</string>
    <string name="app_example_spoiler_a">Kerroit, kuka murhaaja oli, ennen kuin olin edes aloittanut viimeistä jaksoa. Olin odottanut sitä koko viikon.</string>
    <string name="app_example_spoiler_b_name">Lauri</string>
    <string name="app_example_spoiler_b">Se ilmestyi kolme viikkoa sitten, ja sanoit katsoneesi sen loppuun. En pysty pitämään kirjaa siitä, missä kohtaa kukin menee.</string>
    <string name="app_example_jacket_a_name">Veera</string>
    <string name="app_example_jacket_a">Pidit farkkutakkiani keikalla kysymättä lupaa. Kun sain sen takaisin, se haisi tupakalta.</string>
    <string name="app_example_jacket_b_name">Joonas</string>
    <string name="app_example_jacket_b">Se roikkui oven vieressä, etkä ikinä käytä sitä. Olisin kysynyt, mutta nukuit, ja olin jo valmiiksi myöhässä.</string>
    <string name="app_example_last_slice_a_name">Eetu</string>
    <string name="app_example_last_slice_a">Varasin viimeisen palan jo ennen kuin leffa alkoi. Kaikki kuulivat sen.</string>
    <string name="app_example_last_slice_b_name">Iida</string>
    <string name="app_example_last_slice_b">Ei voi varata palaa ja sitten jättää sitä koskematta kahdeksi tunniksi. Se vain jäähtyi siinä, joten söin sen.</string>
