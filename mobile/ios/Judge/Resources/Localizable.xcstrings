        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La conexión se cortó mientras Judge estaba en segundo plano. Vuelve a intentarlo y deja la app abierta hasta que llegue el veredicto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yhteys katkesi, kun Judge oli taustalla. Yritä uudelleen ja pidä sovellus auki, kunnes tuomio tulee."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion a été coupée pendant que Judge était en arrière-plan. Réessaie et garde l’appli ouverte jusqu’à l’arrivée du verdict."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Judge બૅકગ્રાઉન્ડમાં હતું ત્યારે કનેક્શન તૂટી ગયું. ફરી પ્રયાસ કરો અને ચુકાદો આવે ત્યાં સુધી ઍપ ખુલ્લી રાખો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "החיבור נקטע בזמן ש-Judge היה ברקע. אפשר לנסות שוב ולהשאיר את האפליקציה פתוחה עד שפסק הדין יגיע."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Judge बैकग्राउंड में था, तभी कनेक्शन टूट गया। फिर कोशिश करें, और फ़ैसला आने तक ऐप खुला रखें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veza se prekinula dok je Judge bio u pozadini. Pokušaj ponovno i ostavi aplikaciju otvorenu dok presuda ne stigne."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Megszakadt a kapcsolat, amíg a Judge a háttérben futott. Próbáld újra, és hagyd nyitva az appot, amíg megérkezik az ítélet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koneksi terputus saat Judge berjalan di latar belakang. Coba lagi, dan biarkan aplikasinya tetap terbuka sampai putusannya keluar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connessione si è interrotta mentre Judge era in background. Riprova e tieni l'app aperta finché non arriva il verdetto."
          }
