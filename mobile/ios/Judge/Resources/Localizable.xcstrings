        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desta vez a verificação na web não terminou, por isso os juízes decidiram sem ela."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verificarea pe web nu s-a încheiat de data asta, așa că judecătorii au decis fără ea."
