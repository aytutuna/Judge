      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جاء هذا الطلب من مصدر لا نعرفه. تأكّد من أن التطبيق محدَّث وحاول مجددًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অনুরোধটা এমন জায়গা থেকে এসেছে যেটা আমরা চিনি না। অ্যাপটা আপডেট করা আছে কি না দেখে আবার চেষ্টা করুন।"
