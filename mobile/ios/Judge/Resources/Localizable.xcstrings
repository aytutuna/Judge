        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "논쟁 내용은 외부 AI가 읽어요. 계속하면"
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "പുറത്തുള്ള ഒരു എഐ നിങ്ങളുടെ തർക്കങ്ങൾ വായിക്കും. തുടരുന്നതിലൂടെ നിങ്ങൾ ഞങ്ങളുടെ"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुमचे वाद बाहेरची एक AI सेवा वाचते. पुढे गेल्यास तुम्ही"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI luar membaca pertikaian anda. Dengan meneruskan, anda bersetuju dengan"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En ekstern KI leser diskusjonene dine. Ved å fortsette godtar du"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een externe AI leest je discussies. Door verder te gaan, ga je akkoord met het"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଏକ ବାହାର AI ଆପଣଙ୍କ ବିବାଦ ପଢ଼େ। ଆଗକୁ ବଢ଼ିଲେ ଆପଣ ଆମ"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤੁਹਾਡੀਆਂ ਬਹਿਸਾਂ ਇੱਕ ਬਾਹਰੀ AI ਸੇਵਾ ਪੜ੍ਹਦੀ ਹੈ। ਜਾਰੀ ਰੱਖ ਕੇ ਤੁਸੀਂ ਸਾਡੀ"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoje spory czyta zewnętrzna usługa AI. Kontynuując, akceptujesz"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma IA externa lê suas discussões. Ao continuar, você concorda com a"
