    "clarify.lead" : {
      "comment" : "Generated by mobile/shared/strings/export-strings.ts from lib/i18n.ts. Do not edit.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذه التفاصيل قد تغيّر مَن على حق. أجب عمّا تستطيع، أو تخطَّ الأسئلة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই খুঁটিনাটিগুলো বদলে দিতে পারে কে ঠিক। যতটা পারেন উত্তর দিন, নয়তো এড়িয়ে যান।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquests detalls podrien canviar qui té raó. Respon el que puguis, o deixa-ho estar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tyhle detaily můžou změnit, kdo má pravdu. Odpověz, na co můžeš, nebo přeskoč."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De her detaljer kan ændre, hvem der har ret. Svar på det, du kan, eller spring over."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Details könnten ändern, wer recht hat. Beantworte, was du kannst, oder überspring sie."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτές οι λεπτομέρειες μπορεί να αλλάξουν το ποιος έχει δίκιο. Απάντησε σε ό,τι μπορείς ή προσπέρασέ το."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These details could change who's right. Answer what you can, or skip."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos detalles podrían cambiar quién tiene razón. Responde lo que puedas o salta este paso."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nämä yksityiskohdat voivat muuttaa sen, kuka on oikeassa. Vastaa, mihin pystyt, tai ohita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces détails pourraient changer qui a raison. Réponds à ce que tu peux, ou passe."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આ વિગતોથી કોણ સાચું એ બદલાઈ શકે. જેટલા જવાબ આપી શકો એટલા આપો, અથવા છોડી દો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הפרטים האלה יכולים לשנות מי צודק. אפשר לענות על מה שידוע לך, או לדלג."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इन बातों से बदल सकता है कि कौन सही है। जितना पता हो, उतना बताएँ, या छोड़ दें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovi detalji mogli bi promijeniti tko je u pravu. Odgovori na što možeš ili preskoči."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezek a részletek megváltoztathatják, kinek van igaza. Válaszolj, amire tudsz, vagy hagyd ki."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Detail ini bisa mengubah siapa yang benar. Jawab yang kamu tahu, atau lewati."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questi dettagli potrebbero cambiare chi ha ragione. Rispondi a quello che puoi, oppure salta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次の点しだいで、どちらが正しいかが変わるかもしれません。わかる範囲で答えるか、スキップしてください。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಈ ವಿವರಗಳು ಯಾರು ಸರಿ ಎನ್ನುವುದನ್ನೇ ಬದಲಿಸಬಹುದು. ಗೊತ್ತಿರುವಷ್ಟು ಉತ್ತರಿಸಿ, ಇಲ್ಲವೇ ಬಿಟ್ಟುಬಿಡಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 내용에 따라 누가 맞는지가 달라질 수 있어요. 아는 만큼 답하거나 건너뛰세요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഈ വിവരങ്ങൾ അനുസരിച്ച് ആരാണ് ശരി എന്നത് മാറിയേക്കാം. പറ്റുന്നവയ്ക്ക് ഉത്തരം നൽകൂ, അല്ലെങ്കിൽ ഒഴിവാക്കൂ."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "या तपशिलांमुळे कोण बरोबर हे बदलू शकते. जमतील तेवढी उत्तरे द्या, किंवा सोडून द्या."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Butiran ini boleh mengubah siapa yang betul. Jawab mana yang boleh, atau langkau."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disse detaljene kan endre hvem som har rett. Svar på det du kan, eller hopp over."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze details kunnen bepalen wie gelijk heeft. Beantwoord wat je kunt, of sla over."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଏହି ବିବରଣୀ କିଏ ଠିକ୍ ତାହା ବଦଳାଇପାରେ। ଯେତିକି ଜାଣନ୍ତି ଉତ୍ତର ଦିଅନ୍ତୁ, ନହେଲେ ଛାଡ଼ିଦିଅନ୍ତୁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਇਨ੍ਹਾਂ ਗੱਲਾਂ ਨਾਲ ਬਦਲ ਸਕਦਾ ਹੈ ਕਿ ਕੌਣ ਸਹੀ ਹੈ। ਜਿੰਨਾ ਜਵਾਬ ਦੇ ਸਕੋ ਦਿਓ, ਜਾਂ ਛੱਡ ਦਿਓ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te szczegóły mogą zmienić to, kto ma rację. Odpowiedz, na co możesz, albo pomiń."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estes detalhes podem mudar quem tem razão. Responda o que puder, ou pule."
