    "appeal.lead" : {
      "comment" : "Generated by mobile/shared/strings/export-strings.ts from lib/i18n.ts. Do not edit.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل هناك شيء ناقص أو خاطئ؟ أضفه مرة واحدة، وسيعيد القضاة النظر في كل شيء. يكلّف حكمًا واحدًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কিছু বাদ পড়েছে বা ভুল হয়েছে? একবার যোগ করুন, বিচারকেরা সবকিছু আবার দেখবেন। খরচ 1টি রায়।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hi falta alguna cosa o hi ha algun error? Afegeix-ho un cop i els jutges ho tornaran a mirar tot. Costa 1 veredicte."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Něco chybí nebo nesedí? Doplň to jednou a soudci se na všechno podívají znovu. Stojí to 1 verdikt."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mangler der noget, eller er noget forkert? Tilføj det én gang, så kigger dommerne på det hele igen. Det koster 1 dom."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fehlt etwas oder stimmt etwas nicht? Ergänze es einmal, und die Richter sehen sich alles noch mal an. Kostet 1 Urteil."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Λείπει κάτι ή είναι λάθος; Πρόσθεσέ το μία φορά και οι κριτές ξανακοιτάζουν τα πάντα. Κοστίζει 1 απόφαση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Something missing or wrong? Add it once and the judges look at everything again. Costs 1 verdict."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Falta algo o hay algo mal? Añádelo una vez y los jueces vuelven a revisarlo todo. Cuesta 1 veredicto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puuttuuko jotain, tai onko jotain väärin? Lisää se kerran, niin tuomarit käyvät kaiken läpi uudelleen. Maksaa 1 tuomion."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il manque quelque chose ou il y a une erreur ? Précise-le une fois et les juges réexaminent tout. Ça coûte 1 verdict."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "કંઈ ખૂટે છે કે ખોટું છે? એક વાર ઉમેરો અને જજ બધું ફરી જોશે. 1 ચુકાદો વપરાશે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "משהו חסר או לא נכון? אפשר להוסיף אותו פעם אחת, והשופטים יבחנו הכול מחדש. זה עולה פסק דין אחד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुछ छूट गया या ग़लत है? एक बार जोड़ें और जज सब कुछ फिर से देखेंगे। इसमें 1 फ़ैसला लगता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nešto nedostaje ili nije točno? Dodaj to jednom i suci će ponovno pogledati sve. Troši 1 presudu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiányzik vagy téves valami? Add hozzá egyszer, és a bírák mindent újra átnéznek. Ez 1 ítéletbe kerül."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ada yang kurang atau salah? Tambahkan sekali, dan hakim akan menilai ulang semuanya. Memakai 1 putusan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manca qualcosa o c'è un errore? Aggiungilo una volta e i giudici riesaminano tutto. Costa 1 verdetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "抜けや間違いがありますか？　一度だけ補足すると、審査員がすべてをもう一度見直します。判定1回分を使います。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಏನಾದರೂ ಬಿಟ್ಟುಹೋಗಿದೆಯೇ ಅಥವಾ ತಪ್ಪಾಗಿದೆಯೇ? ಒಮ್ಮೆ ಸೇರಿಸಿ, ತೀರ್ಪುಗಾರರು ಎಲ್ಲವನ್ನೂ ಮತ್ತೆ ನೋಡುತ್ತಾರೆ. ಇದಕ್ಕೆ 1 ತೀರ್ಪು ಖರ್ಚಾಗುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "빠졌거나 잘못된 내용이 있나요? 한 번 추가할 수 있고, 추가하면 판사들이 전부 다시 살펴봐요. 판결 1회를 사용해요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
