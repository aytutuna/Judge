    "respond.intro" : {
      "comment" : "Generated by mobile/shared/strings/export-strings.ts from lib/i18n.ts. Do not edit.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "طلب أحدهم من Judge أن يحسم خلافًا بينكما. احكِ روايتك؛ لن يراها قبل صدور الحكم."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কেউ একজন আপনার সঙ্গে একটা তর্কের ফয়সালা করতে Judge-কে বলেছেন। আপনার কথা বলুন; রায়ের আগে তিনি এটা দেখতে পাবেন না।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algú ha demanat a Judge que resolgui una discussió que té amb tu. Explica la teva versió; no la veurà fins al veredicte."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Někdo nechává v Judge rozsoudit spor, který s tebou má. Napiš, jak to vidíš ty; uvidí to až s verdiktem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nogen har bedt Judge om at afgøre en diskussion med dig. Fortæl din side; den anden ser den ikke, før dommen falder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jemand hat Judge gebeten, einen Streit mit dir zu klären. Erzähl deine Version; die andere Person sieht sie erst mit dem Urteil."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάποιος ζήτησε από το Judge να λύσει μια διαφωνία που έχει μαζί σου. Πες τη δική σου πλευρά· δεν θα τη δει πριν βγει η απόφαση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Someone asked Judge to settle an argument with you. Tell your side; they won't see it until the verdict."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguien ha pedido a Judge que resuelva una discusión contigo. Cuenta tu versión; esa persona no la verá hasta el veredicto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joku pyysi Judgea ratkaisemaan välisenne kiistan. Kerro oma puolesi. Hän ei näe sitä ennen tuomiota."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelqu’un a demandé à Judge de trancher un débat entre vous deux. Donne ta version ; l’autre ne la verra pas avant le verdict."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "કોઈએ તમારી સાથેના વિવાદનો ફેંસલો Judgeને સોંપ્યો છે. તમારી વાત કહો; ચુકાદા પહેલાં તેઓ એ નહીં જુએ."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מישהו ביקש מ-Judge להכריע בוויכוח איתך. כאן מספרים את הצד שלך, ומי שהזמין אותך לא יראה אותו עד פסק הדין."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी ने Judge से आपके साथ अपनी बहस सुलझाने को कहा है। अपनी बात बताएँ; फ़ैसला आने तक वे इसे नहीं देख पाएँगे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Netko želi da Judge presudi u raspravi s tobom. Ispričaj svoju stranu; ta osoba je neće vidjeti do presude."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valaki megkérte a Judge-ot, hogy döntsön el egy vitát köztetek. Mondd el a te verziódat; az ítéletig ő nem fogja látni."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seseorang minta Judge menuntaskan perdebatan denganmu. Ceritakan versimu; dia tidak bisa melihatnya sampai putusan keluar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualcuno ha chiesto a Judge di risolvere una discussione con te. Racconta la tua versione; non la vedrà fino al verdetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたとの揉めごとについて、Judgeに判定が依頼されました。あなたの言い分を書いてください。判定が出るまで、相手には見えません。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಿಮ್ಮ ಜೊತೆಗಿನ ಒಂದು ವಾದವನ್ನು ಬಗೆಹರಿಸಲು ಯಾರೋ Judge ಅನ್ನು ಕೇಳಿದ್ದಾರೆ. ನಿಮ್ಮ ಕಡೆಯ ಮಾತು ಹೇಳಿ; ತೀರ್ಪು ಬರುವವರೆಗೂ ಅವರಿಗೆ ಅದು ಕಾಣುವುದಿಲ್ಲ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "누군가 Judge에 논쟁 판결을 맡기면서 입장을 들려 달라고 했어요. 판결이 나오기 전까지 상대방은 이 글을 볼 수 없어요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിങ്ങളുമായുള്ള ഒരു തർക്കം തീർക്കാൻ ഒരാൾ Judge-നോട് ആവശ്യപ്പെട്ടു. നിങ്ങളുടെ ഭാഗം പറയൂ; വിധി വരുന്നതുവരെ അവർ അത് കാണില്ല."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोणीतरी तुमच्यासोबतचा वाद सोडवायला Judge ला सांगितले आहे. तुमची बाजू सांगा; निकाल लागेपर्यंत त्यांना ती दिसणार नाही."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seseorang minta Judge selesaikan pertikaiannya dengan anda. Ceritakan versi anda; dia tidak akan nampak sehingga keputusan keluar."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noen har bedt Judge avgjøre en diskusjon med deg. Fortell din side; vedkommende ser den ikke før dommen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iemand heeft Judge gevraagd een discussie met jou te beslechten. Vertel jouw kant; de ander ziet die pas bij de uitspraak."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "କେହି ଜଣେ ଆପଣଙ୍କ ସହ ହୋଇଥିବା ଏକ ବିବାଦ ମେଣ୍ଟାଇବାକୁ Judgeକୁ କହିଛନ୍ତି। ନିଜ କଥା କୁହନ୍ତୁ; ରାୟ ଆସିବା ଯାଏଁ ସେ ଏହା ଦେଖିପାରିବେ ନାହିଁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਕਿਸੇ ਨੇ Judge ਨੂੰ ਤੁਹਾਡੇ ਨਾਲ ਹੋਈ ਬਹਿਸ ਦਾ ਨਿਬੇੜਾ ਕਰਨ ਲਈ ਕਿਹਾ ਹੈ। ਆਪਣਾ ਪੱਖ ਦੱਸੋ; ਫ਼ੈਸਲੇ ਤੱਕ ਉਹ ਇਸ ਨੂੰ ਨਹੀਂ ਦੇਖਣਗੇ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ktoś poprosił Judge o rozstrzygnięcie sporu z tobą. Opisz swoją wersję; ta osoba nie zobaczy jej przed werdyktem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguém pediu para o Judge resolver uma discussão com você. Conte o seu lado; a outra pessoa só vai ver depois do veredito."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguém pediu ao Judge para tirar uma teima contigo. Conta o teu lado; a outra pessoa só o vê depois do veredicto."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cineva vrea ca Judge să lămurească o dispută pe care o are cu tine. Spune-ți varianta; persoana respectivă n-o va vedea până la verdict."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кто-то попросил Judge рассудить спор с вами. Расскажите свою версию — до вердикта этот человек её не увидит."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niekto chce, aby Judge rozsúdil váš spor. Napíš svoju verziu; ten druhý ju uvidí až pri verdikte."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nekdo želi, da Judge razsodi vajin prepir. Povej svojo plat; druga oseba je do razsodbe ne bo videla."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Någon har bett Judge avgöra ett bråk med dig. Berätta din sida; den andra ser den inte förrän domen är klar."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்களுடன் நடந்த ஒரு வாக்குவாதத்தைத் தீர்த்து வைக்க ஒருவர் Judge-இடம் கேட்டிருக்கிறார். உங்கள் தரப்பைச் சொல்லுங்கள்; தீர்ப்பு வரும் வரை அவர் அதைப் பார்க்க மாட்டார்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీతో ఉన్న గొడవను తేల్చమని ఎవరో Judgeని అడిగారు. మీ వైపు కథ చెప్పండి; తీర్పు వచ్చేవరకు వాళ్లకు అది కనిపించదు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มีคนให้ Judge ช่วยตัดสินเรื่องที่เขาเถียงกับคุณ เล่าฝั่งของคุณมาได้เลย เขาจะไม่เห็นจนกว่าจะมีคำตัดสิน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biri, seninle arasındaki bir tartışmayı Judge'a sordu. Kendi tarafını anlat; karar çıkana kadar o göremeyecek."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хтось попросив Judge розсудити вашу суперечку. Розкажи свою версію; до вердикту ця людина її не побачить."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کسی نے آپ کے ساتھ اپنی بحث کا فیصلہ Judge پر چھوڑا ہے۔ اپنی بات بتائیں؛ فیصلے تک وہ اسے نہیں دیکھ سکیں گے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Có người đã nhờ Judge phân xử một cuộc tranh cãi với bạn. Hãy kể phần của bạn; họ sẽ không thấy cho đến khi có phán quyết."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有人请 Judge 给你们俩评评理。说说你这边的情况；裁决出来之前，对方看不到。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有人請 Judge 幫你們之間的爭論評評理。寫下你的說法；判決出來前，對方看不到。"
          }
        }
      }
    },
