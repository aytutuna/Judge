    "app.example.jacket.b" : {
      "comment" : "Generated by mobile/shared/strings/export-strings.ts from lib/i18n.ts. Do not edit.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كانت معلّقة عند الباب، وأنت لا تلبسها أبدًا. كنت سأستأذنك، لكنك كنت نائمًا وأنا متأخرة أصلًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ওটা দরজার পাশে ঝুলছিল, আর তুমি তো ওটা পরোই না। জিজ্ঞেস করতাম, কিন্তু তুমি ঘুমাচ্ছিলে আর আমার এমনিতেই দেরি হয়ে গিয়েছিল।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estava penjada al costat de la porta i no te la poses mai. T'ho hauria preguntat, però dormies i jo ja feia tard."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visela u dveří a ty ji nikdy nenosíš. Zeptala bych se, ale spal jsi a já už jsem nestíhala."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den hang ved døren, og du går aldrig med den. Jeg ville have spurgt, men du sov, og jeg var allerede sent på den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie hing an der Garderobe, und du trägst sie nie. Ich hätte ja gefragt, aber du hast geschlafen, und ich war eh schon spät dran."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ήταν κρεμασμένο δίπλα στην πόρτα κι εσύ δεν το φοράς ποτέ. Θα σε ρωτούσα, αλλά κοιμόσουν κι εγώ είχα ήδη αργήσει."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It was hanging by the door and you never wear it. I would've asked, but you were asleep and I was already late."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estaba colgada junto a la puerta y nunca te la pones. Te habría preguntado, pero estabas dormida y yo ya llegaba tarde."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se roikkui oven vieressä, etkä ikinä käytä sitä. Olisin kysynyt, mutta nukuit, ja olin jo valmiiksi myöhässä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle était accrochée près de la porte et tu ne la mets jamais. Je t’aurais demandé, mais tu dormais et j’étais déjà en retard."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "એ દરવાજા પાસે લટકતું હતું, અને તું તો એ ક્યારેય પહેરતી નથી. હું પૂછી લેત, પણ તું સૂતી હતી અને મને પહેલેથી મોડું થઈ ગયું હતું."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הוא היה תלוי ליד הדלת, ואת אף פעם לא לובשת אותו. הייתי שואל, אבל ישנת, וכבר איחרתי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वह दरवाज़े के पास टँगी थी और तुम उसे कभी पहनते ही नहीं। मैं पूछ लेती, पर तुम सो रहे थे और मुझे पहले ही देर हो चुकी थी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visjela je kraj vrata, a ti je nikad ne nosiš. Pitala bih te, ali spavao si, a ja sam već kasnila."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az ajtó mellett lógott, és sosem hordod. Megkérdeztelek volna, de aludtál, én meg már késésben voltam."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaketnya tergantung dekat pintu dan kamu nggak pernah pakai. Tadinya aku mau minta izin, tapi kamu lagi tidur dan aku sudah telat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Era appeso vicino alla porta e tu non lo metti mai. Te l'avrei chiesto, ma dormivi e io ero già in ritardo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "玄関に掛けっぱなしだったし、全然着てないじゃん。聞こうと思ったけど寝てたし、こっちはもう遅刻しそうだったの。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಅದು ಬಾಗಿಲ ಹತ್ತಿರ ನೇತಾಡುತ್ತಿತ್ತು, ನೀನು ಅದನ್ನು ಹಾಕುವುದೇ ಇಲ್ಲ. ಕೇಳಿಯೇ ತೆಗೆದುಕೊಳ್ಳುತ್ತಿದ್ದೆ, ಆದರೆ ನೀನು ನಿದ್ದೆ ಮಾಡುತ್ತಿದ್ದೆ, ನನಗೆ ಆಗಲೇ ತಡವಾಗಿತ್ತು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현관 옆에 걸려 있었고, 평소에 입지도 않잖아요. 물어보려고 했는데 자고 있었고, 저는 이미 늦었거든요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "അത് വാതിലിനടുത്ത് തൂക്കിയിട്ടിരിക്കുകയായിരുന്നു, നിങ്ങൾ അത് ഇടാറുമില്ല. ചോദിക്കാമെന്ന് വിചാരിച്ചതാണ്, പക്ഷേ നിങ്ങൾ ഉറങ്ങുകയായിരുന്നു, ഞാനാണെങ്കിൽ അപ്പോഴേ വൈകിയിരുന്നു."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ते दाराजवळ लटकत होते, आणि तू ते कधीच घालत नाहीस. मी विचारले असते, पण तू झोपला होतास आणि मला आधीच उशीर झाला होता."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaket tu tergantung tepi pintu dan awak tak pernah pakai pun. Saya memang nak tanya, tapi awak tengah tidur dan saya dah lambat."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den hang ved døra, og du bruker den aldri. Jeg ville spurt, men du sov, og jeg var allerede sent ute."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het hing bij de deur en je draagt het nooit. Ik had het heus gevraagd, maar je sliep en ik was al te laat."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ସେଇଟା କବାଟ ପାଖରେ ଝୁଲୁଥିଲା, ଆଉ ତୁମେ ତ ସେଇଟା କେବେ ପିନ୍ଧୁ ନାହଁ। ପଚାରିଥାନ୍ତି, କିନ୍ତୁ ତୁମେ ଶୋଇଥିଲ ଆଉ ମୋର ଆଗରୁ ଡେରି ହୋଇଯାଇଥିଲା।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਉਹ ਦਰਵਾਜ਼ੇ ਕੋਲ ਟੰਗੀ ਪਈ ਸੀ ਅਤੇ ਤੁਸੀਂ ਉਹ ਕਦੇ ਪਾਉਂਦੇ ਹੀ ਨਹੀਂ। ਮੈਂ ਪੁੱਛ ਲੈਂਦੀ, ਪਰ ਤੁਸੀਂ ਸੁੱਤੇ ਪਏ ਸੀ ਅਤੇ ਮੈਨੂੰ ਪਹਿਲਾਂ ਹੀ ਦੇਰ ਹੋ ਚੁੱਕੀ ਸੀ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wisiała przy drzwiach, a ty jej nigdy nie nosisz. Zapytałabym, ale spałeś, a ja już byłam spóźniona."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estava pendurada perto da porta e você nunca usa. Eu teria pedido, mas você estava dormindo e eu já estava atrasada."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estava pendurado ao pé da porta e tu nunca o usas. Ia perguntar-te, mas estavas a dormir e eu já ia atrasada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Era agățată lângă ușă și tu n-o porți niciodată. Te-aș fi întrebat, dar dormeai, iar eu deja întârziam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Она висела у двери, а ты её вообще не носишь. Я бы спросила, но ты спал, а я уже опаздывала."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visela pri dverách a ty ju nikdy nenosíš. Opýtala by som sa, ale spal si a ja som už meškala."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visela je pri vratih, ti pa je nikoli ne nosiš. Vprašala bi te, ampak si spal, jaz pa sem že tako zamujala."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den hängde vid dörren och du använder den aldrig. Jag hade frågat, men du sov och jag var redan sen."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "அது வாசல் பக்கத்தில் தொங்கிக்கொண்டிருந்தது, நீ அதைப் போடுவதே இல்லை. கேட்டிருப்பேன், ஆனால் நீ தூங்கிக்கொண்டிருந்தாய், எனக்கும் ஏற்கெனவே நேரமாகிவிட்டது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "అది తలుపు పక్కనే వేలాడుతోంది, మీరు దాన్ని ఎప్పుడూ వేసుకోరు. అడిగేదాన్నే, కానీ మీరు నిద్రపోతున్నారు, నాకు అప్పటికే లేటైంది."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มันแขวนอยู่ข้างประตู แล้วก็ไม่เคยเห็นใส่เลย ว่าจะถามก่อนอยู่แล้ว แต่ตอนนั้นยังหลับอยู่ ส่วนเราก็สายแล้วด้วย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapının yanında asılıydı, sen de hiç giymiyorsun. Sorardım ama uyuyordun, ben de zaten geç kalmıştım."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вона висіла біля дверей, а ти її ніколи не носиш. Я б спитала, але ти спав, а я вже запізнювалася."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دروازے کے پاس ٹنگی تھی اور تم اسے کبھی پہنتے ہی نہیں۔ میں پوچھ لیتی، لیکن تم سو رہے تھے اور مجھے پہلے ہی دیر ہو چکی تھی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nó treo ngay cạnh cửa, mà bạn có bao giờ mặc đâu. Mình cũng định hỏi, nhưng bạn đang ngủ còn mình thì đang trễ giờ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它就挂在门口，你又从来不穿。我本来想问的，可你在睡觉，我又已经迟到了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "外套就掛在門邊，你又從來不穿。我本來想問你，但你在睡覺，我又已經遲到了。"
          }
        }
      }
    },
