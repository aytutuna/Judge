    "example.knuckles.text" : {
      "comment" : "Generated by mobile/shared/strings/export-strings.ts from lib/i18n.ts. Do not edit.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أمي تقول إن طقطقة أصابعي ستصيبني بخشونة المفاصل. أنا أطقطقها طوال الوقت، وأقول إنها خرافة لا دليل عليها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "মা বলে আঙুল ফোটালে বাত হবে। আমি সারাক্ষণ আঙুল ফোটাই, আর আমার মতে এটা স্রেফ ভুল ধারণা, এর পেছনে কোনো প্রমাণ নেই।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La meva mare diu que si faig petar els dits tindré artrosi. Jo me'ls faig petar contínuament i dic que és un mite sense cap prova al darrere."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máma říká, že když budu lupat prsty, dostanu artrózu. Já lupu prsty pořád a tvrdím, že je to mýtus, pro který neexistuje žádný důkaz."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Min mor siger, at jeg får slidgigt af at knække med fingrene. Jeg gør det hele tiden, og jeg siger, at det er en myte uden noget belæg."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meine Mutter sagt, wenn ich mit den Fingern knacke, kriege ich Arthrose. Ich mache das ständig und sage, das ist ein Mythos ohne jeden Beleg."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η μαμά μου λέει ότι αν κάνω κρακ τα δάχτυλά μου θα πάθω αρθρίτιδα. Εγώ τα κάνω κρακ συνέχεια και λέω ότι είναι μύθος χωρίς καμία απόδειξη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My mom says cracking my knuckles will give me arthritis. I crack them all the time and I say that's a myth with no evidence behind it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mi abuela dice que si sigo haciendo crujir los nudillos voy a acabar con artritis. Yo lo hago a todas horas y digo que es un mito sin ninguna prueba que lo respalde."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Äiti sanoo, että sormien naksuttelusta tulee nivelrikko. Naksuttelen niitä koko ajan, ja minusta se on myytti, jolle ei ole mitään näyttöä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ma mère dit qu’à force de faire craquer mes doigts, je vais avoir de l’arthrose. Je les fais craquer tout le temps, et pour moi, c’est une légende sans aucune preuve derrière."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "મમ્મી કહે છે કે આંગળીઓના ટચાકા ફોડીશ તો સંધિવા થશે. હું તો આખો દિવસ ટચાકા ફોડું છું, અને મારું કહેવું છે કે આ ખાલી માન્યતા છે, એની પાછળ કોઈ પુરાવો નથી."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אמא שלי אומרת שאם אפצח אצבעות תהיה לי דלקת מפרקים. אני מפצחת אותן כל הזמן ובטוחה שזה מיתוס בלי שום הוכחה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मम्मी कहती हैं कि उँगलियाँ चटकाने से मुझे गठिया हो जाएगा। उँगलियाँ चटकाना तो मेरी रोज़ की आदत है, और मेरा कहना है कि यह बस एक मिथक है जिसके पीछे कोई सबूत नहीं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mama mi stalno govori da ću od krckanja prstima dobiti artritis. Ja krckam prstima cijelo vrijeme i tvrdim da je to mit bez ikakvog dokaza."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anyukám szerint ha ropogtatom az ujjaimat, ízületi gyulladásom lesz. Én folyton ropogtatom, és szerintem ez egy tévhit, amit semmi sem bizonyít."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kata ibuku, kalau aku sering membunyikan jari nanti kena rematik. Aku sering banget melakukannya, dan menurutku itu cuma mitos yang nggak ada buktinya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mia mamma dice che se scrocchio le dita mi verrà l'artrosi. Io le scrocchio di continuo e secondo me è una leggenda senza nessuna prova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "母は、指をポキポキ鳴らしていると関節が太くなると言います。私はしょっちゅう鳴らしていますが、そんなのは根拠のない迷信だと思います。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಬೆರಳಿನ ಲಟಿಕೆ ಮುರಿದರೆ ಸಂಧಿವಾತ ಬರುತ್ತದೆ ಅಂತ ಅಮ್ಮ ಹೇಳುತ್ತಾರೆ. ನಾನು ಯಾವಾಗಲೂ ಲಟಿಕೆ ಮುರಿಯುತ್ತೇನೆ, ಅದು ಯಾವ ಪುರಾವೆಯೂ ಇಲ್ಲದ ಕಟ್ಟುಕಥೆ ಅಂತ ನನ್ನ ವಾದ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "엄마는 제가 손가락을 꺾으면 관절염 생긴다고 해요. 저는 맨날 꺾는데, 그건 아무 근거 없는 속설이라고 생각해요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "വിരൽ ഞൊട്ടിയാൽ വാതം വരുമെന്നാണ് അമ്മ പറയുന്നത്. ഞാൻ എപ്പോഴും വിരൽ ഞൊട്ടാറുണ്ട്; അത് ഒരു തെളിവുമില്ലാത്ത വെറും കെട്ടുകഥയാണെന്നാണ് എന്റെ പക്ഷം."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "माझी आई म्हणते की सारखी बोटे मोडल्याने मला संधिवात होईल. माझे तर दिवसभर बोटे मोडणे चालूच असते, आणि माझ्या मते हा निव्वळ गैरसमज आहे, त्याला कोणताही पुरावा नाही."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mak saya kata kalau saya selalu bunyikan jari, nanti kena artritis. Saya memang selalu buat, dan saya kata itu cuma mitos, tak ada bukti pun."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mamma sier at jeg får leddgikt hvis jeg knekker fingrene. Jeg knekker dem hele tiden og sier at det er en myte uten noe som helst belegg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mijn moeder zegt dat ik artrose krijg als ik met mijn vingers knak. Ik doe het de hele dag en zeg dat het een fabeltje is waar geen enkel bewijs voor is."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ମା' କହନ୍ତି ଆଙ୍ଗୁଠି ଫୁଟାଇଲେ ମୋର ଗଣ୍ଠିବାତ ହେବ। ମୁଁ ସବୁବେଳେ ଫୁଟାଏ, ଆଉ ମୋ ମତରେ ଏହା ଏକ ଭ୍ରମ, ଯାହାର କୌଣସି ପ୍ରମାଣ ନାହିଁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਮੇਰੇ ਮੰਮੀ ਕਹਿੰਦੇ ਹਨ ਕਿ ਉਂਗਲਾਂ ਚਟਕਾਉਣ ਨਾਲ ਮੈਨੂੰ ਗਠੀਆ ਹੋ ਜਾਵੇਗਾ। ਮੈਂ ਤਾਂ ਹਰ ਵੇਲੇ ਚਟਕਾਉਂਦਾ ਹਾਂ ਅਤੇ ਮੇਰਾ ਕਹਿਣਾ ਹੈ ਕਿ ਇਹ ਬਿਨਾਂ ਕਿਸੇ ਸਬੂਤ ਦੀ ਸੁਣੀ-ਸੁਣਾਈ ਗੱਲ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mama mówi, że od strzelania palcami dostanę zapalenia stawów. Ciągle nimi strzelam i uważam, że to mit, za którym nie stoją żadne dowody."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minha mãe diz que, se eu ficar estalando os dedos, vou ter artrite. Eu estalo o tempo todo e digo que isso é mito, sem nenhuma prova por trás."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A minha mãe diz que, se continuar a estalar os dedos, vou ficar com artrite. Eu estalo-os a toda a hora e digo que isso é um mito sem provas nenhumas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mama zice că dacă tot îmi trosnesc degetele o să fac artrită. Eu le trosnesc tot timpul și zic că e un mit fără nicio dovadă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мама говорит, что если хрустеть пальцами, будет артрит. Я постоянно хрущу пальцами и считаю, что это миф, который ничем не подтверждён."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mama hovorí, že z praskania kĺbov na prstoch dostanem artritídu. Ja prstami praskám stále a tvrdím, že je to mýtus, za ktorým nie je žiadny dôkaz."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mama pravi, da pokanje s prsti povzroča artritis. Jaz s prsti pokam ves čas in pravim, da je to mit, za katerim ni nobenih dokazov."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mamma säger att jag får artros om jag knäcker fingrarna. Jag knäcker dem hela tiden och säger att det är en myt utan några belägg."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "விரலில் சொடக்கு எடுத்தால் மூட்டுவாதம் வரும் என்று அம்மா சொல்கிறார். நான் எப்போதும் சொடக்கு எடுக்கிறேன்; அது எந்த ஆதாரமும் இல்லாத கட்டுக்கதை என்கிறேன்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మెటికలు విరిస్తే పెద్దయ్యాక కీళ్ల వాతం వస్తుందని మా అమ్మ అంటుంది. నేను ఎప్పుడూ విరుస్తూనే ఉంటాను, అదంతా ఏ ఆధారమూ లేని అపోహ అని నా మాట."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แม่บอกว่าถ้าหักนิ้วบ่อย ๆ เดี๋ยวข้อจะเสื่อม เราหักนิ้วอยู่ตลอด และคิดว่าเป็นแค่ความเชื่อที่ไม่มีหลักฐานรองรับเลย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annem parmaklarımı çıtlatırsam kireçlenme olacağını söylüyor. Ben sürekli çıtlatıyorum ve bunun hiçbir kanıtı olmayan bir efsane olduğunu düşünüyorum."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мама каже, що якщо я хрустітиму пальцями, у мене буде артрит. Я весь час хрущу пальцями й вважаю, що це міф, за яким немає жодних доказів."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "امی کہتی ہیں کہ انگلیاں چٹخانے سے مجھے گٹھیا ہو جائے گا۔ مجھے ہر وقت انگلیاں چٹخانے کی عادت ہے، اور میرا کہنا ہے کہ یہ ایک وہم ہے جس کے پیچھے کوئی ثبوت نہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mẹ mình bảo bẻ khớp ngón tay hoài sẽ bị viêm khớp. Mình bẻ suốt và cho rằng đó chỉ là lời đồn, chẳng có bằng chứng nào cả."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我妈说老掰手指关节，以后会得关节炎。我天天掰，我说这就是个谣言，根本没有证据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我媽說我一直折手指，以後會得關節炎。我每天都在折，我覺得這只是沒有任何證據的迷思。"
          }
        }
      }
    },
