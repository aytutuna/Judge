    "app.example.thermostat.b" : {
      "comment" : "Generated by mobile/shared/strings/export-strings.ts from lib/i18n.ts. Do not edit.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "على 22 درجة لا يمكن النوم من الحر. يمكنك أن ترتدي طبقة إضافية، أما أنا فلم يبقَ عليّ ما أخلعه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "22 ডিগ্রিতে ঘর গুমোট হয়ে যায়, ঘুমানো যায় না। তুমি আরেকটা কাঁথা নিতে পারো, আমি তো গা থেকে আর কিছু খুলতে পারব না।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A 22 graus fa massa calor per dormir. Tu pots abrigar-te més; jo ja no em puc treure res més."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při 22 stupních je na spaní moc teplo. Ty si můžeš vzít další vrstvu, já už ze sebe nic sundat nemůžu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "22 grader er alt for varmt at sove i. Du kan tage en trøje mere på, jeg kan ikke tage mere af."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei 22 Grad kann man nicht schlafen, viel zu warm. Du kannst dir noch was anziehen, ich kann nichts mehr ausziehen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Με 22 βαθμούς δεν κοιμάται κανείς, είναι πολλή ζέστη. Εσύ μπορείς να φορέσεις κι άλλο ρούχο, εγώ δεν έχω τι άλλο να βγάλω."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "22 is way too warm to sleep in. You can put on another layer, I can't take anything else off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con 22 grados hace demasiado calor para dormir. Tú puedes abrigarte más; yo ya no me puedo quitar nada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "22 astetta on aivan liian lämmin nukkumiseen. Sinä voit pukea lisää päälle, minä en voi riisua enempää."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "22 °C, c’est beaucoup trop chaud pour dormir. Toi, tu peux mettre une couche de plus ; moi, je ne peux rien enlever de plus."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "24માં તો ગરમીથી ઊંઘ જ ન આવે. તું એક ચાદર વધારે ઓઢી લે, મારી પાસે તો હવે ઉતારવા જેવું કંઈ બચ્યું નથી."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ב-22 מעלות אי אפשר לישון, חם מדי. את יכולה ללבוש עוד שכבה, לי כבר אין מה להוריד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "22 पर तो गर्मी से नींद ही नहीं आएगी। तुम एक चादर और ओढ़ सकती हो, मैं तो अब और कुछ उतार भी नहीं सकता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na 22 je prevruće za spavanje. Ti možeš obući još nešto, a ja više nemam što skinuti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "22 fokban nem lehet aludni, az már túl meleg. Te fel tudsz venni még egy réteget, én viszont már nem tudok mit levenni."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "24 derajat terlalu gerah buat tidur. Kamu bisa pakai selimut, tapi aku nggak bisa lepas apa-apa lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con 22 gradi non si riesce a dormire, fa troppo caldo. Tu puoi metterti un'altra maglia, io più di così non posso togliermi niente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "22℃じゃ暑すぎて寝られないよ。そっちはもう1枚着ればいいけど、こっちはこれ以上脱げないんだから。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "24 ಡಿಗ್ರಿಯಲ್ಲಿ ಸೆಕೆಯಿಂದ ನಿದ್ದೆಯೇ ಬರುವುದಿಲ್ಲ. ನೀನು ಇನ್ನೊಂದು ಹೊದಿಕೆ ಹೊದ್ದುಕೊಳ್ಳಬಹುದು, ನನಗೆ ಇನ್ನೇನನ್ನೂ ತೆಗೆಯಲು ಆಗುವುದಿಲ್ಲ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "22도면 너무 더워서 잠을 못 자요. 추우면 하나 더 껴입으면 되지만, 저는 더 벗을 것도 없어요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "22-ൽ വെച്ചാൽ ഉറങ്ങാൻ പറ്റാത്തത്ര ചൂടാണ്. നിങ്ങൾക്ക് ഒരു പുതപ്പ് കൂടി എടുക്കാമല്ലോ; എനിക്ക് ഇനി ഒന്നും ഊരിമാറ്റാനില്ല."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "24 वर झोपायला खूपच गरम होते. तू आणखी एक पांघरूण घेऊ शकतेस, पण मी अंगावरचे आणखी काही काढू शकत नाही."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "24 tu panas sangat untuk tidur. Awak boleh pakai satu lapis lagi, saya dah tak ada apa nak tanggal."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "22 grader er altfor varmt å sove i. Du kan ta på deg et lag til, jeg kan ikke ta av meg noe mer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij 22 graden kun je echt niet slapen, veel te warm. Jij kunt nog een trui aantrekken, ik kan niks meer uittrekken."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "22ରେ ଶୋଇବା ପାଇଁ ବହୁତ ଗରମ। ତୁମେ ଆଉ ଗୋଟେ ଚାଦର ଘୋଡ଼ାଇପାରିବ, ମୁଁ ତ ଆଉ କିଛି କାଢ଼ିପାରିବି ନାହିଁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "22 ’ਤੇ ਤਾਂ ਸੌਣਾ ਔਖਾ ਹੈ, ਬਹੁਤ ਗਰਮੀ ਹੋ ਜਾਂਦੀ ਹੈ। ਤੁਸੀਂ ਇੱਕ ਕੱਪੜਾ ਹੋਰ ਪਾ ਸਕਦੇ ਹੋ, ਮੈਂ ਹੋਰ ਕੁਝ ਨਹੀਂ ਲਾਹ ਸਕਦਾ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przy 22 stopniach nie da się spać, jest za gorąco. Ty możesz coś jeszcze na siebie narzucić, a ja już nic więcej nie zdejmę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com 22 graus não dá para dormir, fica quente demais. Você pode vestir mais alguma coisa, eu não tenho mais o que tirar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com 22 graus não se consegue dormir, é calor a mais. Tu podes vestir mais qualquer coisa, eu já não posso tirar mais nada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La 22 de grade e mult prea cald ca să dormi. Tu poți să mai pui ceva pe tine, eu n-am ce să mai dau jos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При 22 спать невозможно, слишком жарко. Ты можешь надеть ещё что-нибудь, а мне снимать уже нечего."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri 22 stupňoch je na spanie priveľmi teplo. Ty si môžeš obliecť ďalšiu vrstvu, ja už zo seba nemám čo dať dole."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri 22 stopinjah se ne da spati, prevroče je. Ti lahko oblečeš še eno plast, jaz pa ne morem sleči ničesar več."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "22 grader är alldeles för varmt att sova i. Du kan ta på dig ett lager till, jag kan inte ta av mig mer."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "22 டிகிரியில் தூங்கவே முடியாது, ரொம்பப் புழுக்கமாக இருக்கும். நீ இன்னொரு போர்வை போர்த்திக்கொள்ளலாம், நான் இதற்கு மேல் எதையும் கழற்ற முடியாது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "24 మీద నిద్ర పట్టదు, మరీ ఉక్కగా ఉంటుంది. మీరు ఇంకో దుప్పటి కప్పుకోవచ్చు, నేను ఇంకేమీ తీసేయలేను."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "25 องศามันร้อนจนนอนไม่หลับ หนาวก็ห่มผ้าเพิ่มได้ แต่เราไม่มีอะไรให้ถอดแล้วนะ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "22 derecede uyunmaz, çok sıcak. Sen bir kat daha giyebilirsin ama ben daha fazla bir şey çıkaramam."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли 22 градуси, спати надто жарко. Ти можеш вдягнути ще щось, а мені вже нема чого знімати."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "24 پر تو اتنی گرمی ہوتی ہے کہ نیند ہی نہیں آتی۔ تم ایک چادر اور لے سکتی ہو، میں اور کیا اتاروں؟"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "25°C thì lạnh quá, ngủ không nổi. Bạn nóng thì bật thêm quạt, còn mình đắp chăn rồi mà vẫn lạnh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "22 度太热了，根本睡不着。你可以再加件衣服，我可没法再脱了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "26 度太熱了，根本睡不著。你可以多穿一件，我已經沒東西可以脫了。"
          }
        }
      }
    },
