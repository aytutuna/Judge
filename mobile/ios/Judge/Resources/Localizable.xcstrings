    "factcheck.noneFactual" : {
      "comment" : "Generated by mobile/shared/strings/export-strings.ts from lib/i18n.ts. Do not edit.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا شيء هنا يمكن التحقق منه على الويب: الحقائق في هذه المسألة يعرفها المعنيون بها وحدهم."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এখানে ওয়েবে যাচাই করার মতো কিছু নেই: এর তথ্যগুলো শুধু জড়িত মানুষদের মধ্যেকার ব্যাপার।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí no hi ha res que es pugui comprovar a internet: els fets d'aquest cas només els coneixen les persones implicades."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nic z toho se nedalo ověřit na webu: fakta v tomhle sporu znají jen zúčastnění."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intet her kunne tjekkes på nettet: fakta i den her sag kender kun de involverede."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier ließ sich nichts im Netz prüfen: Die Fakten in diesem Fall kennen nur die Beteiligten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τίποτα εδώ δεν ελέγχεται στο ίντερνετ: τα γεγονότα τα ξέρουν μόνο όσοι ήταν εκεί."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing here could be checked on the web: the facts in this one are between the people involved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No había nada que comprobar en internet: los hechos de esta discusión quedan entre las personas implicadas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tästä ei löydy mitään verkosta tarkistettavaa: faktat ovat vain osapuolten tiedossa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien ici ne peut être vérifié sur le web : les faits de ce débat ne sont connus que des personnes concernées."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "અહીં વેબ પર ચકાસી શકાય એવું કંઈ નથી: આમાંની હકીકતો સામેલ લોકો વચ્ચેની જ છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אין כאן שום דבר שאפשר לבדוק ברשת: העובדות כאן ידועות רק למעורבים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यहाँ वेब पर जाँचने लायक कुछ नहीं: इस मामले के तथ्य सिर्फ़ इसमें शामिल लोगों के बीच के हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovdje se ništa ne može provjeriti na internetu: činjenice u ovom slučaju poznaju samo uključene osobe."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Itt nincs mit a neten ellenőrizni: a tényeket ebben az esetben csak az érintettek ismerik."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada yang bisa dicek di web: fakta dalam kasus ini hanya diketahui orang-orang yang terlibat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui non c'era niente da verificare sul web: i fatti di questa storia riguardano solo le persone coinvolte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ネットで確認できることはありませんでした。この件の事実は、当事者のあいだのことだからです。"
          }
