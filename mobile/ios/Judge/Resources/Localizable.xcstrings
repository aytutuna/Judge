    "factcheck.unavailable" : {
      "comment" : "Generated by mobile/shared/strings/export-strings.ts from lib/i18n.ts. Do not edit.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يكتمل التحقق على الويب هذه المرة، فأصدر القضاة حكمهم دونه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এবার ওয়েবে যাচাই শেষ হয়নি, তাই বিচারকেরা সেটা ছাড়াই রায় দিয়েছেন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquesta vegada la comprovació a internet no ha acabat, així que els jutges han decidit sense."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ověření na webu se tentokrát nedokončilo, takže soudci rozhodli bez něj."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tjekket på nettet blev ikke færdigt denne gang, så dommerne dømte uden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Faktencheck im Netz wurde diesmal nicht fertig, also haben die Richter ohne ihn geurteilt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο έλεγχος στο ίντερνετ δεν ολοκληρώθηκε αυτή τη φορά, οπότε οι κριτές αποφάσισαν χωρίς αυτόν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The web check didn't finish this time, so the judges ruled without it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta vez la comprobación en internet no terminó, así que los jueces decidieron sin ella."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verkkotarkistus ei tällä kertaa valmistunut, joten tuomarit ratkaisivat ilman sitä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La vérification sur le web n’a pas abouti cette fois, les juges ont donc tranché sans."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આ વખતે વેબ ચકાસણી પૂરી ન થઈ, એટલે જજોએ એના વગર ચુકાદો આપ્યો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הבדיקה ברשת לא הסתיימה הפעם, אז השופטים הכריעו בלעדיה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस बार वेब पर जाँच पूरी नहीं हुई, इसलिए जजों ने उसके बिना फ़ैसला किया।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provjera na internetu ovaj put nije završila, pa su suci presudili bez nje."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A netes ellenőrzés most nem fejeződött be, így a bírák nélküle döntöttek."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pengecekan web kali ini tidak selesai, jadi hakim memutuskan tanpanya."
