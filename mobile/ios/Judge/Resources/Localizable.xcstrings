            "value" : "Μία εικόνα. Διαβάζουμε το κείμενο, κρύβουμε τα ονόματα και δεν κρατάμε ποτέ την εικόνα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "One image. We read the text, hide the names, and never keep the image."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una imagen. Leemos el texto, ocultamos los nombres y nunca guardamos la imagen."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yksi kuva. Luemme tekstin, piilotamme nimet emmekä koskaan säilytä kuvaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une image. On lit le texte, on masque les noms et on ne garde jamais l’image."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "એક ઇમેજ. અમે લખાણ વાંચીએ છીએ, નામ છુપાવીએ છીએ અને ઇમેજ ક્યારેય રાખતા નથી."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תמונה אחת. אנחנו קוראים את הטקסט, מסתירים את השמות ולא שומרים את התמונה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक तस्वीर। हम उसका टेक्स्ट पढ़ते हैं, नाम छिपाते हैं और तस्वीर कभी नहीं रखते।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedna slika. Čitamo tekst, skrivamo imena i nikad ne čuvamo sliku."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy kép. Kiolvassuk a szöveget, elrejtjük a neveket, a képet pedig sosem tároljuk."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satu gambar. Kami membaca teksnya, menyembunyikan nama, dan tidak pernah menyimpan gambarnya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una sola immagine. Leggiamo il testo, nascondiamo i nomi e non conserviamo mai l'immagine."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画像は1枚まで。文字を読み取って名前を隠し、画像は保存しません。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಒಂದು ಚಿತ್ರ. ನಾವು ಪಠ್ಯವನ್ನು ಓದಿ, ಹೆಸರುಗಳನ್ನು ಮರೆಮಾಡುತ್ತೇವೆ, ಚಿತ್ರವನ್ನು ಎಂದಿಗೂ ಇಟ್ಟುಕೊಳ್ಳುವುದಿಲ್ಲ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1장까지 올릴 수 있어요. 글자를 읽어 이름을 가리고, 이미지는 보관하지 않아요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഒരു ചിത്രം. ഞങ്ങൾ ടെക്സ്റ്റ് വായിച്ച് പേരുകൾ മറയ്ക്കും; ചിത്രം ഒരിക്കലും സൂക്ഷിക്കില്ല."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक फोटो. आम्ही त्यातला मजकूर वाचतो, नावे लपवतो, आणि फोटो कधीच ठेवत नाही."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Satu imej. Kami baca teksnya, sembunyikan nama, dan tidak pernah menyimpan imej itu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ett bilde. Vi leser teksten, skjuler navnene og lagrer aldri bildet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eén afbeelding. We lezen de tekst, verbergen de namen en bewaren de afbeelding nooit."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଗୋଟିଏ ଛବି। ଆମେ ଲେଖା ପଢ଼ୁ, ନାମ ଲୁଚାଉ, ଆଉ ଛବି କେବେ ରଖୁନାହୁଁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਇੱਕ ਤਸਵੀਰ। ਅਸੀਂ ਲਿਖਤ ਪੜ੍ਹਦੇ ਹਾਂ, ਨਾਂ ਲੁਕਾਉਂਦੇ ਹਾਂ, ਅਤੇ ਤਸਵੀਰ ਕਦੇ ਨਹੀਂ ਰੱਖਦੇ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeden obraz. Odczytujemy tekst, ukrywamy imiona i nigdy nie zapisujemy obrazu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma imagem. Lemos o texto, escondemos os nomes e nunca guardamos a imagem."
