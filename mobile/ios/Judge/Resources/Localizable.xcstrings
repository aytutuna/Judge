    "home.invite" : {
      "comment" : "Generated by mobile/shared/strings/export-strings.ts from lib/i18n.ts. Do not edit.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أو ادعُ الطرف الآخر ليحكي روايته"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অথবা অন্যজনকে ডাকুন, তিনিও নিজের কথা বলবেন"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O convida l'altra part a explicar la seva versió"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nebo pozvi druhou stranu, ať napíše svůj pohled"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eller inviter den anden side til at fortælle sin"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oder lad die Gegenseite ein, ihre Version zu erzählen"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ή κάλεσε την άλλη πλευρά να πει τη δική της"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Or invite the other side to tell theirs"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O invita a la otra parte a contar su versión"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tai kutsu toinen osapuoli kertomaan omansa"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou invite l’autre camp à donner sa version"
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "અથવા સામેની બાજુને પોતાની વાત કહેવા બોલાવો"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "או להזמין את הצד השני לספר את שלו"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "या दूसरे पक्ष को भी अपनी बात रखने के लिए बुलाएँ"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ili pozovi drugu stranu da ispriča svoju"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vagy hívd meg a másik felet, hogy elmondja a sajátját"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atau ajak lawan debatmu menulis versinya"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oppure invita l'altra parte a raccontare la sua"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "または、相手を招待して言い分を書いてもらう"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಅಥವಾ ಎದುರಿನವರನ್ನೂ ಅವರ ಮಾತು ಹೇಳಲು ಆಹ್ವಾನಿಸಿ"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아니면 상대방을 초대해서 입장을 들어 보세요"
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "അല്ലെങ്കിൽ, മറ്റേയാളെ അവരുടെ ഭാഗം പറയാൻ ക്ഷണിക്കൂ"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किंवा समोरच्या व्यक्तीलाही त्यांची बाजू सांगायला बोलवा"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atau jemput pihak satu lagi untuk ceritakan versinya"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eller inviter den andre til å fortelle sin side"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Of laat de ander ook aan het woord"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ନହେଲେ ଅନ୍ୟ ପକ୍ଷକୁ ଡାକନ୍ତୁ, ସେ ବି ନିଜ କଥା କହିବେ"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਜਾਂ ਦੂਜੀ ਧਿਰ ਨੂੰ ਆਪਣਾ ਪੱਖ ਦੱਸਣ ਲਈ ਸੱਦੋ"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Albo zaproś drugą stronę, żeby opisała swoją wersję"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou convide o outro lado para contar o dele"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou convida o outro lado a contar o dele"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sau invită cealaltă parte să-și spună varianta"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Или пригласите другую сторону рассказать свою версию"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alebo pozvi druhú stranu, nech napíše svoju verziu"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ali pa povabi drugo plat, da pove svojo"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eller bjud in den andra sidan att berätta sin"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "அல்லது மறுதரப்பையும் அழைத்து, அவர்கள் தரப்பைச் சொல்லச் சொல்லுங்கள்"
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "లేదా అవతలి వైపును వాళ్ల కథ చెప్పమని ఆహ్వానించండి"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หรือชวนอีกฝ่ายมาเล่าฝั่งของเขา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya da karşı tarafı davet et, o da anlatsın"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Або запроси іншу сторону розповісти свою версію"
