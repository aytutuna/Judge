    "thinking.helper" : {
      "comment" : "Generated by mobile/shared/strings/export-strings.ts from lib/i18n.ts. Do not edit.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ثلاثة من قضاة الذكاء الاصطناعي يحكمون كلٌّ على حدة، وإذا تقاربت الأصوات ينضم قضاة آخرون. امنحنا دقيقة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "তিনজন এআই বিচারক আলাদা আলাদা রায় দেন, আর ভোট কাছাকাছি হলে আরও বিচারক ডাকা হয়। এক মিনিট সময় দিন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tres jutges d'IA decideixen per separat i, si la cosa està igualada, se n'hi afegeixen més. Pot trigar un minut."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tři AI soudci rozhodují každý zvlášť a při těsném výsledku přizveme další. Dej tomu chvilku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tre AI-dommere dømmer hver for sig, og er det tæt, kommer der flere til. Giv det et minut."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drei KI-Richter urteilen getrennt, und bei knappen Fällen kommen weitere dazu. Das dauert einen Moment."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τρεις κριτές AI αποφασίζουν χωριστά, κι αν είναι οριακό, έρχονται κι άλλοι. Δώσε μας ένα λεπτό."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Three AI judges rule separately, and a close call brings in more. Give it a minute."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tres jueces de IA deciden por separado y, si está reñido, entran más. Puede tardar un minuto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolme tekoälytuomaria ratkaisee erikseen, ja tiukassa tilanteessa mukaan tulee lisää. Tässä menee hetki."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trois juges IA tranchent séparément, et si c’est serré, d’autres viennent en renfort. Compte une minute."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ત્રણ AI જજ અલગ અલગ ચુકાદો આપે છે, અને મામલો રસાકસીનો હોય તો વધુ જજ બોલાવાય છે. એકાદ મિનિટ લાગશે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שלושה שופטי AI מכריעים בנפרד, וכשזה צמוד מצטרפים עוד. זה לוקח דקה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तीन AI जज अलग-अलग फ़ैसला करते हैं, और मामला करीबी हो तो और जज बुलाए जाते हैं। बस एक मिनट।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tri AI suca presuđuju odvojeno, a kad je tijesno, uključuju se dodatni suci. Daj nam minutu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Három MI-bíró dönt külön-külön, szoros állásnál pedig további bírák is beszállnak. Ez eltarthat egy percig."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiga hakim AI memutuskan terpisah, dan kalau hasilnya tipis, hakim tambahan ikut turun tangan. Tunggu sebentar, ya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tre giudici IA decidono separatamente e, se è in bilico, ne arrivano altri. Ci vuole un minuto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3人のAI審査員が別々に判定し、僅差なら審査員を追加します。1分ほどお待ちください。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಮೂವರು AI ತೀರ್ಪುಗಾರರು ಪ್ರತ್ಯೇಕವಾಗಿ ತೀರ್ಪು ಕೊಡುತ್ತಾರೆ, ಮತಗಳು ತೀರಾ ಹತ್ತಿರವಿದ್ದರೆ ಇನ್ನಷ್ಟು ತೀರ್ಪುಗಾರರು ಸೇರುತ್ತಾರೆ. ಒಂದು ನಿಮಿಷ ಕಾಯಿರಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 판사 3명이 따로 판결하고, 박빙이면 판사가 더 들어와요. 1분 정도 걸릴 수 있어요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "മൂന്ന് എഐ ജഡ്ജിമാർ വെവ്വേറെ വിധി പറയും; ഒപ്പത്തിനൊപ്പമായാൽ കൂടുതൽ പേർ വരും. ഒരു മിനിറ്റ് തരൂ."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तीन AI परीक्षक स्वतंत्रपणे निकाल देतात, आणि अटीतटी झाली तर आणखी परीक्षक येतात. एखादे मिनिट लागेल."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiga hakim AI memutuskan secara berasingan, dan kalau keputusannya rapat, lebih ramai hakim dipanggil. Tunggu lebih kurang seminit."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tre KI-dommere avgjør hver for seg, og er det jevnt, kommer flere til. Gi det et minutt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drie AI-rechters oordelen los van elkaar, en bij een nipte uitslag komen er meer bij. Geef het een minuutje."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ତିନି ଜଣ AI ବିଚାରକ ଅଲଗା ଅଲଗା ରାୟ ଦିଅନ୍ତି, ଭୋଟ୍ ପାଖାପାଖି ହେଲେ ଆହୁରି ବିଚାରକ ଆସନ୍ତି। ଟିକେ ସମୟ ଲାଗିପାରେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤਿੰਨ AI ਜੱਜ ਵੱਖੋ-ਵੱਖ ਫ਼ੈਸਲਾ ਕਰਦੇ ਹਨ, ਅਤੇ ਟੱਕਰ ਫਸਵੀਂ ਹੋਵੇ ਤਾਂ ਹੋਰ ਜੱਜ ਆ ਜਾਂਦੇ ਹਨ। ਇੱਕ ਮਿੰਟ ਲੱਗ ਸਕਦਾ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trzech sędziów AI decyduje osobno, a przy wyrównanym wyniku dochodzą kolejni. Daj im chwilę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Três juízes de IA decidem separadamente, e um caso apertado chama mais juízes. Leva um minutinho."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Três juízes de IA decidem em separado e, se estiver renhido, entram mais. Espera só um minuto."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trei judecători AI decid separat, iar când e la limită mai vin și alții. Durează cam un minut."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Три ИИ-судьи выносят решение по отдельности, а если голоса близки, подключаются ещё. Это займёт около минуты."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traja AI sudcovia rozhodujú oddelene a pri tesnom výsledku prizveme ďalších. Daj tomu minútku."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trije sodniki UI razsojajo ločeno, ob tesnem izidu pa se jim pridruži še kdo. Daj nam minutko."
