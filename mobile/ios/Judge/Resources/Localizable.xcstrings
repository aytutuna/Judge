        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہ درخواست کسی انجان جگہ سے آئی ہے۔ دیکھ لیں کہ ایپ اپ ڈیٹ ہے، پھر دوبارہ کوشش کریں۔"
