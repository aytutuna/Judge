        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stavolta la verifica sul web non si è conclusa, quindi i giudici hanno deciso senza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今回はネットでの確認が終わらなかったため、審査員は確認なしで判定しました。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಈ ಬಾರಿ ವೆಬ್ ಪರಿಶೀಲನೆ ಮುಗಿಯಲಿಲ್ಲ, ಹಾಗಾಗಿ ತೀರ್ಪುಗಾರರು ಅದಿಲ್ಲದೆ ತೀರ್ಪು ಕೊಟ್ಟರು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이번에는 웹 확인이 끝나지 않아서, 판사들이 확인 결과 없이 판결했어요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഇത്തവണ വെബ് പരിശോധന പൂർത്തിയായില്ല, അതുകൊണ്ട് അതില്ലാതെയാണ് ജഡ്ജിമാർ വിധി പറഞ്ഞത്."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "या वेळी वेब तपासणी पूर्ण झाली नाही, म्हणून परीक्षकांनी तिच्याशिवाय निकाल दिला."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semakan web tidak selesai kali ini, jadi hakim memutuskan tanpanya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nettsjekken ble ikke ferdig denne gangen, så dommerne avgjorde uten den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De webcheck is deze keer niet afgerond, dus de rechters oordeelden zonder."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଏଥର ୱେବ୍ ଯାଞ୍ଚ ସରିଲା ନାହିଁ, ତେଣୁ ବିଚାରକମାନେ ତାହା ବିନା ରାୟ ଦେଲେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਇਸ ਵਾਰ ਵੈੱਬ ਜਾਂਚ ਪੂਰੀ ਨਹੀਂ ਹੋਈ, ਇਸ ਲਈ ਜੱਜਾਂ ਨੇ ਉਸ ਤੋਂ ਬਿਨਾਂ ਫ਼ੈਸਲਾ ਕੀਤਾ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tym razem sprawdzanie w sieci się nie zakończyło, więc sędziowie zdecydowali bez niego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A checagem na web não terminou desta vez, então os juízes decidiram sem ela."
