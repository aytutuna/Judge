    "app.appeal.upsell" : {
      "comment" : "Generated by mobile/shared/strings/export-strings.ts from lib/i18n.ts. Do not edit.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل ينقص شيء؟ أضف توضيحًا ليُعاد الحكم مقابل حكم واحد."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কিছু বাদ পড়েছে? নতুন তথ্য যোগ করে 1টি রায়ের বিনিময়ে আবার বিচার করান।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hi falta alguna cosa? Afegeix context i fes que es torni a jutjar per 1 veredicte."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Něco chybí? Doplň kontext a nech to znovu posoudit za 1 verdikt."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mangler der noget? Tilføj kontekst, og få sagen dømt igen for 1 dom."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fehlt etwas? Ergänze Kontext und lass den Fall für 1 Urteil neu beurteilen."
