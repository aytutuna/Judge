        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explica'ns de què va la baralla. Tres jutges d'IA decideixen cadascun pel seu compte, i la puntuació de confiança mostra fins a quin punt coincideixen."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Napiš, o co se hádáte. Tři AI soudci rozhodnou každý zvlášť a skóre jistoty ukáže, nakolik se shodli."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortæl, hvad I skændes om. Tre AI-dommere træffer hver deres afgørelse, og sikkerhedsscoren viser, hvor enige de er."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erzähl uns, worum es im Streit geht. Drei KI-Richter entscheiden jeweils für sich, und der Sicherheitswert zeigt, wie einig sie sich sind."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πες μας για τι τσακώνεστε. Τρεις κριτές AI αποφασίζουν ο καθένας χωριστά, και ο βαθμός βεβαιότητας δείχνει πόσο συμφωνούν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tell us what the fight is about. Three AI judges each make the call on their own, and the confidence score shows how much they agree."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuéntanos de qué trata la discusión. Tres jueces de IA deciden cada uno por su cuenta, y la puntuación de confianza muestra cuánto coinciden."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kerro, mistä kiistassa on kyse. Kolme tekoälytuomaria ratkaisee asian kukin omillaan, ja varmuusluku näyttää, kuinka yksimielisiä he ovat."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dis-nous sur quoi porte la dispute. Trois juges IA tranchent chacun de leur côté, et l’indice de confiance montre à quel point ils sont d’accord."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ઝઘડો શેનો છે એ કહો. ત્રણેય AI જજ પોતાની મેળે ચુકાદો આપે છે, અને વિશ્વાસ સ્કોર બતાવે છે કે તેઓ કેટલા સહમત છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "על מה הוויכוח? שלושה שופטי AI מכריעים, כל אחד בנפרד, וציון הביטחון מראה עד כמה הם מסכימים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बताइए, झगड़ा किस बात पर है। तीन AI जज अपना-अपना फ़ैसला अलग से करते हैं, और भरोसा स्कोर बताता है कि वे आपस में कितना सहमत हैं।"
