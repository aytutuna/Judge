    "app.example.roadTrip.a" : {
      "comment" : "Generated by mobile/shared/strings/export-strings.ts from lib/i18n.ts. Do not edit.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنا مَن قاد السيارة طوال الساعات الست في الذهاب. من العدل أن تقودي أنتِ في العودة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যাওয়ার সময় পুরো ছয় ঘণ্টা আমিই চালিয়েছি। ফেরার পথে তুমি চালাবে, এটাই তো ন্যায্য।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaig conduir jo les sis hores de l'anada. El més just és que tu condueixis a la tornada."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cestou tam jsem řídil celých šest hodin. Je jen fér, abys nás zpátky odvezla ty."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeg kørte alle seks timer derhen. Det er kun fair, at du kører os hjem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich bin auf der Hinfahrt die ganzen sechs Stunden gefahren. Da ist es nur fair, wenn du uns zurückfährst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οδήγησα εγώ και τις έξι ώρες στο πήγαιμο. Δίκαιο είναι να οδηγήσεις εσύ στον γυρισμό."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I drove the whole six hours there. It's only fair that you drive us back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A la ida conduje yo las seis horas. Lo justo es que tú conduzcas a la vuelta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoin koko kuuden tunnin matkan sinne. On vain reilua, että sinä ajat takaisin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "J’ai conduit les six heures de l’aller. Ce serait normal que tu conduises au retour."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "જતી વખતે આખા છ કલાક મેં ગાડી ચલાવી. વળતાં તું ચલાવે એ જ વાજબી છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נהגתי את כל שש השעות בדרך לשם. הכי הוגן שבחזרה אתה תנהג."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जाते वक़्त पूरे छह घंटे गाड़ी मैंने चलाई। वापसी में तुम चलाओ, इतना तो बनता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do tamo sam vozila cijelih šest sati. Pošteno je da ti voziš natrag."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odafelé végig én vezettem, mind a hat órát. Az az igazságos, ha visszafelé te vezetsz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waktu berangkat, aku yang menyetir enam jam penuh. Adil dong kalau pulangnya kamu yang menyetir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All'andata ho guidato io per tutte e sei le ore. È giusto che al ritorno guidi tu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行きの6時間、ずっと私が運転したんだよ。帰りはそっちが運転するのが筋でしょ。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಹೋಗುವಾಗ ಆರು ಗಂಟೆ ಪೂರ್ತಿ ನಾನೇ ಡ್ರೈವ್ ಮಾಡಿದೆ. ವಾಪಸ್ ಬರುವಾಗ ನೀನು ಡ್ರೈವ್ ಮಾಡುವುದೇ ನ್ಯಾಯ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "갈 때 6시간 내내 제가 운전했어요. 돌아오는 길은 바꿔서 운전해 주는 게 공평하죠."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "പോകുമ്പോൾ ആറു മണിക്കൂറും ഞാനാണ് വണ്ടി ഓടിച്ചത്. തിരിച്ച് നിങ്ങൾ ഓടിക്കുന്നതല്ലേ ന്യായം?"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जाताना पूर्ण सहा तास गाडी मीच चालवली. आता परतताना गाडी तू चालव, तेच योग्य आहे."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masa pergi, saya memandu enam jam penuh. Adillah kalau awak pula yang bawa balik."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeg kjørte alle de seks timene dit. Det er bare rettferdig at du kjører oss hjem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ik heb de hele heenweg gereden, zes uur lang. Het is niet meer dan eerlijk dat jij terugrijdt."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଯିବା ବେଳେ ପୂରା ଛଅ ଘଣ୍ଟା ମୁଁ ହିଁ ଗାଡ଼ି ଚଳାଇଲି। ଫେରିବା ବେଳେ ତୁମେ ଚଳାଇବା ତ ଉଚିତ୍।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਜਾਂਦੇ ਹੋਏ ਪੂਰੇ ਛੇ ਘੰਟੇ ਗੱਡੀ ਮੈਂ ਚਲਾਈ। ਹੁਣ ਵਾਪਸੀ ’ਤੇ ਤੁਸੀਂ ਚਲਾਓ, ਇਹੀ ਇਨਸਾਫ਼ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Całe sześć godzin w tamtą stronę prowadziłam ja. Uczciwie będzie, jeśli w drodze powrotnej poprowadzisz ty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eu dirigi as seis horas da ida inteirinhas. Nada mais justo do que você dirigir na volta."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fui eu a conduzir as seis horas da ida. O justo é seres tu a conduzir no regresso."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eu am condus toate cele șase ore la dus. E corect să conduci tu la întoarcere."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Туда я был за рулём все шесть часов. Будет честно, если обратно поведёшь ты."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cestou tam som šoféroval celých šesť hodín. Je len fér, aby si nás späť odviezla ty."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Celih šest ur tja sem vozila jaz. Pošteno je, da nazaj voziš ti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jag körde hela vägen dit, sex timmar. Det är bara rättvist att du kör hem."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "போகும்போது ஆறு மணி நேரமும் நான்தான் ஓட்டினேன். திரும்பி வரும்போது நீ ஓட்டுவதுதான் நியாயம்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "వెళ్లేటప్పుడు ఆరు గంటలూ నేనే డ్రైవ్ చేశాను. తిరుగు ప్రయాణంలో మీరు డ్రైవ్ చేయడమే న్యాయం."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ขาไปเราขับคนเดียวตลอด 6 ชั่วโมง ขากลับก็ต้องเป็นเก่งขับบ้างสิ ถึงจะแฟร์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gidişte altı saat boyunca hep ben sürdüm. Dönüşte senin sürmen adil olur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Туди я сиділа за кермом усі шість годин. Чесно буде, якщо назад нас повезеш ти."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جاتے ہوئے پورے چھ گھنٹے میں نے گاڑی چلائی۔ انصاف یہی ہے کہ واپسی پر تم چلاؤ۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lúc đi mình lái suốt sáu tiếng. Lúc về bạn lái mới công bằng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "去的时候六个小时全是我开的。回来该你开了，这才公平。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "去程六個小時都是我開的。回程換你開才公平。"
          }
        }
      }
    },
