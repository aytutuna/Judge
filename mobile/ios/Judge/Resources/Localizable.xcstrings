    "signin.emailSent" : {
      "comment" : "Generated by mobile/shared/strings/export-strings.ts from lib/i18n.ts. Do not edit.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تفقّد بريدك الوارد. أرسلنا رابط تسجيل الدخول إلى %1$@. يعمل الرابط لمدة 10 دقائق."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ইনবক্স দেখুন। %1$@ ঠিকানায় একটা সাইন-ইন লিংক পাঠিয়েছি। এটা 10 মিনিট কাজ করবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mira la safata d'entrada. Hem enviat un enllaç per entrar a %1$@. Funciona durant 10 minuts."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mrkni do schránky. Poslali jsme přihlašovací odkaz na %1$@. Platí 10 minut."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tjek din indbakke. Vi har sendt et loginlink til %1$@. Det virker i 10 minutter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schau in dein Postfach. Wir haben einen Anmeldelink an %1$@ geschickt. Er gilt 10 Minuten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δες τα εισερχόμενά σου. Στείλαμε σύνδεσμο εισόδου στο %1$@. Ισχύει για 10 λεπτά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check your inbox. We sent a sign-in link to %1$@. It works for 10 minutes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa tu bandeja de entrada. Te hemos enviado un enlace de acceso a %1$@. Funciona durante 10 minutos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Katso sähköpostisi. Lähetimme kirjautumislinkin osoitteeseen %1$@. Se toimii 10 minuuttia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regarde ta boîte de réception. On a envoyé un lien de connexion à %1$@. Il est valable 10 minutes."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમારું ઇનબૉક્સ જુઓ. અમે %1$@ પર સાઇન-ઇન લિંક મોકલી છે. એ 10 મિનિટ ચાલશે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדאי להציץ בתיבת הדואר. שלחנו קישור התחברות אל %1$@. הוא תקף ל-10 דקות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपना इनबॉक्स देखें। हमने %1$@ पर साइन इन लिंक भेजा है। यह 10 मिनट तक काम करेगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provjeri pretinac. Poslali smo poveznicu za prijavu na %1$@. Vrijedi 10 minuta."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nézd meg a postafiókodat. Küldtünk egy belépési linket ide: %1$@. 10 percig érvényes."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cek kotak masukmu. Kami sudah mengirim tautan masuk ke %1$@. Tautannya berlaku 10 menit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla la posta. Abbiamo inviato un link di accesso a %1$@. Vale per 10 minuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "受信トレイを確認してください。%1$@にログインリンクを送りました。有効期限は10分です。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಿಮ್ಮ ಇನ್‌ಬಾಕ್ಸ್ ನೋಡಿ. %1$@ ವಿಳಾಸಕ್ಕೆ ಸೈನ್ ಇನ್ ಲಿಂಕ್ ಕಳುಹಿಸಿದ್ದೇವೆ. ಅದು 10 ನಿಮಿಷ ಕೆಲಸ ಮಾಡುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메일함을 확인해 주세요. %1$@ 주소로 로그인 링크를 보냈어요. 10분 동안 쓸 수 있어요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഇൻബോക്സ് നോക്കൂ. %1$@ എന്ന വിലാസത്തിലേക്ക് ഒരു സൈൻ-ഇൻ ലിങ്ക് അയച്ചിട്ടുണ്ട്. 10 മിനിറ്റ് നേരത്തേക്ക് അത് പ്രവർത്തിക്കും."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुमचा इनबॉक्स पाहा. %1$@ वर साइन-इन लिंक पाठवली आहे. ती 10 मिनिटे चालेल."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Semak peti masuk anda. Kami telah menghantar pautan log masuk ke %1$@. Ia sah selama 10 minit."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sjekk innboksen din. Vi har sendt en innloggingslenke til %1$@. Den virker i 10 minutter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check je inbox. We hebben een inloglink gestuurd naar %1$@. Die werkt 10 minuten."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଇନବକ୍ସ ଦେଖନ୍ତୁ। %1$@ ଠିକଣାକୁ ସାଇନ୍ ଇନ୍ ଲିଙ୍କ୍ ପଠାଇଛୁ। ଏହା 10 ମିନିଟ୍ କାମ କରିବ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਆਪਣਾ ਇਨਬਾਕਸ ਦੇਖੋ। ਅਸੀਂ %1$@ ’ਤੇ ਸਾਈਨ ਇਨ ਲਿੰਕ ਭੇਜਿਆ ਹੈ। ਇਹ 10 ਮਿੰਟ ਚੱਲੇਗਾ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdź skrzynkę. Wysłaliśmy link do logowania na %1$@. Działa przez 10 minut."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confira sua caixa de entrada. Enviamos um link de acesso para %1$@. Ele vale por 10 minutos."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vê a tua caixa de entrada. Enviámos um link de acesso para %1$@. Funciona durante 10 minutos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifică-ți căsuța de e-mail. Am trimis un link de conectare la %1$@. E valabil 10 minute."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверьте почту. Мы отправили ссылку для входа на %1$@. Она действует 10 минут."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozri si schránku. Poslali sme prihlasovací odkaz na %1$@. Platí 10 minút."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preveri nabiralnik. Na %1$@ smo poslali povezavo za prijavo. Deluje 10 minut."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kolla din inkorg. Vi har skickat en inloggningslänk till %1$@. Den fungerar i 10 minuter."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இன்பாக்ஸைப் பாருங்கள். %1$@ முகவரிக்கு உள்நுழைவு லிங்க் அனுப்பியுள்ளோம். அது 10 நிமிடங்கள் வேலை செய்யும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీ ఇన్‌బాక్స్ చూడండి. %1$@కు సైన్ ఇన్ లింక్ పంపాం. అది 10 నిమిషాలు పనిచేస్తుంది."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เช็กกล่องจดหมายได้เลย เราส่งลิงก์เข้าสู่ระบบไปที่ %1$@ แล้ว ใช้ได้ 10 นาที"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gelen kutuna bak. %1$@ adresine bir giriş bağlantısı gönderdik. 10 dakika geçerli."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перевір пошту. Ми надіслали посилання для входу на %1$@. Воно діє 10 хвилин."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اپنا ان باکس دیکھیں۔ ہم نے %1$@ پر سائن ان لنک بھیجا ہے۔ یہ 10 منٹ تک کام کرے گا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiểm tra hộp thư nhé. Chúng tôi đã gửi liên kết đăng nhập tới %1$@. Liên kết có hiệu lực trong 10 phút."
          }
