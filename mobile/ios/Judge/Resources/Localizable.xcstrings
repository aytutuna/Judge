    "account.deleteConfirm" : {
      "comment" : "Generated by mobile/shared/strings/export-strings.ts from lib/i18n.ts. Do not edit.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل تريد حذف حسابك؟ سيُحذف رصيدك وخطتك وبيانات تسجيل الدخول. وستُزال أحكامك ورواياتك في القضايا: يُمحى ما كتبته والأسماء، وتتوقف روابط مشاركتها عن العمل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অ্যাকাউন্ট মুছে ফেলবেন? আপনার ক্রেডিট, প্ল্যান আর সাইন-ইনের তথ্য মুছে যাবে। আপনার রায় আর মামলায় আপনার বক্তব্য সরিয়ে ফেলা হবে: আপনার লেখা আর নামগুলো মুছে যাবে, আর সেগুলোর শেয়ার লিংক কাজ করা বন্ধ করবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vols eliminar el compte? S'esborraran els teus crèdits, el pla i les dades d'inici de sessió. Els teus veredictes i les teves versions dels casos s'eliminaran: s'esborrarà tot el que vas escriure, noms inclosos, i els seus enllaços per compartir deixaran de funcionar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smazat účet? Tvoje kredity, plán a přihlašovací údaje se smažou. Tvoje verdikty a tvoje pohledy v případech se odstraní: tvoje texty i jména se vymažou a sdílené odkazy přestanou fungovat."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vil du slette din konto? Dine kreditter, din plan og dine loginoplysninger bliver slettet. Dine domme og dine sider i sager bliver fjernet: det, du skrev, og navnene bliver slettet, og deres delingslinks holder op med at virke."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konto löschen? Deine Credits, dein Tarif und deine Anmeldedaten werden gelöscht. Deine Urteile und deine Beiträge zu Fällen werden entfernt: Was du geschrieben hast und die Namen werden gelöscht, und die geteilten Links funktionieren nicht mehr."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Να διαγραφεί ο λογαριασμός σου; Το υπόλοιπο αποφάσεων, το πρόγραμμα και τα στοιχεία σύνδεσης διαγράφονται. Οι αποφάσεις σου και οι πλευρές σου στις υποθέσεις αφαιρούνται: ό,τι έγραψες και τα ονόματα σβήνονται και οι σύνδεσμοι κοινοποίησης σταματούν να λειτουργούν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete your account? Your credits, plan and sign-in details are deleted. Your verdicts and your sides of cases are removed: what you wrote and the names are erased, and their share links stop working."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Eliminar tu cuenta? Se borran tus créditos, tu plan y tus datos de inicio de sesión. Se eliminan tus veredictos y tus versiones de los casos: se borran lo que escribiste y los nombres, y sus enlaces para compartir dejan de funcionar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poistetaanko tilisi? Tuomiosaldosi, tilauksesi ja kirjautumistietosi poistetaan. Tuomiosi ja osuutesi jutuista poistetaan: kirjoittamasi teksti ja nimet pyyhitään, ja niiden jakolinkit lakkaavat toimimasta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimer ton compte ? Tes crédits, ton offre et tes informations de connexion seront effacés. Tes verdicts et tes versions dans les dossiers seront supprimés : ce que tu as écrit et les noms seront effacés, et leurs liens de partage cesseront de fonctionner."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "એકાઉન્ટ ડિલીટ કરવું છે? તમારી ક્રેડિટ, પ્લાન અને સાઇન ઇનની વિગતો ડિલીટ થશે. તમારા ચુકાદા અને કેસમાંની તમારી બાજુ દૂર થશે: તમે જે લખ્યું એ અને નામ ભૂંસાઈ જશે, અને એમની શેર લિંક કામ કરતી બંધ થઈ જશે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "למחוק את החשבון? הקרדיטים, התוכנית ופרטי ההתחברות יימחקו. פסקי הדין שלך והצדדים שלך בתיקים יוסרו: מה שכתבת והשמות יימחקו, וקישורי השיתוף שלהם יפסיקו לעבוד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपना अकाउंट डिलीट करें? आपके क्रेडिट, प्लान और साइन इन की जानकारी मिट जाएगी। आपके फ़ैसले और केस में आपकी बातें हटा दी जाएँगी: आपका लिखा हुआ और नाम मिट जाएँगे, और उनके शेयर लिंक काम करना बंद कर देंगे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Želiš izbrisati račun? Brišu se tvoji krediti, plan i podaci za prijavu. Tvoje presude i tvoje strane u slučajevima uklanjaju se: tvoji tekstovi i imena brišu se, a njihove poveznice za dijeljenje prestaju raditi."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Törlöd a fiókodat? A kreditjeid, az előfizetésed és a belépési adataid törlődnek. Az ítéleteidet és az ügyekben beküldött verzióidat eltávolítjuk: amit írtál, azt a nevekkel együtt töröljük, a megosztási linkjeik pedig megszűnnek működni."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hapus akunmu? Kredit, langganan, dan data masukmu akan dihapus. Putusan dan versimu dalam kasus juga ikut hilang: tulisanmu beserta nama-namanya dihapus, dan tautan berbaginya tidak berfungsi lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuoi eliminare il tuo account? Crediti, piano e dati di accesso vengono cancellati. I tuoi verdetti e le tue versioni nei casi vengono rimossi: quello che hai scritto e i nomi vengono cancellati, e i link di condivisione smettono di funzionare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウントを削除しますか？　クレジット、プラン、ログイン情報は削除されます。あなたの判定と、ケースでのあなたの言い分も削除され、書いた内容と名前は消去されて、シェア用リンクも使えなくなります。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಿಮ್ಮ ಖಾತೆ ಅಳಿಸಬೇಕೇ? ನಿಮ್ಮ ಕ್ರೆಡಿಟ್‌ಗಳು, ಪ್ಲಾನ್ ಮತ್ತು ಸೈನ್ ಇನ್ ವಿವರಗಳು ಅಳಿಸಿಹೋಗುತ್ತವೆ. ನಿಮ್ಮ ತೀರ್ಪುಗಳು ಮತ್ತು ಕೇಸ್‌ಗಳಲ್ಲಿನ ನಿಮ್ಮ ಕಡೆಯ ಮಾತುಗಳನ್ನು ತೆಗೆದುಹಾಕಲಾಗುತ್ತದೆ: ನೀವು ಬರೆದದ್ದು ಮತ್ತು ಹೆಸರುಗಳು ಅಳಿಸಿಹೋಗುತ್ತವೆ, ಅವುಗಳ ಹಂಚಿಕೆ ಲಿಂಕ್‌ಗಳು ಕೆಲಸ ಮಾಡುವುದನ್ನು ನಿಲ್ಲಿಸುತ್ತವೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정을 삭제할까요? 크레딧, 요금제, 로그인 정보가 삭제돼요. 내 판결과 사건 속 내 입장도 지워져요. 쓴 글과 이름이 삭제되고, 공유 링크도 더 이상 열리지 않아요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "അക്കൗണ്ട് ഡിലീറ്റ് ചെയ്യണോ? നിങ്ങളുടെ ക്രെഡിറ്റുകളും പ്ലാനും സൈൻ-ഇൻ വിവരങ്ങളും ഡിലീറ്റ് ആകും. നിങ്ങളുടെ വിധികളും കേസുകളിലെ നിങ്ങളുടെ ഭാഗങ്ങളും നീക്കം ചെയ്യും: നിങ്ങൾ എഴുതിയതും പേരുകളും മായ്ക്കും, അവയുടെ ഷെയർ ലിങ്കുകൾ പ്രവർത്തിക്കാതാകും."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुमचे खाते डिलीट करायचे? तुमचे क्रेडिट, प्लॅन आणि साइन-इनची माहिती डिलीट होईल. तुमचे निकाल आणि प्रकरणांतल्या तुमच्या बाजू काढून टाकल्या जातील: तुम्ही लिहिलेले आणि नावे पुसली जातील, आणि त्यांच्या शेअर लिंक चालणे बंद होईल."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Padam akaun anda? Kredit, pelan dan butiran log masuk anda akan dipadam. Keputusan anda dan versi anda dalam kes akan dibuang: apa yang anda tulis dan nama-nama akan dihapuskan, dan pautan kongsinya tidak lagi berfungsi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vil du slette kontoen din? Kredittene, abonnementet og innloggingsdetaljene dine slettes. Dommene dine og sidene dine i saker fjernes: det du skrev og navnene slettes, og delingslenkene slutter å virke."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je account verwijderen? Je credits, abonnement en inloggegevens worden gewist. Je uitspraken en jouw kant in zaken worden verwijderd: wat je schreef en de namen worden gewist, en de deellinks werken niet meer."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆକାଉଣ୍ଟ ଡିଲିଟ୍ କରିବେ? ଆପଣଙ୍କ କ୍ରେଡିଟ୍, ପ୍ଲାନ୍ ଓ ସାଇନ୍ ଇନ୍ ବିବରଣୀ ଡିଲିଟ୍ ହେବ। ଆପଣଙ୍କ ରାୟ ଓ ମାମଲାରେ ଆପଣଙ୍କ କଥା ହଟିଯିବ: ଆପଣ ଯାହା ଲେଖିଥିଲେ ଓ ନାମଗୁଡ଼ିକ ଲିଭିଯିବ, ଆଉ ସେଗୁଡ଼ିକର ସେୟାର୍ ଲିଙ୍କ୍ କାମ କରିବ ନାହିଁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਆਪਣਾ ਖਾਤਾ ਮਿਟਾਉਣਾ ਹੈ? ਤੁਹਾਡੇ ਕ੍ਰੈਡਿਟ, ਪਲਾਨ ਅਤੇ ਸਾਈਨ ਇਨ ਦੇ ਵੇਰਵੇ ਮਿਟ ਜਾਣਗੇ। ਤੁਹਾਡੇ ਫ਼ੈਸਲੇ ਅਤੇ ਕੇਸਾਂ ਵਿੱਚ ਤੁਹਾਡੇ ਪੱਖ ਹਟ ਜਾਣਗੇ: ਜੋ ਤੁਸੀਂ ਲਿਖਿਆ ਅਤੇ ਨਾਂ ਮਿਟ ਜਾਣਗੇ, ਅਤੇ ਉਨ੍ਹਾਂ ਦੇ ਸਾਂਝੇ ਲਿੰਕ ਕੰਮ ਕਰਨਾ ਬੰਦ ਕਰ ਦੇਣਗੇ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usunąć konto? Usuniemy twoją pulę werdyktów, plan i dane logowania. Twoje werdykty i twoje wersje w sprawach też znikną: wymażemy twoje teksty i imiona, a linki do udostępniania przestaną działać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excluir sua conta? Seus créditos, seu plano e seus dados de login são apagados. Seus vereditos e o seu lado em cada caso são removidos: o que você escreveu e os nomes são apagados, e os links de compartilhamento param de funcionar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apagar a tua conta? Os teus créditos, o plano e os dados de acesso são apagados. Os teus veredictos e os teus lados dos casos são removidos: o que escreveste e os nomes são apagados, e os links de partilha deixam de funcionar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Îți ștergi contul? Creditele, planul și datele de conectare vor fi șterse. Verdictele tale și părțile tale din cazuri vor fi eliminate: ce ai scris și numele se șterg, iar linkurile lor de distribuire nu vor mai funcționa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удалить аккаунт? Баланс вердиктов, тариф и данные для входа будут удалены. Ваши вердикты и ваши версии в делах тоже удалятся: написанное вами и имена сотрутся, а ссылки на них перестанут работать."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zrušiť účet? Tvoje kredity, plán a prihlasovacie údaje sa vymažú. Tvoje verdikty a tvoje verzie v prípadoch sa odstránia: tvoje texty a mená sa vymažú a ich odkazy na zdieľanie prestanú fungovať."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Želiš izbrisati račun? Krediti, naročnina in podatki za prijavo se izbrišejo. Tvoje razsodbe in tvoje plati v sporih se odstranijo: napisano besedilo in imena se izbrišejo, njihove povezave za deljenje pa prenehajo delovati."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Radera ditt konto? Dina krediter, ditt abonnemang och dina inloggningsuppgifter raderas. Dina domar och dina sidor i tvåsidiga fall tas bort: det du skrev och namnen raderas, och deras delningslänkar slutar fungera."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் கணக்கை நீக்கவா? உங்கள் கிரெடிட்கள், பிளான், உள்நுழைவு விவரங்கள் நீக்கப்படும். உங்கள் தீர்ப்புகளும் வழக்குகளில் உங்கள் தரப்புகளும் அகற்றப்படும்: நீங்கள் எழுதியவையும் பெயர்களும் அழிக்கப்படும், அவற்றின் பகிர்வு லிங்க்குகள் வேலை செய்யாது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీ అకౌంట్‌ను డిలీట్ చేయాలా? మీ క్రెడిట్లు, ప్లాన్, సైన్ ఇన్ వివరాలు డిలీట్ అవుతాయి. మీ తీర్పులు, కేసుల్లో మీ వైపు కథలు తీసేస్తాం: మీరు రాసినది, పేర్లు చెరిగిపోతాయి, వాటి షేర్ లింక్‌లు పనిచేయవు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลบบัญชีของคุณไหม? เครดิต แพ็กเกจ และข้อมูลการเข้าสู่ระบบจะถูกลบทั้งหมด คำตัดสินและฝั่งของคุณในเคสต่าง ๆ ก็จะถูกลบด้วย สิ่งที่คุณเขียนและชื่อจะหายไป และลิงก์แชร์ของรายการเหล่านั้นจะใช้ไม่ได้อีก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesabın silinsin mi? Kredilerin, planın ve giriş bilgilerin silinir. Kararların ve davalardaki tarafların kaldırılır: yazdıkların ve isimler silinir, paylaşım bağlantıları da çalışmaz olur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видалити акаунт? Твій баланс вердиктів, тариф і дані для входу буде видалено. Твої вердикти й твої версії у справах буде прибрано: написане тобою та імена зітруться, а посилання для поширення перестануть працювати."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اپنا اکاؤنٹ حذف کریں؟ آپ کے کریڈٹس، پلان اور سائن ان کی تفصیلات حذف ہو جائیں گی۔ آپ کے فیصلے اور کیسوں میں آپ کی باتیں ہٹا دی جائیں گی: آپ کا لکھا ہوا اور نام مٹا دیے جائیں گے، اور ان کے شیئر لنکس کام کرنا بند کر دیں گے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xóa tài khoản của bạn? Lượt, gói và thông tin đăng nhập sẽ bị xóa. Các phán quyết và phần của bạn trong các vụ sẽ bị gỡ: nội dung bạn viết và các tên bị xóa, liên kết chia sẻ cũng ngừng hoạt động."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "确定删除账号吗？你的次数、套餐和登录信息都会被删除。你的裁决和你在案子中的说法也会被删除：你写的内容和名字都会被抹去，分享链接也会失效。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要刪除帳號嗎？你的額度、方案和登入資料都會刪除。你的判決和你在案子中的說法也會移除：你寫的內容和名字都會清除，分享連結也會失效。"
          }
        }
      }
