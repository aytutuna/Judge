    "refusedNote" : {
      "comment" : "Generated by mobile/shared/strings/export-strings.ts from lib/i18n.ts. Do not edit.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "امتنع الذكاء الاصطناعي عن الحكم هذه المرة. نفضّل ألّا نعرض شيئًا على أن نختلق حكمًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এআই এবার সরে দাঁড়িয়েছে। মনগড়া রায় দেখানোর চেয়ে কিছু না দেখানোই ভালো।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La IA s'ha abstingut aquesta vegada. Preferim no mostrar res que inventar-nos un veredicte."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI se k tomu tentokrát nevyjádřila. Radši neukážeme nic, než abychom si verdikt vymýšleli."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI'en stod over på den her. Vi viser hellere ingenting end en opdigtet dom."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die KI hat bei diesem Fall gepasst. Lieber zeigen wir gar nichts als ein erfundenes Urteil."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το AI δεν πήρε θέση σε αυτό. Προτιμάμε να μη δείξουμε τίποτα παρά μια ψεύτικη απόφαση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The AI sat this one out. We'd rather show nothing than fake a ruling."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La IA se abstuvo esta vez. Preferimos no mostrar nada antes que inventarnos una decisión."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekoäly jätti tämän väliin. Mieluummin ei mitään kuin keksitty tuomio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’IA a préféré passer son tour. Mieux vaut ne rien afficher qu’un faux verdict."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI આ વખતે આમાં ન પડ્યું. બનાવટી ચુકાદો બતાવવા કરતાં કંઈ ન બતાવવું સારું."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ה-AI העדיף לא להכריע הפעם. עדיף לא להראות כלום מאשר לזייף פסק דין."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस बार AI ने फ़ैसला करने से मना कर दिया। नकली फ़ैसला दिखाने से अच्छा है कि कुछ न दिखाएँ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI je ovaj put odustao. Radije nećemo pokazati ništa nego izmisliti presudu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az MI ezt most kihagyta. Inkább semmit sem mutatunk, mint egy kamu ítéletet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI-nya memilih absen kali ini. Kami lebih baik tidak menampilkan apa-apa daripada mengarang putusan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'IA ha preferito non esprimersi. Meglio non mostrare niente che inventarsi un verdetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今回はAIが判定を見送りました。それらしい判定をでっち上げるより、何も出さないほうがいいと考えています。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಈ ಬಾರಿ AI ದೂರ ಉಳಿಯಿತು. ನಕಲಿ ತೀರ್ಪು ತೋರಿಸುವುದಕ್ಕಿಂತ ಏನೂ ತೋರಿಸದಿರುವುದೇ ಮೇಲು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이번 건은 AI가 판단을 사양했어요. 가짜 판결을 지어내느니 아무것도 안 보여 드리는 게 나아요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഇത്തവണ എഐ മാറിനിന്നു. വ്യാജ വിധി കാണിക്കുന്നതിലും ഭേദം ഒന്നും കാണിക്കാതിരിക്കുന്നതാണ്."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "या वेळी AI ने माघार घेतली. खोटा निकाल दाखवण्यापेक्षा काहीच न दाखवलेले बरे."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI tidak mahu masuk campur kali ini. Kami lebih rela tidak tunjuk apa-apa daripada mereka-reka keputusan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "KI-en sto over denne. Vi viser heller ingenting enn en oppdiktet dom."
          }
