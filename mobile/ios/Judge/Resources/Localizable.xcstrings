        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenhle případ jsme nenašli. Možná byl smazán, nebo patří k jinému účtu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi kunne ikke finde sagen. Den er måske slettet, eller den hører til en anden konto."
