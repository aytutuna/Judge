      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🌭 Is a hot dog a sandwich?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🌭 Sosisli bir sandviç mi?"
          }
