        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಇಲ್ಲಿ ಯಾವುದನ್ನೂ ವೆಬ್‌ನಲ್ಲಿ ಪರಿಶೀಲಿಸಲು ಆಗಲಿಲ್ಲ: ಇದರ ಸಂಗತಿಗಳು ಸಂಬಂಧಪಟ್ಟವರಿಗೆ ಮಾತ್ರ ಗೊತ್ತಿರುವಂಥವು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "웹으로 확인할 수 있는 내용이 없어요. 이번 건의 사실관계는 당사자들만 알 수 있어요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഇതിൽ വെബിൽ പരിശോധിക്കാവുന്നതായി ഒന്നുമില്ല: ഇതിലെ വസ്തുതകൾ ബന്ധപ്പെട്ട ആളുകൾക്കിടയിൽ മാത്രമുള്ളതാണ്."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यातले काहीच वेबवर तपासता आले नाही: इथली तथ्ये फक्त संबंधित लोकांनाच माहीत आहेत."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiada apa di sini yang boleh disemak di web: fakta dalam kes ini hanya diketahui oleh orang yang terlibat."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingenting her kunne sjekkes på nettet: fakta i denne saken er det bare de involverte som kjenner til."
