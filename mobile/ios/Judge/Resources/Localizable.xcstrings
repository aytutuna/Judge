        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆପଣ କୁହନ୍ତୁ, ବିଚାରକମାନେ ତୁରନ୍ତ ରାୟ ଦେବେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤੁਸੀਂ ਦੱਸਦੇ ਹੋ, ਅਤੇ ਜੱਜ ਉਸੇ ਵੇਲੇ ਫ਼ੈਸਲਾ ਕਰ ਦਿੰਦੇ ਹਨ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ty opowiadasz, a sędziowie od razu decydują."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você conta, e os juízes decidem na hora."
          }
        },
