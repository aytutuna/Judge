          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一次付费，随时使用。每次裁决消耗 1 次。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一次付清，隨時使用。每次判決會用掉 1 點額度。"
