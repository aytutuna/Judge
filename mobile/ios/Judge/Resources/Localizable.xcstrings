        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤੁਹਾਡੇ ਫ਼ੈਸਲੇ ਮੁੱਕ ਗਏ ਹਨ। ਕੀਮਤਾਂ ਵਾਲੇ ਪੇਜ ’ਤੇ ਕੋਈ ਪੈਕ ਚੁਣੋ ਜਾਂ ਮਹੀਨਾਵਾਰ ਪਲਾਨ ਲਓ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
