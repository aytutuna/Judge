    "pricing.lead" : {
      "comment" : "Generated by mobile/shared/strings/export-strings.ts from lib/i18n.ts. Do not edit.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنشئ حسابًا واحصل على أول حكم مجانًا، بكل المزايا. بعد ذلك، اختر باقة أو اشترك شهريًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অ্যাকাউন্ট খুলুন, প্রথম রায় সব ফিচারসহ ফ্রি। এরপর একটা প্যাক বেছে নিন বা মাসিক প্ল্যান নিন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea un compte i el primer veredicte és gratis, amb totes les funcions. Després, tria un paquet o passa't al pla mensual."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Založ si účet a první verdikt máš zdarma, se vším všudy. Potom si vyber balíček nebo měsíční plán."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opret en konto, så er din første dom gratis, med alle funktioner. Derefter vælger du en pakke eller et månedsabonnement."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erstell ein Konto, und dein erstes Urteil ist gratis, mit allen Funktionen. Danach wählst du ein Paket oder das Monatsabo."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Φτιάξε λογαριασμό και η πρώτη σου απόφαση είναι δωρεάν, με όλες τις λειτουργίες. Μετά διαλέγεις πακέτο ή μηνιαίο πρόγραμμα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create an account and your first verdict is free, with every feature. After that, pick a pack or go monthly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea una cuenta y tu primer veredicto es gratis, con todas las funciones. Después, elige un paquete o pásate al plan mensual."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
