    "app.home.sendLink" : {
      "comment" : "Generated by mobile/shared/strings/export-strings.ts from lib/i18n.ts. Do not edit.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أو أرسل إليه رابطًا ليكتبها بنفسه"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অথবা লিংক পাঠান, তিনি নিজেই লিখবেন"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O envia-li un enllaç perquè l'escrigui"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nebo pošli odkaz, ať to druhá strana napíše sama"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eller send den anden et link til at skrive sin side"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oder lad die Gegenseite per Link ein"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ή στείλε σύνδεσμο για να τη γράψει η άλλη πλευρά"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Or send them a link to write it"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O envíale un enlace para que la escriba"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tai lähetä hänelle linkki, niin hän kirjoittaa sen itse"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ou invite l’autre à l’écrire via un lien"
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "અથવા એમને લિંક મોકલો, જેથી એ જાતે લખે"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "או לשלוח קישור, והצד השני יכתוב בעצמו"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "या उन्हें लिंक भेजें, ताकि वे ख़ुद लिखें"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ili pošalji drugoj osobi poveznicu da napiše svoju"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vagy küldj neki linket, és írja meg ő"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atau kirim tautan agar dia menulisnya sendiri"
          }
