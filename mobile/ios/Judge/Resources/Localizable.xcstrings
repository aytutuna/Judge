    "example.pineapple.text" : {
      "comment" : "Generated by mobile/shared/strings/export-strings.ts from lib/i18n.ts. Do not edit.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عمر يقول إن وضع الأناناس على البيتزا جريمة في حق المطبخ الإيطالي. وأنا أقول إن البيتزا هي كل ما طعمه لذيذ، والتقاليد وحدها ليست حجة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নাদিয়া বলে বিরিয়ানিতে আলু দেওয়া মোগলাই রান্নার অপমান। আমি বলি বিরিয়ানি সেটাই, যেটা খেতে ভালো লাগে, আর শুধু ঐতিহ্যের দোহাই কোনো যুক্তি না।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En Biel diu que posar pinya a la pizza és un crim contra la cuina italiana. Jo dic que a la pizza s'hi pot posar tot el que sigui bo, i que la tradició, tota sola, no és cap argument."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ondra tvrdí, že ananas na pizze je zločin proti italské kuchyni. Já říkám, že pizza je cokoli, co chutná, a samotná tradice není argument."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emil siger, at ananas på pizza er en forbrydelse mod det italienske køkken. Jeg siger, at pizza er det, der smager godt, og at tradition alene ikke er et argument."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tim sagt, Ananas auf Pizza ist ein Verbrechen an der italienischen Küche. Ich sage, auf eine Pizza gehört, was schmeckt, und Tradition allein ist kein Argument."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο Γιώργος λέει ότι ο ανανάς στην πίτσα είναι έγκλημα κατά της ιταλικής κουζίνας. Εγώ λέω ότι πίτσα είναι ό,τι είναι νόστιμο, και η παράδοση από μόνη της δεν είναι επιχείρημα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riley says pineapple on pizza is a crime against Italian cooking. I say pizza is whatever tastes good, and tradition alone is not an argument."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Martina dice que ponerle piña a la pizza es un crimen contra la cocina italiana. Yo digo que la pizza es lo que esté rico, y la tradición por sí sola no es un argumento."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emma sanoo, että ananas pizzassa on rikos italialaista keittiötä vastaan. Minusta pizza on sitä, mikä maistuu hyvältä, eikä perinne yksinään ole mikään perustelu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inès dit que l’ananas sur la pizza est un crime contre la cuisine italienne. Moi, je dis qu’une bonne pizza, c’est celle qui a bon goût, et que la tradition à elle seule n’est pas un argument."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ધ્રુવ કહે છે કે ગોળ વગરની દાળ એ ગુજરાતી દાળ જ નથી, વર્ષોથી એમ જ બને છે. હું કહું છું કે જે સ્વાદમાં સારું લાગે એ જ સાચી દાળ, અને ફક્ત પરંપરા કોઈ દલીલ નથી."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מאיה אומרת שאננס על פיצה זה פשע נגד המטבח האיטלקי. לדעתי פיצה זה מה שטעים, ומסורת לבדה היא לא טיעון."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कबीर कहता है कि बिरयानी में आलू डालना बिरयानी की तौहीन है। मेरा कहना है कि जो स्वादिष्ट लगे, वही सही है, और सिर्फ़ परंपरा कोई दलील नहीं होती।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ivana kaže da je ananas na pizzi zločin protiv talijanske kuhinje. Ja kažem da je pizza ono što je fino, a tradicija sama po sebi nije argument."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gergő szerint az ananász a pizzán merénylet az olasz konyha ellen. Szerintem az a jó pizza, ami finom, és a hagyomány önmagában nem érv."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bayu bilang bubur ayam nggak boleh diaduk, karena merusak racikan abangnya dan dari dulu memang dimakan begitu. Menurutku bubur enaknya ya sesuai selera masing-masing, dan “dari dulu begitu” saja bukan argumen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luca dice che l'ananas sulla pizza è un crimine contro la cucina italiana. Io dico che sulla pizza va bene tutto ciò che è buono, e la tradizione da sola non è un argomento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大輝は、酢豚にパイナップルを入れるなんて邪道だと言います。私は、おいしければそれが正解で、「邪道だから」だけでは理由にならないと思います。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಪಿಜ್ಜಾ ಮೇಲೆ ಅನಾನಸ್ ಹಾಕುವುದು ಇಟಾಲಿಯನ್ ಅಡುಗೆಗೆ ಮಾಡುವ ಅಪಚಾರ ಅಂತ ಚೇತನ್ ಹೇಳುತ್ತಾನೆ. ನನ್ನ ಪ್ರಕಾರ ಯಾವುದು ರುಚಿಯಾಗಿದೆಯೋ ಅದೇ ಪಿಜ್ಜಾ, ಬರೀ ಸಂಪ್ರದಾಯ ಒಂದು ವಾದವೇ ಅಲ್ಲ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하준이는 탕수육은 무조건 소스를 부어 먹어야 하고, 찍어 먹는 건 원래 방식을 무시하는 거래요. 저는 맛있게 먹는 게 정답이고, ‘원래 그렇다’는 것만으로는 이유가 안 된다고 생각해요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ചോക്ലേറ്റ് ദോശ നമ്മുടെ നാടൻ പാചകത്തോടുള്ള ക്രൂരതയാണെന്ന് റിയ പറയുന്നു. നല്ല രുചിയുണ്ടെങ്കിൽ ദോശ എന്തുമാകാം, പാരമ്പര്യം മാത്രം ഒരു വാദമല്ല എന്നാണ് ഞാൻ പറയുന്നത്."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नेहा म्हणते की पिझ्झावर अननस घालणे म्हणजे इटालियन पाककलेचा अपमान आहे. माझ्या मते जो चविष्ट लागतो तोच पिझ्झा, आणि नुसती परंपरा हा काही युक्तिवाद नाही."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danial kata letak nanas atas pizza tu satu jenayah terhadap masakan Itali. Saya kata pizza tu apa saja yang sedap, dan tradisi semata-mata bukan hujah."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jonas sier at ananas på pizza er en forbrytelse mot det italienske kjøkkenet. Jeg sier at pizza kan være hva som helst som smaker godt, og at tradisjon alene ikke er noe argument."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bram zegt dat ananas op pizza een misdaad is tegen de Italiaanse keuken. Ik zeg dat pizza is wat lekker is, en dat traditie alleen geen argument is."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଅଭିଷେକ କହୁଛି ଚକୋଲେଟ୍ ରସଗୋଲା ଆମ ମିଠା ପରମ୍ପରାର ଅପମାନ। ମୋ ମତରେ ଯାହା ଖାଇବାକୁ ସୁଆଦ ଲାଗେ ସେଇଟା ହିଁ ଭଲ ମିଠା, ଖାଲି ପରମ୍ପରା କୌଣସି ଯୁକ୍ତି ନୁହେଁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਹਰਮਨ ਕਹਿੰਦਾ ਹੈ ਕਿ ਪੀਜ਼ੇ ’ਤੇ ਅਨਾਨਾਸ ਪਾਉਣਾ ਇਤਾਲਵੀ ਖਾਣੇ ਨਾਲ ਧੱਕਾ ਹੈ। ਮੈਂ ਕਹਿੰਦਾ ਹਾਂ ਕਿ ਪੀਜ਼ਾ ਉਹੀ ਹੈ ਜੋ ਸੁਆਦ ਲੱਗੇ, ਅਤੇ ਸਿਰਫ਼ ਰਿਵਾਜ ਕੋਈ ਦਲੀਲ ਨਹੀਂ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kasia twierdzi, że ananas na pizzy to zbrodnia na włoskiej kuchni. Ja uważam, że na pizzy może być wszystko, co dobrze smakuje, a sama tradycja to żaden argument."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bia diz que ketchup na pizza é um crime contra a cozinha italiana. Eu digo que pizza é do jeito que fica gostoso, e tradição sozinha não é argumento."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Duarte diz que pôr ananás na pizza é um crime contra a cozinha italiana. Eu digo que pizza é o que souber bem, e a tradição, por si só, não é argumento."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bianca zice că ketchupul pe pizza e o crimă împotriva bucătăriei italiene. Eu zic că pizza se mănâncă cum îți place, iar tradiția singură nu e un argument."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Катя говорит, что ананасы на пицце — преступление против итальянской кухни. А по-моему, хорошая пицца — та, что вкусная, а традиция сама по себе не аргумент."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tomáš hovorí, že ananás na pizzi je zločin proti talianskej kuchyni. Ja hovorím, že dobrá pizza je tá, ktorá chutí, a tradícia sama osebe nie je argument."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luka pravi, da je ananas na pici zločin nad italijansko kuhinjo. Jaz pravim, da je pica dobra, če je okusna, in da tradicija sama po sebi ni argument."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maja säger att banan och curry på pizza är ett brott mot det italienska köket. Jag säger att pizza är det som smakar gott, och tradition i sig är inget argument."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பிரியாணியில் உருளைக்கிழங்கு போடுவது பிரியாணிக்கே அவமானம் என்கிறார் மீனா. ருசியாக இருந்தால் அதுவே பிரியாணி, பாரம்பரியம் மட்டுமே ஒரு வாதம் ஆகாது என்கிறேன் நான்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "బిర్యానీలో ఆలూ వేయడం హైదరాబాదీ వంటకానికే అవమానం అని కిరణ్ అంటాడు. రుచిగా ఉంటే అదే బిర్యానీ అని నేనంటాను, సంప్రదాయం అన్నంత మాత్రాన అది వాదన కాదు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บอสบอกว่าการใส่สับปะรดบนพิซซ่าคือการลบหลู่อาหารอิตาเลียน ส่วนเราว่าพิซซ่าจะใส่อะไรก็ได้ที่อร่อย และแค่อ้างธรรมเนียมอย่างเดียวไม่นับเป็นเหตุผลหรอก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selin pizzaya ananas koymanın İtalyan mutfağına hakaret olduğunu söylüyor. Bence pizza neyle lezzetliyse odur, gelenek tek başına bir argüman değil."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Максим каже, що ананас на піці — це злочин проти італійської кухні. А я вважаю, що піца може бути будь-якою, аби смачно, а традиція сама по собі — не аргумент."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "علی کہتا ہے کہ پیزا پر انناس ڈالنا اطالوی کھانوں کی توہین ہے۔ میرا کہنا ہے کہ پیزا وہی ہے جو مزے کا لگے، اور صرف روایت کوئی دلیل نہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hùng bảo cho tương đen vào phở là phá hỏng nước dùng, phở chuẩn vị chẳng ai ăn thế. Mình thì nói ăn phở thấy ngon là được, chỉ viện dẫn truyền thống thì chưa phải là lý lẽ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "思琪说豆腐脑就该是咸的，放糖简直是黑暗料理。我说好吃就行，“从小就这么吃”算不上理由。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "冠宇說鳳梨披薩根本是在褻瀆義大利料理。我說披薩好吃就好，光搬出傳統不能當作理由。"
          }
        }
      }
    },
