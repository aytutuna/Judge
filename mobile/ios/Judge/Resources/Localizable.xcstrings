    "app.example.roadTrip.b" : {
      "comment" : "Generated by mobile/shared/strings/export-strings.ts from lib/i18n.ts. Do not edit.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قلت لك قبل أن ننطلق إنني أكره القيادة ليلًا، ونحن سنغادر في السابعة مساءً. سأتولى القيادة في الصباح في الرحلة القادمة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বেরোনোর আগেই বলেছিলাম রাতে গাড়ি চালাতে আমার একদম ভালো লাগে না, আর আমরা বেরোচ্ছি সন্ধ্যা 7টায়। পরের ট্রিপে সকালের ড্রাইভগুলো আমার।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abans de sortir ja et vaig dir que odio conduir de nit, i marxem a les 7 del vespre. Al pròxim viatge, els matins condueixo jo."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ještě před odjezdem jsem říkala, že nesnáším řízení v noci, a my vyrážíme v sedm večer. Příště beru všechny ranní jízdy já."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeg sagde, inden vi tog af sted, at jeg hader at køre i mørke, og vi kører hjem kl. 19. Næste gang kører jeg om morgenen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich hab schon vor der Abfahrt gesagt, dass ich nachts nicht gern fahre, und wir fahren um 19 Uhr los. Auf der nächsten Reise übernehme ich dafür die Fahrten am Morgen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πριν φύγουμε σου είπα ότι σιχαίνομαι να οδηγώ νύχτα, και φεύγουμε στις 7 το απόγευμα. Στο επόμενο ταξίδι θα οδηγώ εγώ τα πρωινά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I said before we left that I hate driving at night, and we're leaving at 7. I'll take the morning drives next trip."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de salir dije que odio conducir de noche, y salimos a las siete de la tarde. En el próximo viaje conduzco yo por las mañanas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sanoin jo ennen lähtöä, että inhoan ajamista pimeällä, ja lähdemme vasta seitsemältä illalla. Seuraavalla reissulla ajan minä aamuisin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "J’ai dit avant de partir que je déteste conduire de nuit, et on part à 19 h. Je prendrai les trajets du matin la prochaine fois."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "નીકળતાં પહેલાં જ મેં કહ્યું હતું કે મને રાતે ગાડી ચલાવવી જરાય નથી ગમતી, અને આપણે સાંજે 7 વાગ્યે નીકળીએ છીએ. આવતી ટ્રિપમાં સવારનું ડ્રાઇવિંગ હું કરીશ."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אמרתי עוד לפני שיצאנו שאני שונא לנהוג בלילה, ואנחנו יוצאים בשבע בערב. בטיול הבא אני אנהג בבקרים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "निकलने से पहले ही मैंने कहा था कि मुझे रात में गाड़ी चलाना बिल्कुल पसंद नहीं, और हम शाम 7 बजे निकल रहे हैं। अगली ट्रिप में सुबह की ड्राइव मैं कर लूँगी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prije puta sam rekao da mrzim voziti noću, a krećemo u sedam navečer. Idući put ja vozim ujutro."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Már indulás előtt mondtam, hogy utálok éjszaka vezetni, és este hétkor indulunk. A következő úton majd én vezetek reggelente."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sebelum berangkat aku sudah bilang aku benci menyetir malam, dan kita pulang jam 7 malam. Lain kali, biar aku yang menyetir pas pagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima di partire ti avevo detto che odio guidare di notte, e ripartiamo alle sette di sera. Al prossimo viaggio guido io la mattina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "夜の運転は大嫌いだって、出発前に言ったよね。帰りは夜7時出発だよ。次の旅行では朝の運転は全部俺がやるから。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ರಾತ್ರಿ ಡ್ರೈವ್ ಮಾಡುವುದು ನನಗೆ ಸ್ವಲ್ಪವೂ ಇಷ್ಟವಿಲ್ಲ ಅಂತ ಹೊರಡುವ ಮೊದಲೇ ಹೇಳಿದ್ದೆ, ಈಗ ನಾವು ವಾಪಸ್ ಹೊರಡುತ್ತಿರುವುದೇ ಸಂಜೆ 7ಕ್ಕೆ. ಮುಂದಿನ ಟ್ರಿಪ್‌ನಲ್ಲಿ ಬೆಳಗಿನ ಡ್ರೈವಿಂಗ್ ಎಲ್ಲಾ ನಾನೇ ಮಾಡುತ್ತೇನೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "출발 전에 밤 운전은 정말 싫다고 했잖아요. 근데 출발이 저녁 7시예요. 다음 여행 때 아침 운전은 제가 다 할게요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "രാത്രി വണ്ടി ഓടിക്കുന്നത് എനിക്ക് തീരെ ഇഷ്ടമല്ലെന്ന് യാത്ര തുടങ്ങും മുമ്പേ പറഞ്ഞതാണ്, നമ്മൾ ഇവിടന്ന് ഇറങ്ങുന്നത് വൈകിട്ട് 7 മണിക്കും. അടുത്ത യാത്രയിൽ രാവിലത്തെ ഡ്രൈവിങ് ഞാൻ ഏറ്റെടുക്കാം."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "निघण्याआधीच मी सांगितले होते की मला रात्री गाडी चालवायला अजिबात आवडत नाही, आणि आपण संध्याकाळी 7 वाजता निघतोय. पुढच्या ट्रिपला सकाळचे ड्रायव्हिंग मी करेन."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sebelum bertolak saya dah cakap saya benci memandu waktu malam, dan kita gerak pukul 7 malam. Lain kali, saya yang pandu waktu pagi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeg sa før vi dro, at jeg hater å kjøre i mørket, og vi drar klokka sju. På neste tur tar jeg morgenetappene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ik zei voor we vertrokken al dat ik een hekel heb aan rijden in het donker, en we gaan om zeven uur 's avonds weg. Volgende keer rijd ik 's ochtends."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ବାହାରିବା ଆଗରୁ ମୁଁ କହିଥିଲି ରାତିରେ ଗାଡ଼ି ଚଳାଇବା ମୋତେ ଜମା ଭଲ ଲାଗେ ନାହିଁ, ଆଉ ଆମେ ସନ୍ଧ୍ୟା 7ଟାରେ ବାହାରୁଛୁ। ଆର ଥର ସକାଳ ବେଳର ଡ୍ରାଇଭ୍ ମୁଁ କରିବି।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤੁਰਨ ਤੋਂ ਪਹਿਲਾਂ ਹੀ ਮੈਂ ਦੱਸ ਦਿੱਤਾ ਸੀ ਕਿ ਮੈਨੂੰ ਰਾਤ ਨੂੰ ਗੱਡੀ ਚਲਾਉਣੀ ਬਿਲਕੁਲ ਚੰਗੀ ਨਹੀਂ ਲੱਗਦੀ, ਅਤੇ ਅਸੀਂ ਸ਼ਾਮ 7 ਵਜੇ ਨਿਕਲ ਰਹੇ ਹਾਂ। ਅਗਲੇ ਸਫ਼ਰ ’ਤੇ ਸਵੇਰ ਦੀ ਡਰਾਈਵਿੰਗ ਮੇਰੇ ਜ਼ਿੰਮੇ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przed wyjazdem mówiłem, że nie znoszę jeździć po nocy, a wyjeżdżamy o 19. Następnym razem to ja prowadzę rano."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes da viagem eu avisei que odeio dirigir à noite, e a gente vai sair às sete. Na próxima viagem eu pego os trechos de manhã."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antes de sairmos disse que detesto conduzir à noite, e vamos sair às sete da tarde. Na próxima viagem, conduzo eu de manhã."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ți-am zis înainte de plecare că urăsc să conduc noaptea, iar noi plecăm la 7 seara. Data viitoare conduc eu dimineața."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я ещё до поездки говорила, что терпеть не могу водить ночью, а выезжаем мы в семь вечера. В следующей поездке по утрам за рулём буду я."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ešte pred odchodom som hovorila, že neznášam šoférovanie v noci, a my vyrážame o siedmej večer. Nabudúce si zoberiem všetky ranné jazdy ja."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Že pred odhodom sem rekel, da ponoči ne maram voziti, odhajamo pa ob sedmih zvečer. Na naslednjem izletu bom zjutraj vozil jaz."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jag sa innan vi åkte att jag hatar att köra i mörker, och vi åker sju i kväll. Nästa gång kör jag på morgnarna."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இரவில் ஓட்டுவது எனக்குப் பிடிக்காது என்று கிளம்புவதற்கு முன்பே சொன்னேன், நாம் கிளம்புவதோ இரவு 7 மணிக்கு. அடுத்த பயணத்தில் காலை நேர ஓட்டம் எல்லாம் நான் பார்த்துக்கொள்கிறேன்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "రాత్రిపూట డ్రైవ్ చేయడం నాకు అస్సలు ఇష్టం లేదని ట్రిప్ మొదలవకముందే చెప్పాను, ఇక్కడి నుంచి మనం బయలుదేరేదే సాయంత్రం 7కి. వచ్చే ట్రిప్‌లో పొద్దున్నపూట డ్రైవింగ్ అంతా నాదే."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บอกไว้ตั้งแต่ก่อนออกมาแล้วว่าเกลียดขับรถกลางคืน แล้วนี่จะออกกันตอนหนึ่งทุ่ม ทริปหน้าเดี๋ยวเราขับช่วงเช้าให้หมดเลย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yola çıkmadan gece araba kullanmaktan nefret ettiğimi söyledim, akşam yedide çıkıyoruz. Bir dahaki yolculukta sabahları ben sürerim."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я ще до від’їзду казав, що ненавиджу їздити вночі, а виїжджаємо ми о сьомій вечора. Наступного разу ранкові переїзди беру на себе."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نکلنے سے پہلے ہی میں نے کہہ دیا تھا کہ مجھے رات کو گاڑی چلانا بالکل پسند نہیں، اور ہم شام 7 بجے نکل رہے ہیں۔ اگلے سفر میں صبح کے وقت گاڑی میں چلا لوں گی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trước khi đi mình đã nói là rất ghét lái xe ban đêm, mà 7 giờ tối mới lên đường về. Chuyến sau mình sẽ lái mấy chặng buổi sáng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "出发前我就说过我最怕开夜车，可我们晚上 7 点才往回走。下次出去，早上那段都归我开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "出發前我就說過我很討厭開夜車，回程又是晚上 7 點才出發。下次出去玩，早上的路段都我來開。"
          }
        }
      }
    },
    "app.example.roadTrip.bName" : {
