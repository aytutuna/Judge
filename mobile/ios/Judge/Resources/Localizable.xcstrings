        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ban giám khảo bỏ sót điều gì? Bổ sung vào và họ sẽ phân xử lại. Phán quyết đầu tiên vẫn được lưu lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "评委漏掉了什么？补充进来，评委就会重新裁决。原来的裁决会保留在记录里。"
          }
