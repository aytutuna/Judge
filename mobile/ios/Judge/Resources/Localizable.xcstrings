            "value" : "تعذّر تحميل هذه القضية. حاول مجددًا بعد قليل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "মামলাটা লোড করা গেল না। একটু পরে আবার চেষ্টা করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hem pogut carregar aquest cas. Torna-ho a provar d'aquí a una estona."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Případ se nepodařilo načíst. Zkus to za chvilku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi kunne ikke hente sagen. Prøv igen om lidt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir konnten diesen Fall nicht laden. Versuch es gleich noch mal."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν μπορέσαμε να φορτώσουμε την υπόθεση. Δοκίμασε ξανά σε λίγο."
