    "app.example.bill.b" : {
      "comment" : "Generated by mobile/shared/strings/export-strings.ts from lib/i18n.ts. Do not edit.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نحن نقسم الفاتورة على أربعة دائمًا. حساب مَن أخذ ماذا في كل مرة متعب، والفرق ليس كبيرًا أصلًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আমরা তো সবসময় চার ভাগ করেই দিই। প্রতিবার কে কী খেল তার হিসাব করা ঝামেলা, আর তফাতও খুব বেশি না।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sempre ho dividim entre quatre i prou. Calcular cada vegada qui ha pres què és un maldecap, i tampoc no hi ha tanta diferència."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vždycky to prostě dělíme na čtyři. Pokaždé počítat, kdo měl co, je otrava, a ten rozdíl stejně není nijak velký."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi deler altid bare regningen i fire. Det er bøvlet at regne ud hver gang, hvem der fik hvad, og det gør alligevel ikke den store forskel."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir teilen doch immer einfach durch vier. Jedes Mal auszurechnen, wer was hatte, nervt, und so groß ist der Unterschied auch nicht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πάντα τον λογαριασμό τον χωρίζουμε στα τέσσερα. Να βγάζουμε κάθε φορά ποιος έφαγε τι είναι μπελάς, και η διαφορά είναι ψιλά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We always just split it four ways. Working out who had what every time is a pain, and it's not much of a difference anyway."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siempre lo dividimos entre cuatro y ya. Calcular cada vez quién pidió qué es un lío, y además la diferencia es mínima."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jaamme laskun aina neljään osaan. On rasittavaa selvittää joka kerta, kuka söi ja joi mitäkin, eikä ero ole edes iso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On divise toujours en quatre, c’est tout. Calculer à chaque fois qui a pris quoi, c’est pénible, et de toute façon ça ne change pas grand-chose."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આપણે તો હંમેશાં ચાર સરખા ભાગ જ કરીએ છીએ. દર વખતે કોણે શું લીધું એનો હિસાબ કરવો માથાકૂટ છે, અને ફરક પણ કંઈ ખાસ નથી."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "תמיד פשוט מחלקים לארבעה. לחשב כל פעם מי אכל מה זה כאב ראש, וההבדל ממילא לא גדול."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हम तो हमेशा बिल चार बराबर हिस्सों में बाँटते हैं। हर बार हिसाब लगाना कि किसने क्या लिया, बड़ा सिरदर्द है, और फ़र्क भी कोई ख़ास नहीं पड़ता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uvijek samo podijelimo račun na četvero. Svaki put računati tko je što imao prava je gnjavaža, a razlika ionako nije velika."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindig négyfelé osztjuk, és kész. Minden alkalommal kiszámolni, ki mit evett, macerás, és amúgy sem nagy a különbség."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dari dulu kita selalu bagi empat. Menghitung siapa pesan apa tiap kali itu ribet, lagian bedanya juga nggak seberapa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abbiamo sempre diviso per quattro e basta. Rifare ogni volta il conto di chi ha preso cosa è una seccatura, e tanto la differenza è minima."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いつも4人で割り勘にしてるじゃん。毎回誰が何を頼んだか計算するのは面倒だし、どうせたいした差じゃないよ。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಾವು ಯಾವಾಗಲೂ ನಾಲ್ಕು ಭಾಗ ಮಾಡಿಯೇ ಹಂಚಿಕೊಳ್ಳುತ್ತೇವೆ. ಪ್ರತಿ ಸಲ ಯಾರು ಏನು ತೆಗೆದುಕೊಂಡರು ಅಂತ ಲೆಕ್ಕ ಹಾಕುವುದು ದೊಡ್ಡ ತಲೆನೋವು, ಹೇಗಿದ್ದರೂ ವ್ಯತ್ಯಾಸ ಅಷ್ಟೇನೂ ಇಲ್ಲ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "넷이서 늘 그냥 N분의 1로 했잖아요. 매번 누가 뭘 먹었는지 따지는 건 너무 번거롭고, 차이도 얼마 안 나요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നമ്മൾ എപ്പോഴും ബിൽ നാലായി വീതിക്കാറുണ്ടല്ലോ. ഓരോ തവണയും ആര് എന്ത് കഴിച്ചെന്ന് കണക്കുകൂട്ടുന്നത് വലിയ തലവേദനയാണ്, പിന്നെ വ്യത്യാസവും അത്ര വലുതൊന്നുമല്ല."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपण नेहमी चौघांत सरळ वाटून घेतो. दर वेळी कोणी काय घेतले याचा हिशेब करणे म्हणजे डोकेदुखी, आणि तसाही फारसा फरक पडत नाही."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kita selalu bahagi empat saja. Kira siapa makan apa setiap kali tu leceh, lagipun bezanya bukan banyak mana."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi deler jo alltid på fire. Å regne ut hvem som hadde hva hver gang, er et ork, og det er uansett ikke stor forskjell."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We delen het altijd gewoon door vieren. Elke keer uitzoeken wie wat had is gedoe, en zoveel scheelt het toch niet."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆମେ ତ ସବୁବେଳେ ଚାରି ଭାଗ କରି ଦେଇଦେଉ। ପ୍ରତି ଥର କିଏ କ'ଣ ଖାଇଲା ହିସାବ କରିବା ଝାମେଲା, ଆଉ ଫରକ ବି ସେତେ ବେଶି ନୁହେଁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਅਸੀਂ ਹਮੇਸ਼ਾ ਬਿੱਲ ਚਾਰ ਬਰਾਬਰ ਹਿੱਸਿਆਂ ਵਿੱਚ ਵੰਡਦੇ ਹਾਂ। ਹਰ ਵਾਰ ਹਿਸਾਬ ਲਾਉਣਾ ਕਿ ਕਿਸ ਨੇ ਕੀ ਲਿਆ, ਨਿਰੀ ਸਿਰਦਰਦੀ ਹੈ, ਅਤੇ ਫ਼ਰਕ ਵੀ ਕੋਈ ਬਹੁਤਾ ਨਹੀਂ ਪੈਂਦਾ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zawsze po prostu dzielimy rachunek na cztery. Liczenie za każdym razem, kto co zamówił, to męczarnia, a różnica i tak jest niewielka."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gente sempre divide por quatro e pronto. Ficar calculando quem pediu o quê toda vez é um saco, e a diferença nem é tão grande."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dividimos sempre por quatro. Andar sempre a fazer contas a quem comeu o quê é uma seca, e a diferença nem é assim tanta."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mereu împărțim nota la patru și gata. E o bătaie de cap să socotim de fiecare dată cine ce a luat, iar diferența oricum nu e mare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мы всегда просто делим счёт на четверых. Каждый раз выяснять, кто что ел, — морока, да и разница небольшая."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vždy to proste delíme na štyroch. Zakaždým rátať, kto mal čo, je otrava, a ten rozdiel aj tak nie je veľký."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vedno vse razdelimo na štiri. Vsakič računati, kdo je kaj imel, je muka, razlika pa tako ali tako ni velika."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi delar alltid bara på fyra. Att räkna ut vem som tog vad varje gång är jobbigt, och det är ändå ingen stor skillnad."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நாம் எப்போதும் பில்லை நான்காகப் பிரித்துத்தான் கட்டுவோம். ஒவ்வொரு முறையும் யார் என்ன சாப்பிட்டார்கள் என்று கணக்குப் போடுவது பெரிய தொல்லை, அப்படி ஒன்றும் பெரிய வித்தியாசமும் இல்லை."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మనం ఎప్పుడూ నలుగురం సమానంగానే పంచుకుంటాం. ప్రతిసారీ ఎవరు ఏం తీసుకున్నారో లెక్కలు వేయడం తలనొప్పి, పైగా తేడా కూడా పెద్దగా ఉండదు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เราหารสี่กันตลอดอยู่แล้ว จะมานั่งคิดทุกครั้งว่าใครกินอะไรไปบ้างมันวุ่นวาย แล้วก็ต่างกันไม่เท่าไรด้วย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hep dörde bölüyoruz zaten. Her seferinde kim ne yedi diye hesap yapmak çok uğraştırıyor, fark da o kadar değil."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ми завжди просто ділимо на чотирьох. Щоразу рахувати, хто що замовляв, — морока, та й різниця невелика."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہم ہمیشہ بل چار حصوں میں برابر بانٹتے ہیں۔ ہر بار یہ حساب لگانا کہ کس نے کیا کھایا، بڑا جھنجھٹ ہے، اور فرق بھی کون سا زیادہ ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tụi mình lúc nào cũng chia bốn mà. Lần nào cũng ngồi tính ai ăn gì uống gì thì mệt lắm, mà chênh nhau có bao nhiêu đâu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们一直都是四个人平摊。每次都算谁吃了什么太麻烦了，反正也差不了多少。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我們每次都直接四個人平分啊。一項一項算誰點了什麼很麻煩，反正也差不了多少。"
          }
        }
      }
    },
