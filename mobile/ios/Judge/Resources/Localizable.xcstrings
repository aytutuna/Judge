        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiada dalam akaun anda: keputusan ini disimpan dalam telefon ini sahaja. Memadam satu keputusan di sini tidak mematikan pautan kongsinya."
