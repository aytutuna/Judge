        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquesta sol·licitud ve d'un lloc que no reconeixem. Comprova que tens l'app actualitzada i torna-ho a provar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenhle požadavek přišel z neznámého zdroje. Zkontroluj, že máš nejnovější verzi aplikace, a zkus to znovu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anmodningen kom fra et sted, vi ikke kender. Tjek, at appen er opdateret, og prøv igen."
