    "app.translate.offline" : {
      "comment" : "Generated by mobile/shared/strings/export-strings.ts from lib/i18n.ts. Do not edit.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن الترجمة وأنت غير متصل بالإنترنت، فإليك النص الأصلي."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অফলাইনে অনুবাদ করা যায় না, তাই মূল লেখাটাই দেখাচ্ছি।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sense connexió no podem traduir, així que et mostrem l'original."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez připojení to přeložit nejde, takže tu máš originál."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi kan ikke oversætte, når du er offline, så her er originalen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offline können wir nicht übersetzen, deshalb siehst du das Original."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν γίνεται μετάφραση χωρίς σύνδεση, οπότε να το πρωτότυπο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can't translate while you're offline, so here's the original."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede traducir sin conexión, así que aquí tienes el original."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kääntäminen ei onnistu ilman verkkoyhteyttä, joten tässä alkuperäinen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de traduire hors ligne, alors voici l’original."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ઑફલાઇન હો ત્યારે અનુવાદ ન થઈ શકે, એટલે મૂળ લખાણ બતાવીએ છીએ."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אי אפשר לתרגם בלי חיבור לאינטרנט, אז הנה המקור."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऑफ़लाइन होने पर अनुवाद नहीं हो सकता, इसलिए मूल रूप दिखा रहे हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez interneta ne možemo prevesti, pa evo izvornika."
          }
