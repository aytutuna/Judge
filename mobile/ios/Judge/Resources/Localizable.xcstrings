    "pricing.packsLead" : {
      "comment" : "Generated by mobile/shared/strings/export-strings.ts from lib/i18n.ts. Do not edit.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ادفع مرة واحدة واستخدم أحكامك متى شئت. كل حكم تحصل عليه يُخصم من رصيدك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একবার পেমেন্ট করুন, যখন খুশি ব্যবহার করুন। প্রতিটি রায়ে একটি ক্রেডিট খরচ হয়।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paga un cop i fes-los servir quan vulguis. Cada veredicte gasta un crèdit."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaplatíš jednou a použiješ je, kdy chceš. Každý verdikt stojí jeden kredit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betal én gang, og brug dem, når du vil. Hver dom bruger én kredit."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einmal zahlen, jederzeit nutzen. Jedes Urteil verbraucht einen Credit."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πληρώνεις μία φορά και τις χρησιμοποιείς όποτε θες. Κάθε διαφωνία κοστίζει μία απόφαση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pay once and use them whenever. Each verdict uses one credit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paga una vez y úsalos cuando quieras. Cada veredicto usa un crédito."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksa kerran ja käytä milloin vain. Jokainen tuomio vähentää saldoa yhdellä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paie une fois et utilise tes crédits quand tu veux. Chaque verdict utilise un crédit."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "એક વાર ચૂકવો, મન થાય ત્યારે વાપરો. દરેક ચુકાદામાં એક ક્રેડિટ વપરાય છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "משלמים פעם אחת ומשתמשים מתי שרוצים. כל פסק דין עולה קרדיט אחד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक बार पेमेंट करें, जब चाहें इस्तेमाल करें। हर फ़ैसले में एक क्रेडिट लगता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platiš jednom, koristiš kad god želiš. Svaka presuda troši jedan kredit."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egyszer fizetsz, és akkor használod fel, amikor csak akarod. Minden ítélet egy kreditbe kerül."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bayar sekali, pakai kapan saja. Setiap putusan memakai satu kredit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paghi una volta e li usi quando vuoi. Ogni verdetto usa un credito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一度払えば、いつでも使えます。判定1回につき1クレジットを使います。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಒಮ್ಮೆ ಪಾವತಿಸಿ, ಬೇಕಾದಾಗ ಬಳಸಿ. ಪ್ರತಿ ತೀರ್ಪಿಗೆ ಒಂದು ಕ್ರೆಡಿಟ್."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 번 결제하고 원할 때 쓰세요. 판결 1회에 크레딧 1개가 들어요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഒരിക്കൽ പണമടച്ചാൽ ഇഷ്ടമുള്ളപ്പോൾ ഉപയോഗിക്കാം. ഓരോ വിധിക്കും ഒരു ക്രെഡിറ്റ്."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एकदाच पैसे भरा आणि हवे तेव्हा वापरा. प्रत्येक निकालाला एक क्रेडिट लागते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bayar sekali dan guna bila-bila masa. Setiap keputusan menggunakan satu kredit."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betal én gang og bruk dem når du vil. Hver dom bruker én kreditt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eén keer betalen, gebruiken wanneer je wilt. Elke uitspraak kost één credit."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଥରେ ଦେୟ ଦିଅନ୍ତୁ, ଯେବେ ଇଚ୍ଛା ବ୍ୟବହାର କରନ୍ତୁ। ପ୍ରତ୍ୟେକ ରାୟରେ ଗୋଟିଏ କ୍ରେଡିଟ୍ ଖର୍ଚ୍ଚ ହୁଏ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਇੱਕ ਵਾਰ ਪੈਸੇ ਦਿਓ ਅਤੇ ਜਦੋਂ ਮਰਜ਼ੀ ਵਰਤੋ। ਹਰ ਫ਼ੈਸਲੇ ’ਤੇ ਇੱਕ ਕ੍ਰੈਡਿਟ ਲੱਗਦਾ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Płacisz raz i korzystasz, kiedy chcesz. Każdy spór zużywa jeden werdykt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pague uma vez e use quando quiser. Cada veredito usa um crédito."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagas uma vez e usas quando quiseres. Cada veredicto gasta um crédito."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plătești o dată și le folosești oricând. Fiecare verdict folosește un credit."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Платите один раз, а тратите когда угодно: на каждый спор уходит один вердикт из пакета."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaplatíš raz a kredity minieš, kedy chceš. Každý verdikt stojí jeden kredit."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plačaš enkrat, porabiš kadar koli. Vsaka razsodba porabi en kredit."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betala en gång och använd krediterna när du vill. Varje dom kostar en kredit."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ஒருமுறை பணம் செலுத்துங்கள், எப்போது வேண்டுமானாலும் பயன்படுத்துங்கள். ஒவ்வொரு தீர்ப்புக்கும் ஒரு கிரெடிட்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఒకసారి కట్టండి, ఎప్పుడు కావాలంటే అప్పుడు వాడుకోండి. ప్రతి తీర్పుకూ ఒక క్రెడిట్."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จ่ายครั้งเดียว ใช้เมื่อไรก็ได้ คำตัดสินแต่ละครั้งใช้ 1 เครดิต"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir kez öde, istediğin zaman kullan. Her karar bir kredi kullanır."
