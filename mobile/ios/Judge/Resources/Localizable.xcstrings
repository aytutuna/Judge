    "app.example.bill.a" : {
      "comment" : "Generated by mobile/shared/strings/export-strings.ts from lib/i18n.ts. Do not edit.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم أطلب أي مشروب، فلا يصح أن أدفع ربع ثمن المشروبات. أما تقسيم ثمن الطعام بالتساوي فلا مانع عندي."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আমি কোনো ড্রিংক নিইনি, তাই ড্রিংকসের টাকার চার ভাগের এক ভাগ আমি দেব কেন? খাবারের বিল সমান ভাগ করায় আমার আপত্তি নেই।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jo no he begut res, així que no em toca pagar una quarta part del vi. Dividir el menjar a parts iguals ja em va bé."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nic jsem nepila, tak bych neměla platit čtvrtinu vína. Jídlo klidně rozdělme rovným dílem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeg drak ikke noget, så jeg skal ikke betale en fjerdedel af vinen. Maden deler vi gerne ligeligt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich hab nichts getrunken, also zahle ich auch kein Viertel vom Wein. Das Essen können wir gern gleichmäßig aufteilen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν ήπια τίποτα, οπότε δεν πρέπει να πληρώσω το ένα τέταρτο του κρασιού. Το φαγητό ας το μοιράσουμε εξίσου, δεν έχω πρόβλημα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I didn't drink anything, so I shouldn't pay a quarter of the wine. Splitting the food evenly is fine with me."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yo no bebí nada, así que no debería pagar una cuarta parte del vino. Dividir la comida a partes iguales me parece bien."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En juonut mitään, joten minun ei pitäisi maksaa neljäsosaa viinistä. Ruoan voi minun puolestani jakaa tasan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je n’ai rien bu, alors je ne vois pas pourquoi je paierais un quart du vin. Partager le repas à parts égales, ça me va."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "મેં કંઈ પીધું જ નથી, તો ડ્રિંક્સના બિલનો ચોથો ભાગ હું શું કામ ભરું? જમવાનું સરખે ભાગે વહેંચીએ, એમાં મને વાંધો નથી."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא שתיתי כלום, אז אני לא צריכה לשלם רבע מהיין. לחלק את האוכל שווה בשווה זה בסדר מבחינתי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मैंने कुछ पिया ही नहीं, तो वाइन के पैसों का चौथा हिस्सा मैं क्यों दूँ? खाने का बिल बराबर बाँटने में मुझे कोई दिक्कत नहीं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nisam ništa pila, pa ne bih trebala platiti četvrtinu vina. Hranu možemo podijeliti na jednake dijelove, to mi je u redu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Én nem ittam semmit, úgyhogy nem kéne kifizetnem a bor negyedét. Az ételt nyugodtan osszuk el egyenlően."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aku cuma minum air putih, jadi kenapa harus ikut bayar seperempat harga kopi kalian? Kalau makanannya dibagi rata, aku nggak keberatan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Io non ho bevuto niente, quindi non devo pagare un quarto del vino. Per il cibo, alla romana mi va benissimo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "私はお酒を一滴も飲んでないんだから、ワイン代の4分の1を払うのはおかしいと思う。料理代を割り勘にするのは全然いいけど。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಾನು ಏನೂ ಕುಡಿಯಲಿಲ್ಲ, ಹಾಗಾಗಿ ಡ್ರಿಂಕ್ಸ್ ಬಿಲ್‌ನ ಕಾಲು ಭಾಗ ನಾನು ಕೊಡಬೇಕಾಗಿಲ್ಲ. ಊಟದ ಬಿಲ್ ಸಮವಾಗಿ ಹಂಚಿಕೊಳ್ಳುವುದಕ್ಕೆ ನನ್ನ ತಕರಾರಿಲ್ಲ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저는 술을 한 잔도 안 마셨으니까 와인값 4분의 1을 낼 이유가 없어요. 음식값은 똑같이 나눠도 괜찮아요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഞാൻ ഒന്നും കുടിച്ചില്ല, പിന്നെ ബിയറിന്റെ പൈസയുടെ നാലിലൊന്ന് ഞാൻ എന്തിന് കൊടുക്കണം? ഭക്ഷണത്തിന്റെ പൈസ തുല്യമായി വീതിക്കുന്നതിൽ എനിക്ക് പ്രശ്നമില്ല."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मी काहीच प्यायले नाही, मग वाइनचा चौथा हिस्सा मी का भरायचा? जेवणाचे बिल सारखे वाटून घ्यायला माझी काही हरकत नाही."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saya minum air kosong saja, jadi saya tak patut bayar suku daripada bil minuman. Kalau makanan dibahagi sama rata, saya okey."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeg drakk ingenting, så jeg burde ikke betale for en fjerdedel av vinen. Å dele maten likt har jeg ikke noe imot."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ik heb niks gedronken, dus ik hoef geen kwart van de wijn te betalen. Het eten gelijk verdelen vind ik prima."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ମୁଁ ତ କିଛି ପିଇନାହିଁ, ତେଣୁ ୱାଇନ୍‌ର ଚାରି ଭାଗରୁ ଭାଗେ ମୁଁ କାହିଁକି ଦେବି? ଖାଇବା ବିଲ୍ ସମାନ ଭାଗ କଲେ ମୋର କିଛି ଆପତ୍ତି ନାହିଁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਮੈਂ ਤਾਂ ਕੁਝ ਪੀਤਾ ਹੀ ਨਹੀਂ, ਫਿਰ ਮੈਂ ਵਾਈਨ ਦਾ ਚੌਥਾ ਹਿੱਸਾ ਕਿਉਂ ਦੇਵਾਂ? ਖਾਣੇ ਦੇ ਪੈਸੇ ਬਰਾਬਰ ਵੰਡਣ ਵਿੱਚ ਮੈਨੂੰ ਕੋਈ ਇਤਰਾਜ਼ ਨਹੀਂ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nic nie piłam, więc nie powinnam płacić jednej czwartej rachunku za wino. Jedzenie możemy podzielić po równo, to mi pasuje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eu não bebi nada, então não devia pagar um quarto do vinho. Dividir a comida por igual, tudo bem."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não bebi nada, por isso não devia pagar um quarto do vinho. Dividir a comida em partes iguais, por mim, tudo bem."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N-am băut nimic, deci n-ar trebui să plătesc un sfert din vin. Mâncarea s-o împărțim egal, cu asta n-am nicio problemă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я ничего не пила, так что не должна платить четверть за вино. А еду поделить поровну — пожалуйста."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nič som nepila, tak by som nemala platiť štvrtinu vína. Jedlo si pokojne rozdeľme rovným dielom."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nisem nič pila, zato ne bi smela plačati četrtine vina. Hrano pa lahko razdelimo na enake dele, s tem se strinjam."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jag drack ingenting, så jag borde inte betala en fjärdedel av vinet. Att dela lika på maten går bra för mig."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நான் எதுவும் குடிக்கவில்லை, அதனால் பீர் செலவில் கால் பங்கை நான் கட்ட வேண்டியதில்லை. சாப்பாட்டுச் செலவைச் சமமாகப் பிரிப்பதில் எனக்குப் பிரச்சினை இல்லை."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "నేను డ్రింక్స్ ఏమీ తాగలేదు, అలాంటప్పుడు వాటిలో నాలుగో వంతు నేనెందుకు కట్టాలి? భోజనం బిల్లు సమానంగా పంచుకుంటే నాకు అభ్యంతరం లేదు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เราไม่ได้ดื่มอะไรเลย ก็ไม่ควรต้องจ่ายค่าไวน์หนึ่งในสี่ ส่วนค่าอาหารหารเท่ากันได้ ไม่มีปัญหา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiç içmedim, şarabın dörtte birini ben ödememeliyim. Yemeği eşit bölelim, ona itirazım yok."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я взагалі нічого не пила, тож не маю платити чверть за вино. А їжу поділити порівну — я не проти."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "میں نے کولڈ ڈرنک پی ہی نہیں، تو ڈرنکس کا چوتھا حصہ میں کیوں دوں؟ کھانے کا بل برابر بانٹنے پر مجھے کوئی اعتراض نہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mình có uống giọt nào đâu, sao lại phải trả một phần tư tiền bia. Đồ ăn chia đều thì mình không ý kiến."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我一口酒都没喝，不该摊四分之一的酒钱吧。菜钱平摊我没意见。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我一口酒都沒喝，不該分攤四分之一的酒錢。菜錢平分我沒意見。"
          }
        }
      }
    },
