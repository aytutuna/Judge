    "app.example.dishwasher.b" : {
      "comment" : "Generated by mobile/shared/strings/export-strings.ts from lib/i18n.ts. Do not edit.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الرف العلوي يتّسع لها تمامًا، وهكذا يبقى السفلي فارغًا للقدور. أرتّب غسالة الصحون بهذه الطريقة منذ سنوات، ولم يخرج منها شيء متّسخًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ভিজিয়ে রাখলে সকালে এক মিনিটে পরিষ্কার হয়ে যায়। বছরের পর বছর এভাবেই করছি, কোনোদিন কোনো সমস্যা হয়নি।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hi caben perfectament, i així la de baix queda lliure per a les olles. Fa anys que el carrego així i mai no ha sortit res brut."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nahoru se vejdou v pohodě a dole zůstane místo na hrnce. Takhle myčku plním už roky a ještě nikdy nic nezůstalo špinavé."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De kan sagtens være deroppe, og så er der plads til gryderne i bunden. Jeg har fyldt den sådan i årevis, og der er aldrig kommet noget beskidt ud."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die passen oben gut rein, und unten bleibt Platz für die Töpfe. Ich räume die Spülmaschine seit Jahren so ein, und noch nie ist was dreckig rausgekommen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χωράνε μια χαρά εκεί πάνω και μένει το κάτω ελεύθερο για τις κατσαρόλες. Χρόνια τα βάζω έτσι και δεν έχει βγει τίποτα βρόμικο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They fit fine up there and it leaves the bottom free for the pans. I've loaded it like this for years and nothing's come out dirty."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caben perfectamente arriba y así queda libre la parte de abajo para las ollas. Llevo años cargándolo así y nunca ha salido nada sucio."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne mahtuvat sinne ihan hyvin, ja alas jää tilaa kattiloille. Olen täyttänyt koneen näin jo vuosia, eikä mikään ole jäänyt likaiseksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ils y rentrent très bien, et ça laisse le bas libre pour les casseroles. Je remplis le lave-vaisselle comme ça depuis des années et rien n’est jamais ressorti sale."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ઉપર એ આરામથી સમાઈ જાય છે, અને નીચે તપેલાં માટે જગ્યા રહે છે. હું વર્ષોથી આમ જ ગોઠવું છું, ને કદી કંઈ ગંદું નથી નીકળ્યું."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הן נכנסות שם בלי בעיה, וככה נשאר מקום למטה לסירים. אני מסדר ככה כבר שנים ושום דבר לא יצא מלוכלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऊपर आराम से आ जाती हैं, और नीचे कड़ाही-पतीलों के लिए जगह बचती है। मैं सालों से ऐसे ही लगाता आया हूँ, आज तक कोई बर्तन गंदा नहीं निकला।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gore sasvim lijepo stanu, a dolje ostaje mjesta za lonce. Godinama ovako punim perilicu i još ništa nije izašlo prljavo."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Simán elférnek fent, és így az alsó kosár szabad marad a lábasoknak. Évek óta így pakolom, és még soha semmi nem jött ki koszosan."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditumpuk begitu lebih hemat tempat, jadi sisa raknya bisa buat wajan. Aku sudah bertahun-tahun begini dan nggak pernah ada yang bau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ci stanno benissimo, e così sotto resta posto per le pentole. Lo carico così da anni e non è mai uscito niente sporco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上でもちゃんと入るし、そのほうが下の段を鍋やフライパンに使えるじゃん。何年もこうやって入れてるけど、汚れが残ったことなんて一度もないよ。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಮೇಲೆ ಅವು ಆರಾಮವಾಗಿ ಹಿಡಿಯುತ್ತವೆ, ಕೆಳಗೆ ಬಾಣಲೆಗಳಿಗೆ ಜಾಗ ಉಳಿಯುತ್ತದೆ. ವರ್ಷಗಳಿಂದ ನಾನು ಹೀಗೇ ಇಡುತ್ತಿದ್ದೇನೆ, ಒಂದು ಸಲವೂ ಯಾವುದೂ ಕೊಳೆಯಾಗಿ ಬಂದಿಲ್ಲ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위에도 충분히 들어가고, 그래야 아래 칸을 냄비 자리로 비워 둘 수 있어요. 몇 년째 이렇게 넣었는데 덜 닦인 적이 한 번도 없어요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "മുകളിൽ അവ നന്നായി കൊള്ളും, താഴെ ചട്ടികൾക്കും കലങ്ങൾക്കും സ്ഥലം കിട്ടുകയും ചെയ്യും. വർഷങ്ങളായി ഞാൻ ഇങ്ങനെയാണ് അടുക്കിവെക്കുന്നത്, ഒന്നും ഇതുവരെ വൃത്തിയാകാതെ വന്നിട്ടില്ല."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "त्या वर व्यवस्थित बसतात, आणि खाली पातेल्यांसाठी जागा राहते. मी वर्षानुवर्षे भांडी अशीच लावतो, आणि एकदाही काही खरकटे राहिलेले नाही."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muat saja kat atas, jadi rak bawah kosong untuk periuk. Dah bertahun saya susun macam ni, tak ada pun yang keluar kotor."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De får fint plass der oppe, og da er underkurven ledig til kjelene. Jeg har fylt maskinen sånn i årevis, og ingenting har kommet ut skittent."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ze passen daar prima, en dan blijft het onderste rek vrij voor de pannen. Ik ruim de vaatwasser al jaren zo in en er is nog nooit iets vies uitgekomen."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଉପରେ ସେଗୁଡ଼ା ଭଲରେ ଧରିଯାଉଛି, ଆଉ ତଳ ଥାକ କଡ଼େଇ-ହାଣ୍ଡି ପାଇଁ ଖାଲି ରହୁଛି। ମୁଁ ବର୍ଷ ବର୍ଷ ଧରି ଏମିତି ରଖୁଛି, କେବେ କିଛି ମଇଳା ବାହାରିନାହିଁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਉੱਪਰ ਇਹ ਆਰਾਮ ਨਾਲ ਆ ਜਾਂਦੀਆਂ ਹਨ, ਅਤੇ ਹੇਠਾਂ ਪਤੀਲਿਆਂ ਲਈ ਥਾਂ ਬਚ ਜਾਂਦੀ ਹੈ। ਮੈਂ ਸਾਲਾਂ ਤੋਂ ਇੰਝ ਹੀ ਭਾਂਡੇ ਰੱਖਦਾ ਆ ਰਿਹਾ ਹਾਂ ਅਤੇ ਕਦੇ ਕੁਝ ਗੰਦਾ ਨਹੀਂ ਨਿਕਲਿਆ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mieszczą się tam bez problemu, a dół zostaje wolny na garnki. Od lat tak ładuję zmywarkę i nigdy nic nie wyszło niedomyte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elas cabem direitinho lá em cima, e assim a parte de baixo fica livre para as panelas. Coloco desse jeito há anos e nunca saiu nada sujo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cabem lá perfeitamente e deixam o de baixo livre para as panelas. Ponho a loiça assim há anos e nunca saiu nada sujo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Încap foarte bine sus și rămâne loc jos pentru oale. Le pun așa de ani de zile și n-a ieșit nimic murdar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наверху они отлично помещаются, а внизу остаётся место для кастрюль. Я так загружаю уже много лет, и ни разу ничего не осталось грязным."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hore sa zmestia v pohode a dole ostane miesto na hrnce. Takto umývačku plním už roky a ešte nikdy z nej nič nevyšlo špinavé."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zgoraj čisto lepo gredo, spodaj pa ostane prostor za lonce. Pomivalni stroj tako polnim že leta in še nikoli ni nič ostalo umazano."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De får plats fint där uppe, och då blir underkorgen ledig för kastrullerna. Jag har plockat in disken så här i flera år och allt har blivit rent."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "அவை மேலே நன்றாகவே பொருந்துகின்றன, கீழே பெரிய பாத்திரங்களுக்கு இடமும் கிடைக்கிறது. பல வருடங்களாக இப்படித்தான் அடுக்குகிறேன், ஒன்றுகூட அழுக்காக வந்ததில்லை."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "అవి పైన చక్కగా సరిపోతాయి, కింద పెనాలకు, బాణళ్లకు చోటు మిగులుతుంది. ఏళ్లుగా ఇలాగే సర్దుతున్నాను, ఒక్కటి కూడా మురికిగా రాలేదు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ข้างบนก็ใส่ได้พอดี แถมเหลือที่ชั้นล่างไว้ใส่หม้อกับกระทะ เราเรียงแบบนี้มาหลายปีแล้ว ไม่เห็นมีชิ้นไหนออกมาไม่สะอาดเลย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Üstte gayet sığıyorlar, alt raf da tencerelere kalıyor. Yıllardır böyle diziyorum, bir kere bile kirli çıkmadı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нагорі вони чудово вміщаються, а внизу лишається місце для каструль. Я роками так завантажую посудомийку, і все завжди відмивається."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اوپر آرام سے آ جاتے ہیں، اور نیچے کی جگہ دیگچیوں کے لیے بچ جاتی ہے۔ میں برسوں سے ایسے ہی رکھتا آیا ہوں، اور آج تک ایک برتن بھی گندا نہیں نکلا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để trên vừa khít mà, lại chừa ngăn dưới cho xoong nồi. Mình xếp kiểu này mấy năm rồi, có cái nào ra mà còn bẩn đâu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上层放得下啊，下层正好留给锅。我这么放好几年了，从来都洗得干干净净。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "碗放上面剛剛好，下層還能空出來放鍋子。我這樣放好幾年了，從來沒洗不乾淨過。"
          }
        }
      }
    },
