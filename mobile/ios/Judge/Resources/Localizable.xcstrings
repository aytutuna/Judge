        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಆರ್ಡರ್, ಆರ್ಡರ್! ಸದ್ಯಕ್ಕೆ ನಿಮ್ಮ ಮಿತಿ ಮುಗಿದಿದೆ. %1$@ ಬಿಟ್ಟು ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "정숙, 정숙! 지금은 이용 한도에 걸렸어요. %1$@ 뒤에 다시 시도해 주세요."
          }
