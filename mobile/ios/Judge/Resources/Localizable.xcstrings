    "signin.lead" : {
      "comment" : "Generated by mobile/shared/strings/export-strings.ts from lib/i18n.ts. Do not edit.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سجّل الدخول لتحصل على حكم. أول حكم مجاني لكل حساب جديد."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "রায় পেতে সাইন ইন করুন। নতুন অ্যাকাউন্টে প্রথম রায় ফ্রি।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sessió per obtenir un veredicte. Els comptes nous tenen el primer veredicte gratis."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro verdikt se přihlas. Nový účet má první verdikt zdarma."
