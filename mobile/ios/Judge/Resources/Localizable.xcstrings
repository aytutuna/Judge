    "lean.majority" : {
      "comment" : "Generated by mobile/shared/strings/export-strings.ts from lib/i18n.ts. Do not edit.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مال القضاة إلى هذا الجانب بنتيجة %1$@–%2$@."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বিচারকেরা %1$@–%2$@ ভোটে এই দিকে ঝুঁকেছেন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els jutges s'han decantat cap a aquest costat per %1$@ a %2$@."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soudci se sem přiklonili v poměru %1$@–%2$@."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dommerne hældede til den side med %1$@–%2$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Richter tendierten mit %1$@:%2$@ in diese Richtung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι κριτές έγειραν προς τα εδώ με %1$@–%2$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The judges leaned this way %1$@–%2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los jueces se inclinaron por este lado: %1$@ a %2$@."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuomarit kallistuivat tälle puolelle äänin %1$@–%2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les juges penchent de ce côté, à %1$@ contre %2$@."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "જજ %1$@–%2$@થી આ તરફ ઝૂક્યા."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השופטים נטו לכיוון הזה, %1$@ מול %2$@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जजों का झुकाव %1$@–%2$@ से इसी तरफ़ था।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suci naginju ovoj strani rezultatom %1$@–%2$@."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A bírák %1$@–%2$@ arányban erre hajlottak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para hakim condong ke sini, %1$@–%2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I giudici pendono da questa parte %1$@–%2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "審査員は%1$@対%2$@でこちら寄りでした。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ತೀರ್ಪುಗಾರರು %1$@–%2$@ ಮತಗಳಿಂದ ಇದೇ ಕಡೆ ವಾಲಿದರು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "판사들이 이쪽으로 기울었어요 (%1$@–%2$@)."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ജഡ്ജിമാർ %1$@–%2$@ എന്ന നിലയിൽ ഈ ഭാഗത്തേക്ക് ചാഞ്ഞു."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "परीक्षकांचा कल %1$@–%2$@ असा याच बाजूला होता."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hakim condong ke arah ini %1$@–%2$@."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dommerne heller mot denne siden, %1$@–%2$@."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De rechters neigden %1$@–%2$@ deze kant op."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ବିଚାରକମାନେ %1$@–%2$@ ଭୋଟ୍‌ରେ ଏହି ପକ୍ଷ ଆଡ଼କୁ ଝୁଙ୍କିଲେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਜੱਜਾਂ ਦਾ ਝੁਕਾਅ %1$@–%2$@ ਨਾਲ ਇਸ ਪਾਸੇ ਸੀ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sędziowie skłaniali się ku tej stronie stosunkiem głosów %1$@–%2$@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os juízes penderam para este lado por %1$@–%2$@."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os juízes inclinaram-se para este lado por %1$@–%2$@."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Judecătorii au înclinat în partea asta: %1$@–%2$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
