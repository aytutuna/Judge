    "app.example.jacket.a" : {
      "comment" : "Generated by mobile/shared/strings/export-strings.ts from lib/i18n.ts. Do not edit.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لبستِ سترتي الجينز إلى الحفل دون أن تستأذنيني، وأعدتِها ورائحة الدخان تفوح منها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আমাকে জিজ্ঞেস না করেই তুমি আমার ডেনিম জ্যাকেটটা পরে কনসার্টে গেছ। ফেরত এল ধোঁয়ার গন্ধ নিয়ে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et vas posar la meva jaqueta texana per anar al concert sense preguntar-m'ho. Me la vas tornar fent pudor de fum."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vzala sis moji džínovou bundu na koncert a ani ses nezeptala. Vrátila se celá načichlá kouřem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du havde min cowboyjakke på til koncerten uden at spørge. Da jeg fik den tilbage, lugtede den af røg."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast meine Jeansjacke ungefragt zum Konzert angezogen. Sie kam total verraucht zurück."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Φόρεσες το τζιν μπουφάν μου στη συναυλία χωρίς να με ρωτήσεις. Γύρισε πίσω και μύριζε τσιγαρίλα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You wore my denim jacket to the concert without asking. It came back smelling like smoke."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te llevaste mi chaqueta vaquera al concierto sin preguntarme. Volvió oliendo a humo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pidit farkkutakkiani keikalla kysymättä. Kun sain sen takaisin, se haisi tupakalta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as mis ma veste en jean pour aller au concert sans me demander. Elle m’est revenue avec une odeur de tabac."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તું મને પૂછ્યા વગર મારું ડેનિમ જૅકેટ પહેરીને કૉન્સર્ટમાં ગયો. પાછું આવ્યું ત્યારે એમાંથી ધુમાડાની વાસ આવતી હતી."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לבשת את ז'קט הג'ינס שלי להופעה בלי לשאול. הוא חזר עם ריח של עשן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुम मेरी डेनिम जैकेट बिना पूछे कॉन्सर्ट में पहनकर चली गईं। वापस आई तो उसमें से धुएँ की बदबू आ रही थी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obukla si moju traper jaknu na koncert, a nisi me ni pitala. Vratila si je i sad sva smrdi po dimu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meg sem kérdeztél, csak felvetted a farmerdzsekimet a koncertre. Füstszagúan kaptam vissza."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu pakai jaket jinku ke konser tanpa izin. Pas dikembalikan, jaketnya bau asap rokok."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai messo il mio giubbotto di jeans per andare al concerto senza chiedermelo. È tornato che puzzava di fumo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "俺のデニムジャケット、勝手にライブに着ていったよね。タバコくさくなって返ってきたんだけど。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನೀನು ನನ್ನನ್ನು ಕೇಳದೆಯೇ ನನ್ನ ಡೆನಿಮ್ ಜಾಕೆಟ್ ಹಾಕಿಕೊಂಡು ಕನ್ಸರ್ಟ್‌ಗೆ ಹೋದೆ. ಅದು ವಾಪಸ್ ಬಂದಾಗ ಹೊಗೆಯ ವಾಸನೆ ಹೊಡೆಯುತ್ತಿತ್ತು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제 청재킷을 말도 없이 입고 콘서트에 갔잖아요. 돌려받았더니 담배 냄새가 배어 있었어요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ചോദിക്കാതെ എന്റെ ഡെനിം ജാക്കറ്റും ഇട്ടാണ് നിങ്ങൾ കൺസേർട്ടിന് പോയത്. തിരിച്ചുകിട്ടിയപ്പോൾ അതിന് പുകമണമായിരുന്നു."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तू मला न विचारता माझे डेनिम जॅकेट घालून कॉन्सर्टला गेलीस. ते परत आले तेव्हा त्याला धुराचा वास येत होता."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Awak pakai jaket denim saya pergi konsert tanpa tanya dulu. Bila dapat balik, jaket tu bau asap rokok."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du gikk på konsert i dongerijakka mi uten å spørre. Da jeg fikk den tilbake, luktet den røyk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je bent zonder te vragen in mijn spijkerjack naar het concert gegaan. Toen ik het terugkreeg, stonk het naar rook."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ମୋତେ ନ ପଚାରି ତୁମେ ମୋ ଡେନିମ୍ ଜ୍ୟାକେଟ୍ ପିନ୍ଧି କନ୍‌ସର୍ଟ୍‌କୁ ଯାଇଥିଲ। ଫେରିଲା ବେଳକୁ ସେଥିରୁ ସିଗାରେଟ୍ ଗନ୍ଧ ବାହାରୁଥିଲା।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤੁਸੀਂ ਮੈਨੂੰ ਪੁੱਛੇ ਬਿਨਾਂ ਮੇਰੀ ਡੈਨਿਮ ਜੈਕਟ ਪਾ ਕੇ ਕੌਂਸਰਟ ’ਤੇ ਚਲੇ ਗਏ। ਵਾਪਸ ਆਈ ਤਾਂ ਉਸ ਵਿੱਚੋਂ ਧੂੰਏਂ ਦੀ ਬੋ ਆ ਰਹੀ ਸੀ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poszłaś w mojej dżinsowej kurtce na koncert i nawet nie zapytałaś. Wróciła cała przesiąknięta dymem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você foi ao show com a minha jaqueta jeans sem pedir. Ela voltou com cheiro de cigarro."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Levaste o meu casaco de ganga ao concerto sem perguntar. Veio a cheirar a fumo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mi-ai luat geaca de blugi la concert fără să mă întrebi. Mi-ai adus-o înapoi mirosind a fum."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты без спроса надела мою джинсовку на концерт. Она вернулась вся прокуренная."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zobrala si si moju džínsovú bundu na koncert a ani si sa neopýtala. Vrátila sa mi celá presiaknutá dymom."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mojo jeans jakno si oblekla na koncert, ne da bi me vprašala. Vrnila si jo vso smrdečo po dimu."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hade på dig min jeansjacka på konserten utan att fråga. Den luktade rök när jag fick tillbaka den."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "என்னைக் கேட்காமலேயே என் டெனிம் ஜாக்கெட்டைப் போட்டுக்கொண்டு இசை நிகழ்ச்சிக்குப் போனாய். திரும்பி வந்தபோது அதில் சிகரெட் நாற்றம் அடித்தது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీరు నన్ను అడగకుండా నా డెనిమ్ జాకెట్ వేసుకుని కాన్సర్ట్‌కి వెళ్లారు. అది సిగరెట్ వాసనతో తిరిగొచ్చింది."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เอาแจ็กเก็ตยีนส์ของเราไปใส่ดูคอนเสิร์ตโดยไม่ถามสักคำ ได้คืนมาก็เหม็นควันหึ่งเลย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kot ceketimi bana sormadan konsere giymişsin. Sigara kokarak geri geldi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ти вдягла мою джинсову куртку на концерт і навіть не спитала. Вона повернулася вся просякнута димом."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم میری ڈینم جیکٹ بغیر پوچھے کنسرٹ میں پہن گئیں۔ واپس آئی تو اس میں سے دھوئیں کی بو آ رہی تھی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn mặc áo khoác jean của mình đi xem ca nhạc mà không hỏi. Lúc trả lại thì ám mùi khói thuốc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你没问我一声，就穿我的牛仔外套去看演唱会了，还回来一股烟味。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你沒問我就穿我的牛仔外套去演唱會。還回來的時候一身菸味。"
          }
        }
      }
    },
