        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spojení se přerušilo, zatímco aplikace Judge běžela na pozadí. Zkus to znovu a nech aplikaci otevřenou, dokud verdikt nedorazí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forbindelsen blev afbrudt, mens Judge kørte i baggrunden. Prøv igen, og hold appen åben, indtil dommen er kommet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Verbindung ist abgebrochen, während Judge im Hintergrund lief. Versuch es noch mal und lass die App offen, bis das Urteil da ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η σύνδεση κόπηκε όσο το Judge ήταν στο παρασκήνιο. Δοκίμασε ξανά και κράτα την εφαρμογή ανοιχτή μέχρι να έρθει η απόφαση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The connection dropped while Judge was in the background. Try again, and keep the app open until the verdict arrives."
          }
