    "app.account.deleteBody" : {
      "comment" : "Generated by mobile/shared/strings/export-strings.ts from lib/i18n.ts. Do not edit.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستُحذف بيانات تسجيل دخولك ورصيدك وخطتك وبياناتك الشخصية، وستتوقف روابط مشاركتك عن العمل. أما نصوص الأحكام فتبقى محفوظة دون اسمك، كما هو موضح في سياسة الخصوصية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার সাইন-ইনের তথ্য, ক্রেডিট, প্ল্যান আর ব্যক্তিগত ডেটা মুছে যাবে, আর আপনার শেয়ার লিংকগুলো কাজ করা বন্ধ করবে। গোপনীয়তা নীতিতে যেমন বলা আছে, রায়ের লেখা আপনার নাম ছাড়া রেখে দেওয়া হবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'esborraran les teves dades d'inici de sessió, els crèdits, el pla i les dades personals, i els teus enllaços per compartir deixaran de funcionar. El text dels veredictes es conservarà sense el teu nom, tal com s'explica a la Política de privadesa."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoje přihlašovací údaje, kredity, plán a osobní data se smažou a tvoje sdílené odkazy přestanou fungovat. Texty verdiktů zůstanou uložené bez tvého jména, jak vysvětlují zásady ochrany soukromí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dine loginoplysninger, dine kreditter, din plan og dine personoplysninger bliver slettet, og dine delingslinks holder op med at virke. Teksten i dommene bliver stadig gemt, men uden dit navn, som beskrevet i privatlivspolitikken."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Anmeldedaten, deine Credits, dein Tarif und deine persönlichen Daten werden gelöscht, und deine geteilten Links funktionieren nicht mehr. Der Text deiner Urteile bleibt ohne deinen Namen gespeichert, wie in der Datenschutzerklärung beschrieben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θα διαγραφούν τα στοιχεία σύνδεσης, το υπόλοιπο αποφάσεων, το πρόγραμμα και τα προσωπικά σου δεδομένα, και οι σύνδεσμοι κοινοποίησης θα σταματήσουν να λειτουργούν. Το κείμενο των αποφάσεων θα μείνει αποθηκευμένο χωρίς το όνομά σου, όπως εξηγεί η Πολιτική Απορρήτου."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your sign-in details, credits, plan and personal data are deleted, and your share links stop working. Verdict text stays stored without your name, as explained in the Privacy Policy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán tus datos de inicio de sesión, tus créditos, tu plan y tu información personal, y tus enlaces para compartir dejarán de funcionar. El texto de los veredictos se seguirá guardando sin tu nombre, como se explica en la Política de privacidad."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kirjautumistietosi, tuomiosaldosi, tilauksesi ja henkilötietosi poistetaan, ja jakolinkkisi lakkaavat toimimasta. Tuomioiden teksti säilyy tallessa ilman nimeäsi, kuten tietosuojakäytännössä kerrotaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes informations de connexion, tes crédits, ton offre et tes données personnelles seront effacés, et tes liens de partage cesseront de fonctionner. Le texte des verdicts sera conservé sans ton nom, comme l’explique la Politique de confidentialité."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમારી સાઇન ઇનની વિગતો, ક્રેડિટ, પ્લાન અને અંગત ડેટા ડિલીટ થશે, અને તમારી શેર લિંક કામ કરતી બંધ થઈ જશે. ગોપનીયતા નીતિમાં સમજાવ્યા મુજબ, ચુકાદાનું લખાણ તમારા નામ વગર સચવાયેલું રહેશે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פרטי ההתחברות, הקרדיטים, התוכנית והמידע האישי שלך יימחקו, וקישורי השיתוף שלך יפסיקו לעבוד. הטקסט של פסקי הדין יישמר בלי השם שלך, כפי שמוסבר במדיניות הפרטיות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी साइन इन जानकारी, क्रेडिट, प्लान और निजी डेटा मिट जाएँगे, और आपके शेयर लिंक काम करना बंद कर देंगे। फ़ैसलों का टेक्स्ट आपके नाम के बिना सेव रहेगा, जैसा प्राइवेसी पॉलिसी में बताया गया है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brišu se tvoji podaci za prijavu, krediti, plan i ostali osobni podaci, a tvoje poveznice za dijeljenje prestaju raditi. Tekst presuda ostaje spremljen bez tvog imena, kako je objašnjeno u Pravilima privatnosti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A belépési adataid, a kreditjeid, az előfizetésed és a személyes adataid törlődnek, a megosztási linkjeid pedig megszűnnek működni. Az ítéletek szövegét a neved nélkül megőrizzük, ahogy az Adatvédelmi tájékoztató leírja."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data masuk, kredit, langganan, dan informasi pribadimu akan dihapus, dan tautan berbagimu tidak berfungsi lagi. Teks putusan tetap disimpan tanpa namamu, seperti dijelaskan di Kebijakan Privasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi dati di accesso, i crediti, il piano e i dati personali verranno cancellati e i tuoi link di condivisione smetteranno di funzionare. Il testo dei verdetti resterà conservato senza il tuo nome, come spiegato nell'Informativa sulla privacy."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ログイン情報、クレジット、プラン、個人データが削除され、シェア用リンクも使えなくなります。判定の本文は、プライバシーポリシーに記載のとおり、あなたの名前を除いた形で残ります。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಿಮ್ಮ ಸೈನ್ ಇನ್ ವಿವರಗಳು, ಕ್ರೆಡಿಟ್‌ಗಳು, ಪ್ಲಾನ್ ಮತ್ತು ವೈಯಕ್ತಿಕ ಡೇಟಾ ಅಳಿಸಿಹೋಗುತ್ತವೆ ಮತ್ತು ನಿಮ್ಮ ಹಂಚಿಕೆ ಲಿಂಕ್‌ಗಳು ಕೆಲಸ ಮಾಡುವುದನ್ನು ನಿಲ್ಲಿಸುತ್ತವೆ. ಗೌಪ್ಯತಾ ನೀತಿಯಲ್ಲಿ ಹೇಳಿರುವಂತೆ, ತೀರ್ಪುಗಳ ಪಠ್ಯ ನಿಮ್ಮ ಹೆಸರಿಲ್ಲದೆ ಸಂಗ್ರಹವಾಗಿ ಉಳಿಯುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "로그인 정보, 크레딧, 요금제, 개인정보가 삭제되고 공유 링크도 더 이상 열리지 않아요. 판결 내용은 개인정보 처리방침에 설명된 대로 이름을 뺀 채 보관돼요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിങ്ങളുടെ സൈൻ-ഇൻ വിവരങ്ങളും ക്രെഡിറ്റുകളും പ്ലാനും വ്യക്തിഗത ഡാറ്റയും ഡിലീറ്റ് ചെയ്യും, നിങ്ങളുടെ ഷെയർ ലിങ്കുകൾ പ്രവർത്തിക്കാതാകും. സ്വകാര്യതാ നയത്തിൽ പറഞ്ഞിട്ടുള്ളതുപോലെ, വിധികളുടെ ടെക്സ്റ്റ് നിങ്ങളുടെ പേരില്ലാതെ സൂക്ഷിക്കും."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुमची साइन-इनची माहिती, क्रेडिट, प्लॅन आणि वैयक्तिक डेटा डिलीट होतील, आणि तुमच्या शेअर लिंक चालणे बंद होईल. गोपनीयता धोरणात सांगितल्याप्रमाणे निकालांचा मजकूर तुमच्या नावाशिवाय साठवलेला राहतो."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Butiran log masuk, kredit, pelan dan data peribadi anda akan dipadam, dan pautan kongsi anda akan berhenti berfungsi. Teks keputusan kekal disimpan tanpa nama anda, seperti yang diterangkan dalam Dasar Privasi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Innloggingsopplysningene, kredittene, abonnementet og personopplysningene dine slettes, og delingslenkene dine slutter å virke. Teksten i dommene beholdes uten navnet ditt, slik det står i personvernerklæringen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je inloggegevens, credits, abonnement en persoonsgegevens worden gewist, en je deellinks werken niet meer. De tekst van uitspraken blijft zonder je naam bewaard, zoals beschreven in het privacybeleid."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆପଣଙ୍କ ସାଇନ୍ ଇନ୍ ବିବରଣୀ, କ୍ରେଡିଟ୍, ପ୍ଲାନ୍ ଓ ବ୍ୟକ୍ତିଗତ ଡାଟା ଡିଲିଟ୍ ହେବ, ଏବଂ ଆପଣଙ୍କ ସେୟାର୍ ଲିଙ୍କ୍ ଆଉ କାମ କରିବ ନାହିଁ। ଗୋପନୀୟତା ନୀତିରେ ଯେମିତି କୁହାଯାଇଛି, ରାୟର ଲେଖା ଆପଣଙ୍କ ନାମ ବିନା ରଖାଯିବ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤੁਹਾਡੇ ਸਾਈਨ ਇਨ ਦੇ ਵੇਰਵੇ, ਕ੍ਰੈਡਿਟ, ਪਲਾਨ ਅਤੇ ਨਿੱਜੀ ਡਾਟਾ ਮਿਟ ਜਾਣਗੇ, ਅਤੇ ਤੁਹਾਡੇ ਸਾਂਝੇ ਲਿੰਕ ਕੰਮ ਕਰਨਾ ਬੰਦ ਕਰ ਦੇਣਗੇ। ਫ਼ੈਸਲਿਆਂ ਦੀ ਲਿਖਤ ਤੁਹਾਡੇ ਨਾਂ ਤੋਂ ਬਿਨਾਂ ਸਾਡੇ ਕੋਲ ਸੇਵ ਰਹੇਗੀ, ਜਿਵੇਂ ਪਰਦੇਦਾਰੀ ਨੀਤੀ ਵਿੱਚ ਦੱਸਿਆ ਗਿਆ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuniemy twoje dane logowania, pulę werdyktów, plan i dane osobowe, a twoje linki do udostępniania przestaną działać. Treść werdyktów zachowujemy bez twojego imienia, jak opisano w Polityce prywatności."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suas informações de login, seus créditos, seu plano e seus dados pessoais são apagados, e seus links de compartilhamento param de funcionar. O texto dos vereditos continua guardado sem o seu nome, como explica a Política de Privacidade."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apagamos os teus dados de acesso, créditos, plano e dados pessoais, e os teus links de partilha deixam de funcionar. O texto dos veredictos fica guardado sem o teu nome, como explica a Política de Privacidade."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se șterg datele de conectare, creditele, planul și informațiile tale personale, iar linkurile tale de distribuire nu vor mai funcționa. Textul verdictelor rămâne stocat fără numele tău, așa cum se explică în Politica de confidențialitate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваши данные для входа, баланс вердиктов, тариф и личная информация будут удалены, а ссылки, которыми вы делились, перестанут работать. Тексты вердиктов останутся у нас без вашего имени, как описано в Политике конфиденциальности."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvoje prihlasovacie a osobné údaje, kredity aj plán sa vymažú a tvoje odkazy na zdieľanie prestanú fungovať. Text verdiktov zostane uložený bez tvojho mena, ako to opisujú Zásady ochrany súkromia."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izbrišejo se tvoji podatki za prijavo, krediti, naročnina in osebni podatki, povezave za deljenje pa prenehajo delovati. Besedilo razsodb ostane shranjeno brez tvojega imena, kot je pojasnjeno v politiki zasebnosti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dina inloggningsuppgifter, dina krediter, ditt abonnemang och dina personuppgifter raderas, och dina delningslänkar slutar fungera. Texten i dina domar sparas kvar utan ditt namn, som beskrivs i integritetspolicyn."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்கள் உள்நுழைவு விவரங்கள், கிரெடிட்கள், பிளான், தனிப்பட்ட தரவு ஆகியவை நீக்கப்படும், உங்கள் பகிர்வு லிங்க்குகளும் வேலை செய்யாது. தனியுரிமைக் கொள்கையில் விளக்கியுள்ளபடி, தீர்ப்புகளின் உரை உங்கள் பெயர் இல்லாமல் சேமிப்பில் இருக்கும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీ సైన్ ఇన్ వివరాలు, క్రెడిట్లు, ప్లాన్, వ్యక్తిగత డేటా డిలీట్ అవుతాయి, మీ షేర్ లింక్‌లు పనిచేయడం ఆగిపోతాయి. తీర్పుల టెక్స్ట్‌ను మాత్రం, గోప్యతా విధానంలో చెప్పినట్టు, మీ పేరు లేకుండా ఉంచుతాం."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ข้อมูลการเข้าสู่ระบบ เครดิต แพ็กเกจ และข้อมูลส่วนตัวของคุณจะถูกลบ ลิงก์แชร์ของคุณจะใช้ไม่ได้อีกต่อไป ส่วนข้อความคำตัดสินจะยังเก็บไว้โดยไม่มีชื่อของคุณ ตามที่อธิบายไว้ในนโยบายความเป็นส่วนตัว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giriş bilgilerin, kredilerin, planın ve kişisel verilerin silinir; paylaşım bağlantıların da çalışmaz olur. Karar metinleri, Gizlilik Politikası'nda anlatıldığı gibi adın olmadan saklanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ми видалимо твої дані для входу, баланс вердиктів, тариф і особисту інформацію, а твої посилання для поширення перестануть працювати. Текст вердиктів залишиться збереженим без твого імені, як пояснено в Політиці конфіденційності."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کی سائن ان کی تفصیلات، کریڈٹس، پلان اور ذاتی ڈیٹا حذف ہو جائیں گے، اور آپ کے شیئر لنکس کام کرنا بند کر دیں گے۔ فیصلوں کا متن آپ کے نام کے بغیر محفوظ رہتا ہے، جیسا کہ رازداری کی پالیسی میں بتایا گیا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thông tin đăng nhập, lượt phán quyết, gói và dữ liệu cá nhân của bạn sẽ bị xóa, các liên kết chia sẻ của bạn cũng ngừng hoạt động. Nội dung phán quyết vẫn được lưu nhưng không kèm tên bạn, như đã nêu trong Chính sách quyền riêng tư."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的登录信息、剩余次数、套餐和个人数据都会被删除，分享链接也会失效。裁决内容会去掉你的名字后继续保存，详见《隐私政策》。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的登入資料、額度、方案和個人資料都會刪除，分享連結也會失效。判決內容會拿掉你的名字後繼續保存，詳見隱私權政策。"
          }
        }
      }
    },
