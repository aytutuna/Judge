        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "జడ్జీలు ఏదైనా మిస్ అయ్యారా? జోడించండి, వాళ్లు మళ్లీ తీర్పు చెబుతారు. మొదటి తీర్పు రికార్డులో ఉంటుంది."
          }
