        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "צריך להתחבר כדי לקבל פסק דין. בחשבון חדש, פסק הדין הראשון עלינו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ैसला पाने के लिए साइन इन करें। नए अकाउंट का पहला फ़ैसला मुफ़्त है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
