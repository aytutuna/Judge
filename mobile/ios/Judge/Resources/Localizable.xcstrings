        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "அந்தத் தகவலுடன் மறுதீர்ப்பு செய்ய நடுவர்கள் மறுத்துவிட்டார்கள். உங்கள் கிரெடிட் திரும்ப வந்துவிட்டது."
          }
