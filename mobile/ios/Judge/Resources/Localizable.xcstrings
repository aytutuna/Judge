    "app.appeal.intro" : {
      "comment" : "Generated by mobile/shared/strings/export-strings.ts from lib/i18n.ts. Do not edit.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل فات القضاة شيء؟ أضفه وسيحكمون من جديد. ويبقى الحكم الأول في السجل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বিচারকেরা কিছু মিস করেছেন? সেটা যোগ করুন, তাঁরা আবার রায় দেবেন। প্রথম রায়টাও রেকর্ডে থেকে যাবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els jutges s'han deixat alguna cosa? Afegeix-la i tornaran a jutjar. El primer veredicte queda registrat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soudcům něco uniklo? Doplň to a rozhodnou znovu. Původní verdikt zůstane v historii."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Har dommerne overset noget? Tilføj det, så dømmer de igen. Den første dom bliver gemt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haben die Richter etwas übersehen? Ergänze es, und sie urteilen neu. Das erste Urteil bleibt erhalten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κάτι ξέφυγε από τους κριτές; Πρόσθεσέ το και θα κρίνουν ξανά. Η πρώτη απόφαση μένει καταγεγραμμένη."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Something the judges missed? Add it and they rule again. The first ruling stays on record."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Se les pasó algo a los jueces? Añádelo y volverán a decidir. La primera decisión queda registrada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jäikö tuomareilta jotain huomaamatta? Lisää se, niin he ratkaisevat uudelleen. Ensimmäinen tuomio jää näkyviin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les juges ont raté quelque chose ? Ajoute-le et ils tranchent à nouveau. Le premier verdict reste dans l’historique."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "જજ કંઈ ચૂકી ગયા? એ ઉમેરો અને તેઓ ફરી ફેંસલો કરશે. પહેલો ચુકાદો રેકૉર્ડમાં રહે છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השופטים פספסו משהו? אפשר להוסיף אותו, והם יכריעו מחדש. ההכרעה הראשונה נשמרת בהיסטוריה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जजों से कुछ छूट गया? उसे जोड़ें और जज दोबारा फ़ैसला करेंगे। पहला फ़ैसला भी रिकॉर्ड में रहेगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suci su nešto propustili? Dodaj to i ponovno će presuditi. Prva presuda ostaje zabilježena."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valami elkerülte a bírák figyelmét? Add hozzá, és újra döntenek. Az első ítélet is megmarad."
