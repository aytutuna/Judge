    "app.example.spoiler.b" : {
      "comment" : "Generated by mobile/shared/strings/export-strings.ts from lib/i18n.ts. Do not edit.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عُرضت قبل ثلاثة أسابيع، وقلت إنك أنهيتها. لا أستطيع أن أتابع أين وصل كل واحد."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ওটা তিন সপ্তাহ আগে বেরিয়েছে, আর তুমিই বলেছিলে দেখা শেষ। কে কোন পর্বে আছে, সবার হিসাব রাখা আমার পক্ষে সম্ভব না।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Va sortir fa tres setmanes i em vas dir que ja l'havies acabat. No puc estar pendent de per on va cadascú."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyšlo to před třemi týdny a říkala jsi, že to máš dokoukané. Nemůžu hlídat, kdo je u kterého dílu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den kom for tre uger siden, og du sagde, at du havde set den færdig. Jeg kan ikke holde styr på, hvor langt alle er."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Folge kam vor drei Wochen raus, und du hast gesagt, du bist durch. Ich kann mir nicht merken, wer gerade bei welcher Folge ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Βγήκε πριν από τρεις εβδομάδες και μου είχες πει ότι το τελείωσες. Δεν μπορώ να θυμάμαι πού έχει φτάσει ο καθένας."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It came out three weeks ago and you said you'd finished it. I can't keep track of where everyone is."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salió hace tres semanas y dijiste que ya habías terminado la serie. No puedo estar pendiente de por dónde va cada uno."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ilmestyi kolme viikkoa sitten, ja sanoit katsoneesi sen loppuun. En pysty pitämään kirjaa siitä, missä kohtaa kukin menee."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il est sorti il y a trois semaines et tu m’avais dit que tu l’avais fini. Je ne peux pas savoir où en est tout le monde."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "એ સિરીઝ ત્રણ અઠવાડિયાં પહેલાં આવી ગઈ હતી, અને તેં જ કહ્યું હતું કે તેં જોઈ લીધી છે. કોણ કયા એપિસોડ પર છે એનો હિસાબ હું ન રાખી શકું."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "זה יצא לפני שלושה שבועות, ואמרת שסיימת. אני לא יכול לזכור מי הגיע לאיזה פרק."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एपिसोड तीन हफ़्ते पहले आ गया था, और तुमने कहा था कि सीरीज़ ख़त्म कर ली है। मैं हर किसी का हिसाब नहीं रख सकता कि कौन कहाँ तक पहुँचा है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izašla je prije tri tjedna, a rekla si da si je već odgledala. Ne mogu pratiti dokle je tko stigao."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Három hete jött ki, és azt mondtad, már a végére értél. Nem tudom fejben tartani, ki hol tart."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Episodenya sudah keluar tiga minggu lalu dan kamu bilang sudah selesai nonton. Aku nggak bisa ingat semua orang sudah nonton sampai mana."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È uscita tre settimane fa e mi avevi detto di averla finita. Non posso sapere a che punto è ognuno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "配信されたのは3週間前だし、もう見終わったって言ってたじゃん。誰がどこまで見てるかなんて、いちいち覚えてられないよ。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಅದು ಬಂದು ಮೂರು ವಾರ ಆಯಿತು, ನೋಡಿ ಮುಗಿಸಿದೆ ಅಂತ ನೀನೇ ಹೇಳಿದ್ದೆ. ಯಾರು ಎಲ್ಲಿಯವರೆಗೆ ನೋಡಿದ್ದಾರೆ ಅಂತ ನೆನಪಿಟ್ಟುಕೊಳ್ಳಲು ನನಗೆ ಆಗುವುದಿಲ್ಲ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3주 전에 나온 거고, 다 봤다고 했잖아요. 다들 어디까지 봤는지 제가 어떻게 일일이 기억해요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "അത് ഇറങ്ങിയിട്ട് മൂന്നാഴ്ചയായി, കണ്ടുതീർത്തെന്ന് നിങ്ങൾ പറയുകയും ചെയ്തു. ഓരോരുത്തരും എവിടെവരെ കണ്ടെന്ന് ഓർത്തുവെക്കാൻ എനിക്ക് പറ്റില്ല."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिरीज तीन आठवड्यांपूर्वीच आली, आणि तू ती संपवली असे म्हणाली होतीस. कोण कुठपर्यंत पोहोचले आहे याचा हिशेब मी नाही ठेवू शकत."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Episod tu dah keluar tiga minggu lepas, dan awak kata awak dah habis tengok. Saya tak boleh nak ingat semua orang dah tengok sampai mana."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den kom ut for tre uker siden, og du sa at du var ferdig med den. Jeg kan ikke holde styr på hvor langt alle har kommet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die aflevering kwam drie weken geleden uit en je zei dat je de serie uit had. Ik kan niet bijhouden hoe ver iedereen is."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ସେଇଟା ତିନି ସପ୍ତାହ ଆଗରୁ ବାହାରିଛି, ଆଉ ତୁମେ କହିଥିଲ ଦେଖିସାରିଛ। କିଏ କେଉଁଠି ପହଞ୍ଚିଛି, ସବୁ ହିସାବ ମୁଁ ରଖିପାରିବି ନାହିଁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਉਹ ਤਿੰਨ ਹਫ਼ਤੇ ਪਹਿਲਾਂ ਆ ਗਿਆ ਸੀ ਅਤੇ ਤੁਸੀਂ ਕਿਹਾ ਸੀ ਕਿ ਤੁਸੀਂ ਪੂਰਾ ਦੇਖ ਲਿਆ ਹੈ। ਹੁਣ ਮੈਂ ਹਰ ਕਿਸੇ ਦਾ ਹਿਸਾਬ ਤਾਂ ਨਹੀਂ ਰੱਖ ਸਕਦਾ ਕਿ ਕੌਣ ਕਿੱਥੇ ਤੱਕ ਪਹੁੰਚਿਆ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyszedł trzy tygodnie temu, a ty mówiłaś, że już skończyłaś. Nie jestem w stanie śledzić, kto jest na którym odcinku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saiu faz três semanas e você disse que já tinha terminado. Não dá para eu ficar controlando em que episódio cada um está."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saiu há três semanas e tu disseste que já tinhas acabado. Não consigo saber em que episódio anda cada um."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A ieșit acum trei săptămâni și mi-ai zis că l-ai terminat. Nu pot să țin minte unde a ajuns fiecare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Серия вышла три недели назад, и ты говорила, что уже досмотрела. Не могу же я следить, кто на какой серии."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyšlo to pred tromi týždňami a hovorila si, že to máš dopozerané. Nemôžem predsa sledovať, kto má čo dopozerané."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serija je izšla pred tremi tedni, ti pa si rekla, da si jo že pogledala do konca. Ne morem si zapomniti, do kod je kdo prišel."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det kom ut för tre veckor sedan och du sa att du hade sett klart. Jag kan inte hålla koll på hur långt alla har kommit."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "அது வந்து மூன்று வாரம் ஆகிறது, நீயும் பார்த்து முடித்துவிட்டதாகச் சொன்னாய். யார் எந்த எபிசோட் வரை பார்த்திருக்கிறார்கள் என்று என்னால் கணக்கு வைத்துக்கொள்ள முடியாது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "అది వచ్చి మూడు వారాలైంది, మీరు చూసేశానని చెప్పారు. ఎవరు ఎక్కడిదాకా చూశారో నేను గుర్తుపెట్టుకోలేను."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มันออกมาตั้ง 3 อาทิตย์แล้ว แล้วก็บอกเองนี่ว่าดูจบแล้ว จะให้มานั่งจำว่าใครดูถึงตอนไหนก็ไม่ไหวหรอก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Üç hafta önce çıktı, sen de bitirdim demiştin. Herkesin hangi bölümde olduğunu takip edemem."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вона вийшла три тижні тому, і ти казала, що вже додивилася. Я не можу стежити, хто на якій серії."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سیریز تین ہفتے پہلے آئی تھی اور تم نے کہا تھا کہ تم ختم کر چکی ہو۔ میں ہر ایک کا حساب نہیں رکھ سکتا کہ کون کس قسط تک پہنچا ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phim ra ba tuần rồi, bạn còn bảo là xem xong rồi mà. Mình đâu nhớ nổi ai đang xem tới đâu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "都播了三个星期了，你自己也说看完了。谁看到哪一集，我哪记得过来。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "那集三週前就播了，而且你說你看完了。我哪記得每個人看到哪裡。"
          }
        }
      }
    },
