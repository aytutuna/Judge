    "mode.bothHint" : {
      "comment" : "Generated by mobile/shared/strings/export-strings.ts from lib/i18n.ts. Do not edit.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سنعطيك رابطًا خاصًا. يكتب الطرف الآخر روايته؛ ولا يرى أيٌّ منكما رواية الآخر حتى صدور الحكم."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আমরা আপনাকে একটা প্রাইভেট লিংক দেব। অন্যজন নিজের কথা লিখবেন; রায়ের আগে কেউ কারও লেখা দেখতে পাবেন না।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et donarem un enllaç privat. L'altra persona explica la seva versió; cap de les dues no veu la de l'altra fins al veredicte."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostaneš soukromý odkaz. Druhá strana napíše svůj pohled; ani jeden z vás neuvidí text toho druhého dřív než verdikt."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du får et privat link. Den anden fortæller sin side; ingen af jer ser den andens, før dommen falder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bekommst einen privaten Link. Die andere Person erzählt dort ihre Version; keiner von euch sieht die des anderen vor dem Urteil."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σου δίνουμε έναν ιδιωτικό σύνδεσμο. Η άλλη πλευρά γράφει τη δική της· κανείς από τους δυο σας δεν βλέπει τι έγραψε ο άλλος μέχρι την απόφαση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We'll give you a private link. They tell their side; neither of you sees the other's until the verdict."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te damos un enlace privado. La otra persona cuenta su versión; ninguno de los dos ve la del otro hasta el veredicto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat yksityisen linkin. Toinen kertoo oman puolensa; kumpikaan ei näe toisen tekstiä ennen tuomiota."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On te donne un lien privé. L’autre raconte sa version ; aucun de vous deux ne voit celle de l’autre avant le verdict."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "અમે તમને એક ખાનગી લિંક આપીશું. તેઓ પોતાની વાત કહેશે; ચુકાદા પહેલાં તમારામાંથી કોઈ બીજાની વાત નહીં જુએ."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "נכין בשבילך קישור פרטי. הצד השני מספר את שלו, ואף אחד מכם לא רואה מה השני כתב עד פסק הדין."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हम आपको एक निजी लिंक देंगे। दूसरा व्यक्ति अपनी बात लिखेगा; फ़ैसले तक कोई भी दूसरे का लिखा नहीं देख पाएगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dobit ćeš privatnu poveznicu. Druga osoba ispričat će svoju stranu; nitko ne vidi tuđi tekst do presude."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapsz egy privát linket. A másik fél leírja a saját verzióját; az ítéletig egyikőtök sem látja a másikét."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu dapat tautan pribadi. Dia menulis versinya; kalian tidak bisa melihat tulisan satu sama lain sampai putusan keluar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti diamo un link privato. L'altra persona racconta la sua versione; nessuno dei due vede quella dell'altro fino al verdetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "専用のリンクをお渡しします。相手は相手の言い分を書き、判定が出るまでお互いの内容は見えません。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಿಮಗೆ ಒಂದು ಖಾಸಗಿ ಲಿಂಕ್ ಕೊಡುತ್ತೇವೆ. ಅವರು ತಮ್ಮ ಕಡೆಯ ಮಾತು ಹೇಳುತ್ತಾರೆ; ತೀರ್ಪು ಬರುವವರೆಗೂ ನಿಮ್ಮಲ್ಲಿ ಯಾರಿಗೂ ಇನ್ನೊಬ್ಬರದು ಕಾಣುವುದಿಲ್ಲ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비공개 링크를 드려요. 상대방이 자기 입장을 쓰고, 판결이 나오기 전까지는 서로의 글을 볼 수 없어요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിങ്ങൾക്ക് ഒരു സ്വകാര്യ ലിങ്ക് തരും. അവർ അവരുടെ ഭാഗം പറയും; വിധി വരെ നിങ്ങളിൽ ആരും മറ്റേയാളുടേത് കാണില്ല."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुम्हाला एक खासगी लिंक मिळेल. ते आपली बाजू सांगतील; निकाल लागेपर्यंत दोघांनाही एकमेकांचे लिहिलेले दिसणार नाही."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kami beri anda pautan peribadi. Dia ceritakan versinya; anda berdua tidak akan nampak tulisan satu sama lain sehingga keputusan keluar."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du får en privat lenke. Den andre forteller sin side; ingen av dere ser den andres før dommen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je krijgt een privélink. De ander vertelt zelf zijn of haar kant; jullie zien elkaars verhaal pas bij de uitspraak."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆମେ ଆପଣଙ୍କୁ ଏକ ଗୋପନ ଲିଙ୍କ୍ ଦେବୁ। ସେ ନିଜ କଥା କହିବେ; ରାୟ ଆସିବା ଯାଏଁ ଆପଣ ଦୁହେଁ ପରସ୍ପରର କଥା ଦେଖିପାରିବେ ନାହିଁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਅਸੀਂ ਤੁਹਾਨੂੰ ਇੱਕ ਨਿੱਜੀ ਲਿੰਕ ਦੇਵਾਂਗੇ। ਉਹ ਆਪਣਾ ਪੱਖ ਦੱਸਣਗੇ; ਫ਼ੈਸਲੇ ਤੱਕ ਤੁਹਾਡੇ ਵਿੱਚੋਂ ਕੋਈ ਵੀ ਦੂਜੇ ਦਾ ਪੱਖ ਨਹੀਂ ਦੇਖ ਸਕਦਾ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostaniesz prywatny link. Druga strona opisze swoją wersję; przed werdyktem żadne z was nie zobaczy wersji drugiej osoby."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você recebe um link privado. A outra pessoa conta o lado dela; nenhum de vocês vê o texto do outro até o veredito."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damos-te um link privado. A outra pessoa conta o lado dela; nenhum de vocês vê o texto do outro até ao veredicto."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Îți dăm un link privat. Cealaltă persoană își spune varianta; niciunul dintre voi nu o vede pe a celuilalt până la verdict."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мы дадим вам личную ссылку. Другой человек расскажет свою версию; до вердикта никто из вас не увидит, что написал другой."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostaneš súkromný odkaz. Druhá strana napíše svoju verziu; ani jeden z vás neuvidí verziu toho druhého skôr ako verdikt."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dobiš zasebno povezavo. Druga oseba pove svojo plat; nihče od vaju ne vidi besedila drugega do razsodbe."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du får en privat länk. Den andra berättar sin sida; ingen av er ser den andras förrän domen är klar."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "உங்களுக்கு ஒரு தனிப்பட்ட லிங்க் தருவோம். மற்றவர் தன் தரப்பைச் சொல்வார்; தீர்ப்பு வரும் வரை ஒருவர் எழுதியதை மற்றவர் பார்க்க முடியாது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీకు ఒక ప్రైవేట్ లింక్ ఇస్తాం. వాళ్లు తమ వైపు కథ చెబుతారు; తీర్పు వచ్చేవరకు మీ ఇద్దరిలో ఎవరికీ అవతలివారిది కనిపించదు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณจะได้ลิงก์ส่วนตัวไปส่งให้อีกฝ่าย เขาเล่าฝั่งของเขา และจะไม่มีใครเห็นของอีกคนจนกว่าจะมีคำตัดสิน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sana özel bir bağlantı veriyoruz. O da kendi tarafını yazıyor; karar çıkana kadar kimse diğerinin yazdığını görmüyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ми дамо тобі приватне посилання. Інша сторона розповість свою версію; до вердикту ніхто з вас не бачить версії іншого."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہم آپ کو ایک نجی لنک دیں گے۔ وہ اپنی بات بتائیں گے؛ فیصلے تک آپ دونوں میں سے کوئی دوسرے کی بات نہیں دیکھ سکے گا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn sẽ nhận một liên kết riêng. Người kia kể phần của họ; hai người không thấy lời của nhau cho đến khi có phán quyết."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们会给你一个私密链接。对方讲自己的说法；裁决出来之前，你们都看不到对方写的内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我們會給你一個私人連結。對方寫下自己的說法；判決出來前，你們都看不到彼此寫的內容。"
          }
        }
      }
    },
