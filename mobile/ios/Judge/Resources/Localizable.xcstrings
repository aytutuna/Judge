        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Войдите, чтобы увидеть тариф и баланс вердиктов."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prihlás sa a uvidíš svoj plán a kredity."
          }
        },
