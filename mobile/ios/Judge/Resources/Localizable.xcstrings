    "app.example.seat.a" : {
      "comment" : "Generated by mobile/shared/strings/export-strings.ts from lib/i18n.ts. Do not edit.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مقعدي يميل إلى الخلف، لذلك أُميله. الرحلة ليلية والجميع يحاولون النوم."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আমার সিট হেলানো যায়, তাই হেলিয়েছি। রাতের ফ্লাইট, সবাই ঘুমানোর চেষ্টা করছে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El meu seient es reclina, així que el reclino. És un vol de nit i tothom intenta dormir."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moje sedadlo se dá sklopit, tak ho sklápím. Je to noční let a všichni se snaží spát."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit sæde kan lænes tilbage, så det gør jeg. Det er en natflyvning, og alle prøver at sove."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meine Lehne lässt sich zurückstellen, also stelle ich sie zurück. Es ist ein Nachtflug, und alle versuchen zu schlafen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η θέση μου γέρνει, άρα τη γέρνω. Είναι νυχτερινή πτήση και όλοι προσπαθούν να κοιμηθούν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "My seat reclines, so I'm reclining it. It's a night flight and everyone's trying to sleep."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mi asiento se reclina, así que lo reclino. Es un vuelo nocturno y todo el mundo está intentando dormir."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selkänojani kallistuu, joten kallistan sitä. On yölento, ja kaikki yrittävät nukkua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mon siège s’incline, donc je l’incline. C’est un vol de nuit et tout le monde essaie de dormir."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "મારી સીટ પાછળ નમે છે, તો હું નમાવું છું. રાતની ફ્લાઇટ છે અને બધા સૂવાનો પ્રયાસ કરે છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המושב שלי יורד אחורה, אז אני מורידה אותו. זו טיסת לילה וכולם מנסים לישון."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मेरी सीट पीछे झुकती है, तो मैं झुका रही हूँ। रात की फ़्लाइट है और सब सोने की कोशिश कर रहे हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Naslon se može spustiti, pa ga spuštam. Noćni je let i svi pokušavaju spavati."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az ülésem hátradönthető, úgyhogy hátradöntöm. Éjszakai járaton vagyunk, mindenki aludni próbál."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kursiku bisa direbahkan, jadi ya aku rebahkan. Ini penerbangan malam, semua orang juga mau tidur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il mio sedile si reclina, quindi lo reclino. È un volo notturno e tutti cercano di dormire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この席はリクライニングできるので、倒します。夜の便ですし、みんな寝ようとしているんです。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನನ್ನ ಸೀಟ್ ಹಿಂದಕ್ಕೆ ಬಾಗುತ್ತದೆ, ಅದಕ್ಕೇ ಬಾಗಿಸಿದ್ದೇನೆ. ಇದು ರಾತ್ರಿಯ ಫ್ಲೈಟ್, ಎಲ್ಲರೂ ನಿದ್ದೆ ಮಾಡಲು ನೋಡುತ್ತಿದ್ದಾರೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제 좌석은 뒤로 젖혀지니까 젖히는 거예요. 야간 비행이라 다들 자려고 하잖아요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "എന്റെ സീറ്റ് പിന്നോട്ട് ചായ്ക്കാവുന്നതാണ്, അതുകൊണ്ട് ഞാൻ ചായ്ക്കുന്നു. ഇത് രാത്രി ഫ്ലൈറ്റാണ്, എല്ലാവരും ഉറങ്ങാൻ നോക്കുകയാണ്."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "माझी सीट मागे जाते, म्हणून मी ती मागे करतेय. रात्रीची फ्लाइट आहे, सगळे झोपायचा प्रयत्न करत आहेत."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kerusi saya boleh direbahkan, jadi saya rebahkanlah. Ini penerbangan malam, semua orang nak tidur."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setet mitt kan lenes bakover, så det gjør jeg. Det er et nattfly, og alle prøver å sove."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mijn stoel kan naar achteren, dus dat doe ik ook. Het is een nachtvlucht en iedereen probeert te slapen."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ମୋ ସିଟ୍ ପଛକୁ ଢଳେ, ତେଣୁ ମୁଁ ଢଳାଉଛି। ରାତିର ଫ୍ଲାଇଟ୍, ସମସ୍ତେ ଶୋଇବାକୁ ଚେଷ୍ଟା କରୁଛନ୍ତି।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਮੇਰੀ ਸੀਟ ਪਿੱਛੇ ਹੁੰਦੀ ਹੈ, ਇਸ ਲਈ ਮੈਂ ਪਿੱਛੇ ਕੀਤੀ ਹੈ। ਰਾਤ ਦੀ ਫ਼ਲਾਈਟ ਹੈ ਅਤੇ ਸਾਰੇ ਸੌਣ ਦੀ ਕੋਸ਼ਿਸ਼ ਕਰ ਰਹੇ ਹਨ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mój fotel się odchyla, więc go odchylam. To nocny lot, wszyscy próbują spać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minha poltrona reclina, então eu vou reclinar. É um voo noturno e todo mundo está tentando dormir."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O meu assento reclina, por isso vou reclinar. É um voo noturno e está toda a gente a tentar dormir."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scaunul meu se lasă pe spate, așa că îl las. E zbor de noapte și toată lumea încearcă să doarmă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Моё кресло откидывается, вот я его и откидываю. Рейс ночной, все пытаются поспать."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moje sedadlo sa dá sklopiť, tak ho sklápam. Je to nočný let a všetci sa snažia spať."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moj sedež se da nagniti, zato ga nagnem. Nočni let je, vsi poskušajo spati."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitt säte går att fälla bakåt, så jag fäller det. Det är ett nattflyg och alla försöker sova."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "என் சீட் பின்னால் சாயும், அதனால் சாய்க்கிறேன். இது இரவு விமானம், எல்லோரும் தூங்கத்தான் பார்க்கிறார்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "నా సీటు వెనక్కి వాలుతుంది, అందుకే వాల్చుకున్నాను. ఇది నైట్ బస్సు, అందరూ నిద్రపోవాలని చూస్తున్నారు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เบาะมันเอนได้ ก็เลยเอน นี่ไฟลต์กลางคืน ทุกคนก็พยายามจะนอนกันทั้งนั้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koltuğum yatıyor, ben de yatırıyorum. Gece uçuşu, herkes uyumaya çalışıyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Моє крісло відкидається, от я його й відкидаю. Це нічний рейс, усі намагаються поспати."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سیٹ پیچھے جھکنے کے لیے ہی بنی ہے، تو میں اسے جھکا رہی ہوں۔ رات کی فلائٹ ہے اور سب سونے کی کوشش کر رہے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghế mình ngả được thì mình ngả. Chuyến bay đêm, ai cũng đang cố ngủ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我的座椅能往后放，我就放了。这是红眼航班，大家都想睡觉。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我的椅背可以往後倒，我就倒啊。這是夜間航班，大家都想睡覺。"
          }
        }
      }
    },
