        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilkoblingen ble brutt mens Judge var i bakgrunnen. Prøv igjen, og hold appen åpen til dommen kommer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De verbinding viel weg terwijl Judge op de achtergrond stond. Probeer het opnieuw en houd de app open tot de uitspraak binnen is."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Judge ବ୍ୟାକଗ୍ରାଉଣ୍ଡରେ ଥିବା ବେଳେ ସଂଯୋଗ କଟିଗଲା। ପୁଣି ଚେଷ୍ଟା କରନ୍ତୁ ଏବଂ ରାୟ ଆସିବା ଯାଏଁ ଆପ୍ ଖୋଲା ରଖନ୍ତୁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਜਦੋਂ Judge ਬੈਕਗ੍ਰਾਊਂਡ ਵਿੱਚ ਸੀ, ਕਨੈਕਸ਼ਨ ਟੁੱਟ ਗਿਆ। ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ ਅਤੇ ਫ਼ੈਸਲਾ ਆਉਣ ਤੱਕ ਐਪ ਖੁੱਲ੍ਹੀ ਰੱਖੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Połączenie zerwało się, gdy Judge działał w tle. Spróbuj ponownie i nie wychodź z aplikacji, dopóki nie przyjdzie werdykt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A conexão caiu enquanto o Judge estava em segundo plano. Tente de novo e deixe o app aberto até o veredito chegar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A ligação caiu enquanto o Judge estava em segundo plano. Tenta outra vez e mantém a app aberta até chegar o veredicto."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
