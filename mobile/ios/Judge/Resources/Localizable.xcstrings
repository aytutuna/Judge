        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಈ ಕೇಸ್ ಈಗ ನಿಮ್ಮ ಖಾತೆಯಲ್ಲಿದೆ. ಯಾವ ಸಾಧನದಲ್ಲಾದರೂ ನಿಮ್ಮ “ತೀರ್ಪುಗಳು” ಪುಟದಲ್ಲಿ ಇದು ಕಾಣುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이제 이 사건이 내 계정에 저장됐어요. 어느 기기에서든 ‘판결’ 페이지에서 볼 수 있어요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഈ കേസ് ഇപ്പോൾ നിങ്ങളുടെ അക്കൗണ്ടിലുണ്ട്. ഏത് ഉപകരണത്തിലും “വിധികൾ” പേജിൽ ഇത് കാണാം."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हे प्रकरण आता तुमच्या खात्यात आहे. ते प्रत्येक डिव्हाइसवर तुमच्या ‘निकाल’ पानावर दिसते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kes ini kini berada dalam akaun anda. Ia muncul di halaman Keputusan anda pada setiap peranti."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saken er nå lagret i kontoen din. Den vises på siden Dommene på alle enhetene dine."
