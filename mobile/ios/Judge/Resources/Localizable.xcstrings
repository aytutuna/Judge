    "factcheck.lead" : {
      "comment" : "Generated by mobile/shared/strings/export-strings.ts from lib/i18n.ts. Do not edit.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اطّلع القضاة على نتائج البحث هذه قبل الحكم. هي أدلة، وليست الحكم نفسه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "রায় দেওয়ার আগে বিচারকেরা এই সার্চ ফলাফলগুলো দেখেছেন। এগুলো প্রমাণ, রায় নিজে নয়।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els jutges han vist aquests resultats de cerca abans de decidir. Són proves, no el veredicte en si."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Soudci tyto výsledky hledání viděli, než rozhodli. Jsou to podklady, ne samotný verdikt."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dommerne så disse søgeresultater, før de dømte. De er bevismateriale, ikke selve dommen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Suchergebnisse lagen den Richtern vor dem Urteil vor. Sie sind Belege, nicht das Urteil selbst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι κριτές είδαν αυτά τα αποτελέσματα αναζήτησης πριν αποφασίσουν. Είναι στοιχεία, όχι η ίδια η απόφαση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The judges saw these search results before ruling. They're evidence, not the ruling itself."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los jueces vieron estos resultados de búsqueda antes de decidir. Son pruebas, no la decisión en sí."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuomarit näkivät nämä hakutulokset ennen ratkaisua. Ne ovat todisteita, eivät itse tuomio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les juges ont vu ces résultats de recherche avant de trancher. Ce sont des éléments de preuve, pas le verdict lui-même."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ચુકાદો આપતાં પહેલાં જજોએ આ સર્ચ પરિણામ જોયાં. એ પુરાવા છે, ચુકાદો નહીં."
          }
