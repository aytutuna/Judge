    "case.expiredBody" : {
      "comment" : "Generated by mobile/shared/strings/export-strings.ts from lib/i18n.ts. Do not edit.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يردّ أحد خلال 7 أيام، فعاد الحكم المحجوز إلى رصيدك. وما زال بإمكانك الحصول على حكم على روايتك وحدها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7 দিনে কেউ উত্তর দেননি, তাই আপনার ক্রেডিট ফেরত এসেছে। তবু শুধু আপনার বক্তব্যের ভিত্তিতে রায় নিতে পারেন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ningú no ha respost en 7 dies, així que t'hem tornat el crèdit. Encara pots obtenir un veredicte només amb la teva versió."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Za 7 dní nikdo neodpověděl, takže se ti kredit vrátil. Pořád můžeš dostat verdikt jen podle svého pohledu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen svarede inden for 7 dage, så du har fået din kredit tilbage. Du kan stadig få en dom på din side alene."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In 7 Tagen hat niemand geantwortet, also ist dein Credit wieder da. Du kannst trotzdem ein Urteil nur über deine Seite bekommen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κανείς δεν απάντησε σε 7 μέρες, οπότε η δεσμευμένη απόφαση σου επιστράφηκε. Μπορείς ακόμα να ζητήσεις απόφαση μόνο με τη δική σου πλευρά."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nobody answered in 7 days, so your credit is back. You can still get a verdict on your side alone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadie respondió en 7 días, así que recuperaste tu crédito. Aún puedes obtener un veredicto solo con tu versión."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kukaan ei vastannut 7 päivässä, joten tuomio palautettiin saldoosi. Voit silti saada tuomion pelkän oman puolesi perusteella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personne n’a répondu en 7 jours, ton crédit t’a donc été rendu. Tu peux quand même obtenir un verdict sur ta seule version."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7 દિવસમાં કોઈએ જવાબ ન આપ્યો, એટલે તમારી ક્રેડિટ પાછી આવી ગઈ. છતાં તમે ફક્ત તમારી બાજુ પરથી ચુકાદો લઈ શકો છો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אף אחד לא ענה תוך 7 ימים, אז הקרדיט חזר לחשבון. עדיין אפשר לקבל פסק דין רק לפי הצד שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7 दिन में किसी ने जवाब नहीं दिया, इसलिए आपका क्रेडिट वापस आ गया है। आप अब भी सिर्फ़ अपनी बात पर फ़ैसला करवा सकते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nitko nije odgovorio u roku od 7 dana, pa ti je kredit vraćen. I dalje možeš dobiti presudu samo na temelju svoje strane."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7 napig senki sem válaszolt, ezért visszakaptad a kreditedet. Ítéletet a saját verziód alapján továbbra is kérhetsz."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak ada yang menjawab dalam 7 hari, jadi kreditmu sudah kembali. Kamu tetap bisa minta putusan dari versimu saja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuno ha risposto in 7 giorni, quindi il tuo credito è tornato. Puoi comunque avere un verdetto solo sulla tua versione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7日間返事がなかったので、クレジットは戻りました。あなたの言い分だけで判定を受けることもできます。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7 ದಿನಗಳಲ್ಲಿ ಯಾರೂ ಉತ್ತರಿಸಲಿಲ್ಲ, ಹಾಗಾಗಿ ನಿಮ್ಮ ಕ್ರೆಡಿಟ್ ವಾಪಸ್ ಬಂದಿದೆ. ನಿಮ್ಮ ಕಡೆಯ ಮಾತಿನ ಮೇಲೆಯೇ ಈಗಲೂ ತೀರ್ಪು ಪಡೆಯಬಹುದು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7일 동안 아무도 답하지 않아서 크레딧을 돌려 드렸어요. 그래도 내 입장만으로 판결을 받을 수 있어요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7 ദിവസത്തിനുള്ളിൽ ആരും മറുപടി നൽകിയില്ല, അതുകൊണ്ട് നിങ്ങളുടെ ക്രെഡിറ്റ് തിരികെ കിട്ടി. നിങ്ങളുടെ ഭാഗം മാത്രം വെച്ച് ഇപ്പോഴും വിധി നേടാം."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7 दिवसांत कोणी उत्तर दिले नाही, म्हणून तुमचे क्रेडिट परत आले. तरीही फक्त तुमच्या बाजूवर निकाल घेऊ शकता."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiada jawapan dalam 7 hari, jadi kredit anda sudah dikembalikan. Anda masih boleh dapatkan keputusan berdasarkan versi anda sahaja."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen svarte på 7 dager, så du har fått kreditten tilbake. Du kan fortsatt få en dom bare på din side."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niemand antwoordde binnen 7 dagen, dus je credit is terug. Je kunt nog steeds een uitspraak krijgen op alleen jouw kant."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7 ଦିନରେ କେହି ଉତ୍ତର ଦେଲେ ନାହିଁ, ତେଣୁ ଆପଣଙ୍କ କ୍ରେଡିଟ୍ ଫେରିଆସିଛି। ତଥାପି କେବଳ ଆପଣଙ୍କ କଥା ଆଧାରରେ ରାୟ ନେଇପାରିବେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7 ਦਿਨਾਂ ਵਿੱਚ ਕੋਈ ਜਵਾਬ ਨਹੀਂ ਆਇਆ, ਇਸ ਲਈ ਤੁਹਾਡਾ ਕ੍ਰੈਡਿਟ ਵਾਪਸ ਆ ਗਿਆ ਹੈ। ਤੁਸੀਂ ਹਾਲੇ ਵੀ ਸਿਰਫ਼ ਆਪਣੇ ਪੱਖ ’ਤੇ ਫ਼ੈਸਲਾ ਲੈ ਸਕਦੇ ਹੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nikt nie odpowiedział przez 7 dni, więc werdykt wrócił do twojej puli. Nadal możesz dostać werdykt tylko na podstawie swojej wersji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguém respondeu em 7 dias, então seu crédito voltou. Você ainda pode receber um veredito só com o seu lado."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguém respondeu em 7 dias, por isso o teu crédito foi devolvido. Ainda podes obter um veredicto só com o teu lado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N-a răspuns nimeni în 7 zile, așa că ți-ai primit creditul înapoi. Poți primi totuși un verdict doar pe partea ta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За 7 дней никто не ответил, поэтому вердикт вернулся на баланс. Вы всё ещё можете получить вердикт только по своей версии."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nikto neodpovedal do 7 dní, takže kredit sa ti vrátil. Stále môžeš získať verdikt len podľa svojej verzie."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V 7 dneh ni nihče odgovoril, zato ti je kredit vrnjen. Še vedno lahko dobiš razsodbo samo na podlagi svoje plati."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen svarade inom 7 dagar, så du har fått tillbaka krediten. Du kan ändå få en dom på bara din sida."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7 நாட்களில் யாரும் பதில் அளிக்கவில்லை, அதனால் உங்கள் கிரெடிட் திரும்ப வந்துவிட்டது. உங்கள் தரப்பை மட்டும் வைத்து இப்போதும் தீர்ப்பு பெறலாம்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7 రోజుల్లో ఎవరూ జవాబివ్వలేదు, అందుకే మీ క్రెడిట్ తిరిగి వచ్చింది. మీ వైపు కథ మీదే ఇప్పటికీ తీర్పు తీసుకోవచ్చు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่มีใครตอบภายใน 7 วัน คุณจึงได้เครดิตคืน แต่ยังขอคำตัดสินจากฝั่งของคุณอย่างเดียวได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7 gün içinde kimse cevap vermedi, kredin geri döndü. Yine de sadece kendi tarafına göre karar alabilirsin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За 7 днів ніхто не відповів, тож вердикт повернуто на баланс. Ти все ще можеш отримати вердикт лише за своєю версією."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7 دن میں کسی نے جواب نہیں دیا، اس لیے آپ کا کریڈٹ واپس آ گیا ہے۔ آپ اب بھی صرف اپنی بات پر فیصلہ لے سکتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không ai trả lời trong 7 ngày nên lượt của bạn đã được hoàn lại. Bạn vẫn có thể nhận phán quyết chỉ dựa trên lời kể của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7 天内没人回复，次数已退还给你。你仍然可以只凭自己的说法获取裁决。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7 天內沒人回覆，額度已退還給你。你還是可以只用你的說法取得判決。"
          }
        }
      }
    },
