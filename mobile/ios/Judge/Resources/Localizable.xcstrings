        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଏଥର AI ଏଥିରୁ ଦୂରେଇ ରହିଲା। ମିଛ ରାୟ ଦେଖାଇବା ଅପେକ୍ଷା କିଛି ନ ଦେଖାଇବା ଭଲ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਇਸ ਵਾਰ AI ਨੇ ਹੱਥ ਖਿੱਚ ਲਿਆ। ਨਕਲੀ ਫ਼ੈਸਲਾ ਦਿਖਾਉਣ ਨਾਲੋਂ ਅਸੀਂ ਕੁਝ ਨਾ ਦਿਖਾਉਣਾ ਬਿਹਤਰ ਸਮਝਦੇ ਹਾਂ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
