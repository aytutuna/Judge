        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce lien d’invitation ne fonctionne pas. Il a peut-être été désactivé, ou il est incomplet."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આ આમંત્રણ લિંક ચાલતી નથી. કદાચ બંધ કરાઈ છે, અથવા એનો કોઈ ભાગ ખૂટે છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "קישור ההזמנה לא עובד. אולי הוא בוטל, או שחסר בו חלק."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह न्योता लिंक काम नहीं कर रहा। हो सकता है उसे बंद कर दिया गया हो, या उसका कोई हिस्सा छूट गया हो।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ova poveznica poziva ne radi. Možda je ugašena ili joj nedostaje dio."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez a meghívólink nem működik. Lehet, hogy kikapcsolták, vagy hiányzik belőle egy rész."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tautan undangan ini tidak berfungsi. Mungkin sudah dimatikan, atau ada bagian yang hilang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo link d'invito non funziona. Forse è stato disattivato, o ne manca un pezzo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この招待リンクは使えません。無効にされたか、リンクの一部が欠けている可能性があります。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಈ ಆಹ್ವಾನ ಲಿಂಕ್ ಕೆಲಸ ಮಾಡುತ್ತಿಲ್ಲ. ಅದನ್ನು ಆಫ್ ಮಾಡಿರಬಹುದು, ಅಥವಾ ಅದರ ಒಂದು ಭಾಗ ಕಾಣೆಯಾಗಿರಬಹುದು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 초대 링크는 열리지 않아요. 사용이 중지됐거나 링크 일부가 빠졌을 수 있어요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഈ ക്ഷണ ലിങ്ക് പ്രവർത്തിക്കുന്നില്ല. അത് ഓഫാക്കിയതാകാം, അല്ലെങ്കിൽ അതിന്റെ ഒരു ഭാഗം വിട്ടുപോയതാകാം."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ही निमंत्रण लिंक चालत नाही. ती बंद केली असेल, किंवा तिचा काही भाग गायब असेल."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pautan jemputan ini tidak berfungsi. Mungkin ia sudah dimatikan, atau sebahagiannya hilang."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denne invitasjonslenken virker ikke. Den kan være slått av, eller en del av den mangler."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze uitnodigingslink werkt niet. Misschien is hij uitgezet, of ontbreekt er een stuk."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଏହି ନିମନ୍ତ୍ରଣ ଲିଙ୍କ୍ କାମ କରୁନାହିଁ। ହୁଏତ ବନ୍ଦ କରାଯାଇଛି, ନହେଲେ ଏହାର କିଛି ଅଂଶ ନାହିଁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਇਹ ਸੱਦਾ ਲਿੰਕ ਕੰਮ ਨਹੀਂ ਕਰਦਾ। ਸ਼ਾਇਦ ਇਹ ਬੰਦ ਕਰ ਦਿੱਤਾ ਗਿਆ ਹੈ, ਜਾਂ ਇਸ ਦਾ ਕੁਝ ਹਿੱਸਾ ਗੁੰਮ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten link z zaproszeniem nie działa. Mógł zostać wyłączony albo brakuje jego części."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este link de convite não funciona. Ele pode ter sido desativado, ou está faltando uma parte."
