    "evidence.previewNote" : {
      "comment" : "Generated by mobile/shared/strings/export-strings.ts from lib/i18n.ts. Do not edit.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا يظهر لك وحدك. تُخفى الأسماء قبل أن يقرأه القضاة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এটা শুধু আপনিই দেখছেন। বিচারকেরা পড়ার আগে নামগুলো লুকানো হয়।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Això només ho veus tu. Els noms s'amaguen abans que ho llegeixin els jutges."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vidíš to jen ty. Než to soudci přečtou, jména se skryjí."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er kun dig, der ser det her. Navne bliver skjult, før dommerne læser det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur du siehst das. Bevor die Richter es lesen, werden die Namen verborgen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό το βλέπεις μόνο εσύ. Τα ονόματα κρύβονται πριν το διαβάσουν οι κριτές."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only you see this. Names are hidden before the judges read it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo tú ves esto. Los nombres se ocultan antes de que lo lean los jueces."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vain sinä näet tämän. Nimet piilotetaan ennen kuin tuomarit lukevat sen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceci n’est visible que par toi. Les noms sont masqués avant que les juges le lisent."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આ ફક્ત તમે જુઓ છો. જજ વાંચે એ પહેલાં નામ છુપાવાય છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "זה מוצג רק לך. השמות מוסתרים לפני שהשופטים קוראים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह सिर्फ़ आपको दिखता है। जजों के पढ़ने से पहले नाम छिपा दिए जाते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovo vidiš samo ti. Imena se skrivaju prije nego što suci pročitaju tekst."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezt csak te látod. A neveket elrejtjük, mielőtt a bírák elolvassák."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya kamu yang bisa melihat ini. Nama disembunyikan sebelum hakim membacanya."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo vedi solo tu. I nomi vengono nascosti prima che lo leggano i giudici."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これはあなたにしか見えません。審査員が読む前に名前は隠されます。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಇದು ನಿಮಗೆ ಮಾತ್ರ ಕಾಣುತ್ತದೆ. ತೀರ್ಪುಗಾರರು ಓದುವ ಮೊದಲೇ ಹೆಸರುಗಳನ್ನು ಮರೆಮಾಡಲಾಗುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나만 볼 수 있어요. 판사들이 읽기 전에 이름은 가려져요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഇത് നിങ്ങൾക്ക് മാത്രമേ കാണാനാകൂ. ജഡ്ജിമാർ വായിക്കും മുമ്പ് പേരുകൾ മറയ്ക്കും."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हे फक्त तुम्हाला दिसते. परीक्षक वाचण्याआधी नावे लपवली जातात."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya anda yang nampak ini. Nama disembunyikan sebelum hakim membacanya."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bare du ser dette. Navn skjules før dommerne leser det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen jij ziet dit. Namen worden verborgen voordat de rechters het lezen."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଏହା କେବଳ ଆପଣ ଦେଖୁଛନ୍ତି। ବିଚାରକମାନେ ପଢ଼ିବା ଆଗରୁ ନାମ ଲୁଚାଯାଏ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਇਹ ਸਿਰਫ਼ ਤੁਸੀਂ ਦੇਖ ਸਕਦੇ ਹੋ। ਜੱਜਾਂ ਦੇ ਪੜ੍ਹਨ ਤੋਂ ਪਹਿਲਾਂ ਨਾਂ ਲੁਕਾ ਦਿੱਤੇ ਜਾਂਦੇ ਹਨ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widzisz to tylko ty. Imiona są ukrywane, zanim przeczytają to sędziowie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só você vê isto. Os nomes são escondidos antes de os juízes lerem."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só tu vês isto. Os nomes são escondidos antes de os juízes lerem."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doar tu vezi asta. Numele sunt ascunse înainte să citească judecătorii."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это видите только вы. Прежде чем судьи это прочтут, имена будут скрыты."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vidíš to len ty. Mená sa skryjú skôr, než to sudcovia prečítajú."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To vidiš samo ti. Imena so skrita, preden to preberejo sodniki."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bara du ser det här. Namnen döljs innan domarna läser det."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இது உங்களுக்கு மட்டுமே தெரியும். நடுவர்கள் படிக்கும் முன் பெயர்கள் மறைக்கப்படும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఇది మీకు మాత్రమే కనిపిస్తుంది. జడ్జీలు చదివే ముందే పేర్లు దాచేస్తాం."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "มีแค่คุณที่เห็นส่วนนี้ ชื่อจะถูกซ่อนก่อนที่กรรมการจะอ่าน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunu sadece sen görüyorsun. Yargıçlar okumadan önce isimler gizlenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Це бачиш лише ти. Перш ніж судді це прочитають, імена буде приховано."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہ صرف آپ کو نظر آتا ہے۔ ججوں کے پڑھنے سے پہلے نام چھپا دیے جاتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ bạn thấy phần này. Tên sẽ được ẩn trước khi giám khảo đọc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有你能看到。评委读取之前，名字会被隐藏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有你看得到這裡。評審讀取前，名字都會先隱藏。"
          }
        }
      }
    },
