        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверка в интернете в этот раз не завершилась, поэтому судьи решали без неё."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overovanie na webe sa tentoraz nedokončilo, takže sudcovia rozhodli bez neho."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spletno preverjanje se tokrat ni končalo, zato so sodniki razsodili brez njega."
