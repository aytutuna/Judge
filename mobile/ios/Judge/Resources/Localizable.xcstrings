    "case.invite.shareText" : {
      "comment" : "Generated by mobile/shared/strings/export-strings.ts from lib/i18n.ts. Do not edit.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "طلبت من Judge أن يحسم خلافنا. اكتب روايتك هنا. لن أراها قبل صدور الحكم."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আমাদের তর্কের ফয়সালা করতে Judge-কে বলেছি। নিজের কথাটা এখানে লেখা যাবে। রায়ের আগে আমি সেটা দেখতে পাব না।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He demanat a Judge que resolgui la nostra discussió. Explica-hi la teva versió. No la veuré fins al veredicte."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nechávám náš spor rozsoudit v Judge. Napiš tady, jak to vidíš ty. Uvidím to až s verdiktem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeg har bedt Judge om at afgøre vores diskussion. Fortæl din side her. Jeg ser den ikke, før dommen falder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich habe Judge gebeten, unseren Streit zu klären. Erzähl hier deine Version. Ich sehe sie erst mit dem Urteil."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ζήτησα από το Judge να λύσει τη διαφωνία μας. Γράψε εδώ τη δική σου πλευρά. Δεν θα τη δω πριν βγει η απόφαση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I asked Judge to settle our argument. Tell your side here. I won't see it until the verdict."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "He pedido a Judge que resuelva nuestra discusión. Cuenta tu versión aquí. No la veré hasta el veredicto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pyysin Judgea ratkaisemaan kiistamme. Kerro oma puolesi täällä. En näe sitä ennen tuomiota."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "J’ai demandé à Judge de trancher notre débat. Donne ta version ici. Je ne la verrai pas avant le verdict."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "મેં આપણા વિવાદનો ફેંસલો Judgeને સોંપ્યો છે. તમારી વાત અહીં લખો. ચુકાદા પહેલાં હું એ નહીં જોઉં."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ביקשתי מ-Judge להכריע בוויכוח שלנו. כאן אפשר לספר את הצד שלך. לא אראה אותו עד פסק הדין."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मैंने Judge से हमारी बहस सुलझाने को कहा है। अपनी बात यहाँ लिखो। फ़ैसला आने तक तुम्हारा लिखा मुझे नहीं दिखेगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neka Judge riješi našu raspravu. Ovdje ispričaj svoju stranu. Neću je vidjeti do presude."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Megkértem a Judge-ot, hogy döntse el a vitánkat. Itt elmondhatod a te verziódat. Az ítéletig nem fogom látni."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aku minta Judge menuntaskan perdebatan kita. Tulis versimu di sini. Aku tidak bisa melihatnya sampai putusan keluar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ho chiesto a Judge di risolvere la nostra discussione. Racconta qui la tua versione. Non la vedrò fino al verdetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "私たちの言い合い、Judgeに白黒つけてもらうことにしたよ。ここにそっちの言い分を書いてね。判定が出るまで私には見えないから。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಮ್ಮ ವಾದವನ್ನು ಬಗೆಹರಿಸಲು Judge ಅನ್ನು ಕೇಳಿದ್ದೇನೆ. ನಿಮ್ಮ ಕಡೆಯ ಮಾತನ್ನು ಇಲ್ಲಿ ಹೇಳಿ. ತೀರ್ಪು ಬರುವವರೆಗೂ ನನಗೆ ಅದು ಕಾಣುವುದಿಲ್ಲ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Judge에 우리 논쟁 판결을 맡겼어요. 여기에 입장을 써 주세요. 판결이 나오기 전까지는 저도 볼 수 없어요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നമ്മുടെ തർക്കം തീർക്കാൻ ഞാൻ Judge-നെ ഏൽപ്പിച്ചു. നിങ്ങളുടെ ഭാഗം ഇവിടെ പറയൂ. വിധി വരുന്നതുവരെ ഞാൻ അത് കാണില്ല."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपला वाद सोडवायला मी Judge ला सांगितले आहे. तुमची बाजू इथे सांगा. निकाल लागेपर्यंत मला ती दिसणार नाही."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saya minta Judge selesaikan pertikaian kita. Ceritakan versi awak di sini. Saya tak akan nampak sampai keputusan keluar."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeg har bedt Judge avgjøre diskusjonen vår. Fortell din side her. Jeg ser den ikke før dommen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ik heb Judge gevraagd onze discussie te beslechten. Vertel hier jouw kant. Ik zie die pas bij de uitspraak."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆମ ଝଗଡ଼ା ମେଣ୍ଟାଇବାକୁ Judgeକୁ କହିଛି। ତୁମ କଥା ଏଠାରେ ଲେଖ। ରାୟ ଆସିବା ଯାଏଁ ମୁଁ ତାହା ଦେଖିପାରିବି ନାହିଁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਮੈਂ Judge ਨੂੰ ਸਾਡੀ ਬਹਿਸ ਦਾ ਨਿਬੇੜਾ ਕਰਨ ਲਈ ਕਿਹਾ ਹੈ। ਆਪਣਾ ਪੱਖ ਇੱਥੇ ਦੱਸੋ। ਫ਼ੈਸਲੇ ਤੱਕ ਇਹ ਮੈਨੂੰ ਨਹੀਂ ਦਿਖੇਗਾ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Judge ma rozstrzygnąć nasz spór. Opisz tu swoją wersję. Nie zobaczę jej przed werdyktem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pedi para o Judge resolver a nossa discussão. Conte o seu lado aqui. Só vou ver depois do veredito."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pedi ao Judge para tirar a nossa teima. Conta aqui o teu lado. Só o vou ver depois do veredicto."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am cerut un verdict pe Judge pentru disputa noastră. Spune-ți varianta aici. N-o s-o văd până la verdict."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пусть наш спор рассудит Judge. Свою версию можно рассказать по ссылке — до вердикта я её не увижу."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Náš spor rozsúdi Judge. Tu napíš svoju verziu. Uvidím ju až pri verdikte."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najin prepir naj razsodi Judge. Tukaj povej svojo plat – do razsodbe je ne morem videti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jag har bett Judge avgöra vårt bråk. Berätta din sida här. Jag ser den inte förrän domen är klar."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நம் வாக்குவாதத்தைத் தீர்க்க Judge-இடம் கேட்டிருக்கிறேன். உங்கள் தரப்பை இங்கே சொல்லுங்கள். தீர்ப்பு வரும் வரை நான் அதைப் பார்க்க மாட்டேன்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మన గొడవను తేల్చమని Judgeని అడిగాను. మీ వైపు కథ ఇక్కడ చెప్పండి. తీర్పు వచ్చేవరకు అది నాకు కనిపించదు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เราให้ Judge ช่วยตัดสินเรื่องที่เถียงกันอยู่ มาเล่าฝั่งของตัวเองตรงนี้ได้เลย เขียนอะไรไปเราก็ไม่เห็นจนกว่าจะมีคำตัดสิน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tartışmamızı Judge'a sordum. Kendi tarafını buraya yaz. Karar çıkana kadar ben göremeyeceğim."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Хочу, щоб Judge розсудив нашу суперечку. Розкажи свою версію тут. Я не побачу її до вердикту."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ہماری بحث کا فیصلہ میں نے Judge پر چھوڑ دیا ہے۔ اپنی بات یہاں بتائیں؛ فیصلے سے پہلے یہ مجھے نظر نہیں آئے گی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mình đã nhờ Judge phân xử vụ cãi nhau của tụi mình. Kể phần của bạn ở đây nhé. Mình sẽ không đọc được cho đến khi có phán quyết."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我请 Judge 来给咱俩评评理。你在这里说说你那边的情况，裁决出来之前我看不到。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我請 Judge 幫我們評評理。在這裡寫下你的說法，判決出來之前我看不到。"
          }
        }
      }
    },
    "case.judgeExpired.confirm" : {
      "comment" : "Generated by mobile/shared/strings/export-strings.ts from lib/i18n.ts. Do not edit.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل تريد حكمًا على روايتك وحدها؟ سيستهلك هذا حكمًا واحدًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শুধু আপনার বক্তব্যের ভিত্তিতে রায় চান? এতে 1টি রায় খরচ হবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vols un veredicte només amb la teva versió? Gastarà 1 veredicte."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chceš verdikt jen podle svého pohledu? Spotřebuje to 1 verdikt."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vil du have en dom på din side alene? Det bruger 1 dom."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Urteil nur über deine Seite holen? Das kostet 1 Urteil."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Θέλεις απόφαση μόνο με τη δική σου πλευρά; Χρεώνεται 1 απόφαση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get a verdict on your side alone? This uses 1 verdict."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Quieres un veredicto solo con tu versión? Esto usa 1 veredicto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haluatko tuomion pelkän oman puolesi perusteella? Tämä käyttää 1 tuomion."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obtenir un verdict sur ta seule version ? Ça utilise 1 verdict."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ફક્ત તમારી બાજુ પરથી ચુકાદો લેવો છે? આમાં 1 ચુકાદો વપરાશે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לקבל פסק דין רק לפי הצד שלך? זה עולה פסק דין אחד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
