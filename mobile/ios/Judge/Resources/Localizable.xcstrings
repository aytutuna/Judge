        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перш ніж судді щось прочитають, імена замінюються на Сторону A і Сторону B. Акаунт не потрібен."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ججوں کے کچھ بھی پڑھنے سے پہلے ناموں کی جگہ فریق A اور فریق B لکھ دیا جاتا ہے۔ آپ کو اکاؤنٹ کی ضرورت نہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tên được thay bằng Bên A và Bên B trước khi giám khảo đọc bất cứ điều gì. Bạn không cần tài khoản."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "评委读到任何内容之前，名字都会被换成当事人A和当事人B。你不需要账号。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "評審讀取任何內容前，名字都會先換成當事人A和當事人B。你不需要帳號。"
          }
        }
      }
