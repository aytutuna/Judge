        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऑर्डर, ऑर्डर! फ़िलहाल आपकी सीमा पूरी हो गई है। %1$@ बाद फिर कोशिश करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Red u sudnici! Zasad je dosta. Pokušaj ponovno za %1$@."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csendet kérek! Egyelőre elérted a korlátot. Próbáld újra %1$@ múlva."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harap tenang di ruang sidang! Kamu sudah mencapai batas untuk sekarang. Coba lagi %1$@ lagi."
