    "respond.remove.confirm" : {
      "comment" : "Generated by mobile/shared/strings/export-strings.ts from lib/i18n.ts. Do not edit.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل تريد حذف نصك الأصلي واسم العرض الخاص بك؟ ستتوقف روابط مشاركة القضية عن العمل (المعاينات المنشورة مسبقًا في المحادثات قد تظل ظاهرة حتى تحدّثها تلك التطبيقات). لا يمكن التراجع عن ذلك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার মূল লেখা আর প্রদর্শিত নাম সরিয়ে ফেলবেন? মামলার শেয়ার লিংক কাজ করা বন্ধ করবে (চ্যাটে আগেই পোস্ট হওয়া প্রিভিউ সেই অ্যাপগুলো রিফ্রেশ না করা পর্যন্ত দেখা যেতে পারে)। এটা আর ফেরানো যাবে না।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vols eliminar el teu text original i el teu nom visible? Els enllaços per compartir del cas deixaran de funcionar (les previsualitzacions ja publicades en xats poden continuar apareixent fins que aquestes apps les actualitzin). No es pot desfer."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odstranit tvůj původní text a zobrazované jméno? Sdílené odkazy případu přestanou fungovat (náhledy, které už byly vložené do chatů, se můžou zobrazovat dál, dokud je tyto aplikace neobnoví). Tohle nejde vrátit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vil du fjerne din originale tekst og dit viste navn? Sagens delingslinks holder op med at virke (forhåndsvisninger, der allerede er sendt i chats, kan stadig blive vist, indtil de apps opdaterer dem). Det kan ikke fortrydes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deinen Originaltext und deinen Anzeigenamen entfernen? Die geteilten Links des Falls funktionieren dann nicht mehr (Vorschauen, die schon in Chats gepostet wurden, können sichtbar bleiben, bis diese Apps sie aktualisieren). Das lässt sich nicht rückgängig machen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Να αφαιρεθούν το αρχικό σου κείμενο και το εμφανιζόμενο όνομά σου; Οι σύνδεσμοι κοινοποίησης της υπόθεσης σταματούν να λειτουργούν (προεπισκοπήσεις που έχουν ήδη σταλεί σε συνομιλίες μπορεί να εμφανίζονται μέχρι να τις ανανεώσουν οι εφαρμογές). Αυτό δεν αναιρείται."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove your original text and your display name? The case's share links stop working (previews already posted in chats may still show until those apps refresh them). This can't be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Eliminar tu texto original y tu nombre visible? Los enlaces para compartir del caso dejarán de funcionar (las vistas previas ya publicadas en chats pueden seguir viéndose hasta que esas apps las actualicen). No se puede deshacer."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poistetaanko alkuperäinen tekstisi ja näyttönimesi? Jutun jakolinkit lakkaavat toimimasta (keskusteluihin jo jaetut esikatselut voivat näkyä, kunnes sovellukset päivittävät ne). Tätä ei voi perua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimer ton texte original et ton nom affiché ? Les liens de partage du dossier cesseront de fonctionner (les aperçus déjà publiés dans des conversations peuvent rester visibles jusqu’à ce que ces applis les actualisent). Cette action est irréversible."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમારું મૂળ લખાણ અને ડિસ્પ્લે નામ દૂર કરવાં છે? કેસની શેર લિંક કામ કરતી બંધ થઈ જશે (ચૅટમાં પહેલેથી મુકાયેલા પ્રીવ્યૂ, એ ઍપ રિફ્રેશ ન કરે ત્યાં સુધી દેખાઈ શકે). આ પાછું વાળી નહીં શકાય."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "להסיר את הטקסט המקורי שלך ואת שם התצוגה שלך? קישורי השיתוף של התיק יפסיקו לעבוד (תצוגות מקדימות שכבר פורסמו בצ'אטים עשויות להמשיך להופיע עד שהאפליקציות האלה ירעננו אותן). אי אפשר לבטל את זה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका मूल टेक्स्ट और आपका दिखने वाला नाम हटा दें? केस के शेयर लिंक काम करना बंद कर देंगे (चैट में पहले से भेजे गए प्रीव्यू तब तक दिख सकते हैं जब तक वे ऐप उन्हें रीफ़्रेश न करें)। इसे पहले जैसा नहीं किया जा सकता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Želiš ukloniti svoj izvorni tekst i svoje prikazano ime? Poveznice za dijeljenje slučaja prestaju raditi (pregledi već objavljeni u razgovorima mogu se i dalje prikazivati dok ih te aplikacije ne osvježe). Ovo se ne može poništiti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eltávolítod az eredeti szövegedet és a megjelenített nevedet? Az ügy megosztási linkjei nem működnek tovább (a csetekben már kiküldött előnézetek még látszhatnak, amíg az adott app nem frissíti őket). Ez nem vonható vissza."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hapus teks aslimu dan nama tampilanmu? Tautan berbagi kasus ini berhenti berfungsi (pratinjau yang sudah terkirim di chat mungkin masih terlihat sampai aplikasinya memperbaruinya). Ini tidak bisa dibatalkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuoi rimuovere il tuo testo originale e il tuo nome visualizzato? I link di condivisione del caso smetteranno di funzionare (le anteprime già pubblicate nelle chat potrebbero restare visibili finché quelle app non le aggiornano). Non si può annullare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたの元の文章と表示名を削除しますか？　ケースのシェア用リンクは使えなくなります（チャットにすでに投稿されたプレビューは、そのアプリが更新するまで表示されることがあります）。この操作は取り消せません。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಿಮ್ಮ ಮೂಲ ಪಠ್ಯ ಮತ್ತು ಪ್ರದರ್ಶನ ಹೆಸರನ್ನು ತೆಗೆದುಹಾಕಬೇಕೇ? ಕೇಸ್‌ನ ಹಂಚಿಕೆ ಲಿಂಕ್‌ಗಳು ಕೆಲಸ ಮಾಡುವುದನ್ನು ನಿಲ್ಲಿಸುತ್ತವೆ (ಚಾಟ್‌ಗಳಲ್ಲಿ ಈಗಾಗಲೇ ಹಾಕಿರುವ ಪೂರ್ವವೀಕ್ಷಣೆಗಳು ಆ ಆ್ಯಪ್‌ಗಳು ರಿಫ್ರೆಶ್ ಮಾಡುವವರೆಗೂ ಕಾಣಬಹುದು). ಇದನ್ನು ವಾಪಸ್ ಪಡೆಯಲು ಆಗುವುದಿಲ್ಲ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내 원문과 표시 이름을 삭제할까요? 사건의 공유 링크가 열리지 않게 돼요(이미 대화방에 올라간 미리보기는 해당 앱이 새로 고칠 때까지 보일 수 있어요). 되돌릴 수 없어요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിങ്ങളുടെ ഒറിജിനൽ ടെക്സ്റ്റും ഷെയർ പേജിൽ കാണിക്കുന്ന നിങ്ങളുടെ പേരും നീക്കം ചെയ്യണോ? കേസിന്റെ ഷെയർ ലിങ്കുകൾ പ്രവർത്തിക്കാതാകും (ചാറ്റുകളിൽ നേരത്തേ പോസ്റ്റ് ചെയ്ത പ്രിവ്യൂകൾ ആ ആപ്പുകൾ പുതുക്കുന്നതുവരെ കണ്ടേക്കാം). ഇത് തിരിച്ചെടുക്കാനാകില്ല."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुमचा मूळ मजकूर आणि तुमचे दिसणारे नाव काढून टाकायचे? प्रकरणाच्या शेअर लिंक चालणे बंद होईल (चॅटमध्ये आधीच पोस्ट झालेले प्रिव्ह्यू ती ॲप्स रिफ्रेश करेपर्यंत दिसू शकतात). हे परत आणता येणार नाही."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buang teks asal dan nama paparan anda? Pautan kongsi kes ini akan berhenti berfungsi (pratonton yang sudah disiarkan dalam sembang mungkin masih kelihatan sehingga aplikasi itu menyegarkannya). Tindakan ini tidak boleh dibatalkan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vil du fjerne originalteksten og visningsnavnet ditt? Delingslenkene til saken slutter å virke (forhåndsvisninger som allerede er lagt ut i chatter, kan fortsatt vises til appene oppdaterer dem). Dette kan ikke angres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je oorspronkelijke tekst en je weergavenaam verwijderen? De deellinks van de zaak werken niet meer (previews die al in chats zijn gedeeld, kunnen zichtbaar blijven tot die apps ze vernieuwen). Dit kan niet ongedaan worden gemaakt."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଆପଣଙ୍କ ମୂଳ ଲେଖା ଓ ପ୍ରଦର୍ଶିତ ନାମ ହଟାଇବେ? ମାମଲାର ସେୟାର୍ ଲିଙ୍କ୍ କାମ କରିବା ବନ୍ଦ କରିବ (ଚାଟ୍‌ରେ ଆଗରୁ ପୋଷ୍ଟ ହୋଇଥିବା ପ୍ରିଭ୍ୟୁ ସେହି ଆପ୍ ରିଫ୍ରେସ୍ ନ କରିବା ଯାଏଁ ଦେଖାଯାଇପାରେ)। ଏହାକୁ ଆଉ ଫେରାଇହେବ ନାହିଁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤੁਹਾਡੀ ਅਸਲ ਲਿਖਤ ਅਤੇ ਦਿਖਣ ਵਾਲਾ ਨਾਂ ਹਟਾਉਣਾ ਹੈ? ਕੇਸ ਦੇ ਸਾਂਝੇ ਲਿੰਕ ਕੰਮ ਕਰਨਾ ਬੰਦ ਕਰ ਦੇਣਗੇ (ਚੈਟਾਂ ਵਿੱਚ ਪਹਿਲਾਂ ਹੀ ਭੇਜੇ ਪ੍ਰੀਵਿਊ ਉਦੋਂ ਤੱਕ ਦਿਖ ਸਕਦੇ ਹਨ ਜਦੋਂ ਤੱਕ ਉਹ ਐਪਾਂ ਉਨ੍ਹਾਂ ਨੂੰ ਤਾਜ਼ਾ ਨਹੀਂ ਕਰਦੀਆਂ)। ਇਹ ਵਾਪਸ ਨਹੀਂ ਹੋ ਸਕਦਾ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usunąć twój oryginalny tekst i nazwę wyświetlaną? Linki do udostępniania tej sprawy przestaną działać (podglądy wysłane już na czatach mogą być widoczne, dopóki te aplikacje ich nie odświeżą). Tego nie da się cofnąć."
