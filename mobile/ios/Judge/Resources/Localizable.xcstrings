    "app.example.dishwasher.a" : {
      "comment" : "Generated by mobile/shared/strings/export-strings.ts from lib/i18n.ts. Do not edit.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وضعت الأوعية في الرف العلوي مرة أخرى. لا تخرج من هناك نظيفة أبدًا، والرف السفلي موجود لهذا بالذات."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "তুমি আবার ভাতের হাঁড়িটা সারারাত সিঙ্কে ভিজিয়ে রেখেছ। সকালে পুরো রান্নাঘরে গন্ধ, রাতেই ধুয়ে ফেলা উচিত।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has tornat a posar els bols a la cistella de dalt del rentaplats. Allà dalt no surten mai nets; per això hi ha la de baix."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zase jsi dal misky do horního koše. Tam se nikdy pořádně neumyjí, od toho je přece dolní koš."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har sat skålene i den øverste kurv igen. De bliver aldrig rene deroppe, det er det, den nederste er til."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast die Schüsseln schon wieder oben eingeräumt. Da werden sie nie richtig sauber, dafür ist doch der untere Korb da."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Έβαλες πάλι τα μπολ στο πάνω καλάθι. Εκεί δεν βγαίνουν ποτέ καθαρά, γι' αυτό υπάρχει το κάτω."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You put the bowls on the top rack again. They never come out clean up there, that's what the bottom is for."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otra vez pusiste los platos hondos en la parte de arriba. Ahí nunca salen limpios; para eso está la de abajo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laitoit kulhot taas yläkoriin. Ne eivät ikinä puhdistu siellä, alakori on niitä varten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as encore mis les bols dans le panier du haut. Ils n’en ressortent jamais propres, c’est à ça que sert le panier du bas."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તેં ફરી વાટકા ઉપરના રૅકમાં મૂક્યા. ત્યાં એ ક્યારેય ચોખ્ખા નથી નીકળતા, નીચેનું રૅક એના માટે જ તો છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שוב שמת את הקערות במדף העליון. שם הן אף פעם לא יוצאות נקיות, בשביל זה יש את המדף התחתון."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुमने फिर से कटोरियाँ ऊपर वाले रैक में रख दीं। वहाँ वे कभी ठीक से साफ़ नहीं होतीं, नीचे वाला रैक इसी के लिए है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opet si stavio zdjelice u gornju košaru. Gore se nikad ne operu kako treba, za to služi donja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Már megint a felső kosárba raktad a tálakat. Ott sosem lesznek tiszták, arra való az alsó."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu menumpuk mangkuk basah di rak piring lagi. Kalau ditumpuk begitu, mangkuknya nggak pernah kering. Taruh telungkup satu-satu, dong."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai messo di nuovo le scodelle nel cestello di sopra. Lì non vengono mai pulite, il cestello di sotto serve apposta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "またお椀を上の段に入れてる。上だと全然きれいにならないんだよ。そのための下の段でしょ。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನೀನು ಮತ್ತೆ ಬಟ್ಟಲುಗಳನ್ನು ಡಿಶ್‌ವಾಶರ್‌ನ ಮೇಲಿನ ರ್ಯಾಕ್‌ನಲ್ಲಿ ಇಟ್ಟಿದ್ದೀಯ. ಅಲ್ಲಿ ಅವು ಯಾವತ್ತೂ ಸ್ವಚ್ಛವಾಗಿ ಬರುವುದಿಲ್ಲ, ಕೆಳಗಿನ ರ್ಯಾಕ್ ಇರುವುದೇ ಅದಕ್ಕೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그릇을 또 위 칸에 넣었네요. 위에서는 절대 깨끗하게 안 닦여요. 그릇 넣으라고 아래 칸이 있는 거잖아요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിങ്ങൾ വീണ്ടും ബൗളുകൾ മുകളിലെ റാക്കിലാണ് വെച്ചത്. അവിടെ വെച്ചാൽ ഒരിക്കലും വൃത്തിയാകില്ല, അതിനാണ് താഴത്തെ റാക്ക്."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तू पुन्हा वाट्या वरच्या रॅकमध्ये ठेवल्या आहेस. तिथे त्या कधीच नीट स्वच्छ होत नाहीत, खालचा रॅक त्यासाठीच तर आहे."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Awak letak mangkuk kat rak atas lagi. Kat atas tu mangkuk tak pernah keluar bersih, sebab tu ada rak bawah."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du satte skålene i overkurven igjen. Der blir de aldri rene, det er det underkurven er til."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je hebt de kommen weer in het bovenste rek gezet. Daar worden ze nooit schoon, daar is het onderste rek voor."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ତୁମେ ପୁଣି ବାଟିଗୁଡ଼ାକ ଡିସ୍‌ୱାସରର ଉପର ଥାକରେ ରଖିଛ। ସେଠି ସେଗୁଡ଼ା କେବେ ସଫା ବାହାରେ ନାହିଁ, ସେଥିପାଇଁ ତ ତଳ ଥାକ ଅଛି।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਤੁਸੀਂ ਫਿਰ ਡਿਸ਼ਵਾਸ਼ਰ ਦੇ ਉੱਪਰਲੇ ਰੈਕ ’ਚ ਕਟੋਰੀਆਂ ਰੱਖ ਦਿੱਤੀਆਂ। ਉੱਥੇ ਇਹ ਕਦੇ ਸਾਫ਼ ਨਹੀਂ ਨਿਕਲਦੀਆਂ, ਹੇਠਲਾ ਰੈਕ ਇਸੇ ਲਈ ਤਾਂ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znowu wstawiłeś miski do górnego kosza. Tam nigdy się nie domywają, od tego jest dolny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você colocou as tigelas na parte de cima de novo. Lá em cima elas nunca saem limpas. É para isso que serve a parte de baixo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voltaste a pôr as tigelas no cesto de cima. Lá em cima nunca ficam bem lavadas, o de baixo é que serve para isso."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iar ai pus bolurile în coșul de sus. Acolo nu ies niciodată curate, coșul de jos e pentru asta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты опять поставил миски в верхнюю корзину. Там они никогда не отмываются — для них есть нижняя."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zase si dal misky do horného koša. Tam sa nikdy poriadne neumyjú, na to je predsa dolný kôš."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sklede si spet zložil v zgornjo košaro. Tam se nikoli ne pomijejo do konca, za to je spodnja."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har ställt skålarna i överkorgen igen. Där uppe blir de aldrig rena – det är ju det underkorgen är till för."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நீ மறுபடியும் கிண்ணங்களை மேல் ரேக்கில் வைத்திருக்கிறாய். அங்கே அவை ஒருபோதும் சுத்தமாக வருவதில்லை, அதற்குத்தான் கீழ் ரேக் இருக்கிறது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీరు మళ్లీ గిన్నెలను పై ర్యాక్‌లో పెట్టారు. అక్కడ అవి ఎప్పుడూ శుభ్రంగా రావు, అందుకే కింది ర్యాక్ ఉంది."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใส่ชามไว้ชั้นบนอีกแล้ว อยู่ข้างบนทีไรล้างไม่เคยสะอาดเลย ชั้นล่างมีไว้ใส่ชามอยู่แล้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kâseleri yine üst rafa koymuşsun. Orada hiç temiz çıkmıyorlar, alt raf bunun için var."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ти знову поставив миски у верхній кошик. Там вони ніколи не відмиваються — для них є нижній."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم نے پیالے پھر اوپر والے ریک میں رکھ دیے۔ وہاں وہ کبھی صاف نہیں نکلتے، نیچے والا ریک اسی کام کے لیے ہے۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn lại xếp bát lên ngăn trên rồi. Để trên đó rửa chẳng bao giờ sạch, ngăn dưới là để xếp bát mà."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你又把碗放上层了。碗放上面从来洗不干净，下层就是放碗的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你又把碗放在上層了。放上面根本洗不乾淨，下層就是放碗的地方。"
          }
        }
      }
    },
