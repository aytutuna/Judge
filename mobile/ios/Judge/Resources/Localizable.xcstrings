    "app.case.waitingLead" : {
      "comment" : "Generated by mobile/shared/strings/export-strings.ts from lib/i18n.ts. Do not edit.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُكتب رواية %1$@ دون الحاجة إلى إنشاء حساب، ولا يرى أيٌّ منكما كلام الآخر حتى صدور الحكم."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ অ্যাকাউন্ট ছাড়াই নিজের বক্তব্য লিখবেন। রায়ের আগে আপনারা কেউ কারও লেখা দেখতে পাবেন না।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ escriu la seva versió sense haver de crear cap compte. Fins al veredicte, cap de vosaltres no veu el text de l'altra part."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ napíše svůj pohled bez účtu. Ani jeden z vás neuvidí text toho druhého dřív než verdikt."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ skriver sin side uden konto. Ingen af jer ser, hvad den anden har skrevet, før dommen falder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ schreibt die eigene Seite ohne Konto. Keiner von euch sieht die Seite des anderen vor dem Urteil."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ γράφει την άλλη πλευρά χωρίς λογαριασμό. Κανείς από τους δύο δεν βλέπει τι έγραψε ο άλλος πριν βγει η απόφαση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ writes their side without an account. Neither of you sees the other's words until the ruling."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ escribe su versión sin crear una cuenta. Ninguno de los dos ve la versión del otro hasta el veredicto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ kirjoittaa oman puolensa ilman tiliä. Kumpikaan teistä ei näe toisen tekstiä ennen tuomiota."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ écrit sa version sans compte. Aucun de vous deux ne voit le texte de l’autre avant le verdict."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ એકાઉન્ટ વગર પોતાની વાત લખે છે. ચુકાદો આવે ત્યાં સુધી તમે બંને એકબીજાની વાત નહીં જોઈ શકો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדי לכתוב את הצד של %1$@ אין צורך בחשבון. אף אחד מכם לא יראה מה השני כתב עד פסק הדין."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ को अपनी बात लिखने के लिए अकाउंट की ज़रूरत नहीं। फ़ैसला आने तक आप दोनों एक-दूसरे का लिखा नहीं देख पाएँगे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ piše svoju stranu bez računa. Nitko od vas ne vidi tuđi tekst do presude."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ fiók nélkül írja meg a saját verzióját. Az ítéletig egyikőtök sem látja a másik szövegét."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ bisa menulis versinya tanpa akun. Kalian tidak bisa melihat tulisan satu sama lain sampai putusan keluar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ scrive la sua versione senza bisogno di un account. Nessuno dei due vede il testo dell'altro fino al verdetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@はアカウントなしで言い分を書けます。判定が出るまで、お互いの内容は見えません。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ಖಾತೆ ಇಲ್ಲದೆಯೇ ತಮ್ಮ ಕಡೆಯ ಮಾತು ಬರೆಯುತ್ತಾರೆ. ತೀರ್ಪು ಬರುವವರೆಗೂ ನಿಮ್ಮಲ್ಲಿ ಯಾರಿಗೂ ಇನ್ನೊಬ್ಬರ ಬರಹ ಕಾಣುವುದಿಲ್ಲ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
