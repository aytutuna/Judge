    "app.example.spoiler.a" : {
      "comment" : "Generated by mobile/shared/strings/export-strings.ts from lib/i18n.ts. Do not edit.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أخبرتني مَن القاتل قبل أن أبدأ الحلقة الأخيرة أصلًا. كنت أنتظرها طوال الأسبوع."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শেষ পর্বটা শুরু করার আগেই তুমি বলে দিলে খুনি কে। পুরো সপ্তাহ ধরে ওটার জন্য অপেক্ষা করছিলাম।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em vas dir qui era l'assassí abans que comencés l'últim capítol. Feia tota la setmana que l'esperava."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prozradil jsi mi vraha, ještě než jsem pustila poslední díl. Celý týden jsem se na něj těšila."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du fortalte mig, hvem morderen var, før jeg overhovedet var begyndt på sidste afsnit. Jeg havde glædet mig hele ugen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast mir verraten, wer der Mörder ist, bevor ich mit der letzten Folge überhaupt angefangen hatte. Ich hab mich die ganze Woche darauf gefreut."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Μου είπες ποιος ήταν ο δολοφόνος πριν καν ξεκινήσω το τελευταίο επεισόδιο. Το περίμενα όλη την εβδομάδα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You told me who the killer was before I'd even started the last episode. I'd been waiting all week for it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me dijiste quién era el asesino antes de que empezara a ver el último capítulo. Llevaba toda la semana esperándolo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kerroit, kuka murhaaja oli, ennen kuin olin edes aloittanut viimeistä jaksoa. Olin odottanut sitä koko viikon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu m’as dit qui était le tueur avant même que je commence le dernier épisode. Ça faisait toute la semaine que je l’attendais."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "મેં છેલ્લો એપિસોડ શરૂ પણ નહોતો કર્યો ને તેં કહી દીધું કે ખૂની કોણ છે. આખું અઠવાડિયું હું એની રાહ જોતી હતી."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "סיפרת לי מי הרוצח עוד לפני שהתחלתי את הפרק האחרון. חיכיתי לו כל השבוע."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मैंने आख़िरी एपिसोड शुरू भी नहीं किया था कि तुमने बता दिया क़ातिल कौन है। मैं पूरे हफ़्ते से उसका इंतज़ार कर रही थी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rekao si mi tko je ubojica prije nego što sam uopće počela gledati zadnju epizodu. Cijeli tjedan sam je čekala."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elárultad, ki a gyilkos, mielőtt egyáltalán elkezdtem volna az utolsó részt. Egész héten erre vártam."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu kasih tahu siapa pembunuhnya padahal aku belum mulai nonton episode terakhir. Aku sudah menunggunya seminggu penuh."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mi hai detto chi era l'assassino prima ancora che iniziassi l'ultima puntata. L'aspettavo da tutta la settimana."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最終話を見始める前に、犯人をバラしたでしょ。1週間ずっと楽しみにしてたのに。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಾನು ಕೊನೆಯ ಎಪಿಸೋಡ್ ಶುರು ಮಾಡುವ ಮೊದಲೇ ನೀನು ಕೊಲೆಗಾರ ಯಾರು ಅಂತ ಹೇಳಿಬಿಟ್ಟೆ. ಇಡೀ ವಾರ ಅದಕ್ಕಾಗಿ ಕಾಯುತ್ತಿದ್ದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마지막 화를 틀기도 전에 범인이 누군지 말해 버렸잖아요. 일주일 내내 그것만 기다렸는데요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "അവസാന എപ്പിസോഡ് കണ്ടുതുടങ്ങും മുമ്പേ കൊലയാളി ആരാണെന്ന് നിങ്ങൾ പറഞ്ഞുകളഞ്ഞു. ആഴ്ച മുഴുവൻ അതിനായി കാത്തിരിക്കുകയായിരുന്നു ഞാൻ."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मी शेवटचा भाग सुरू करण्याआधीच तू खुनी कोण ते सांगून टाकलेस. आठवडाभर मी त्याचीच वाट पाहत होते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Awak beritahu saya siapa pembunuhnya sebelum saya sempat mula tengok episod terakhir. Saya dah tunggu seminggu."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du fortalte meg hvem morderen var før jeg i det hele tatt hadde begynt på siste episode. Jeg hadde gledet meg til den hele uka."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je verklapte wie de moordenaar was voordat ik ook maar aan de laatste aflevering was begonnen. Ik had er de hele week naar uitgekeken."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ମୁଁ ଶେଷ ଏପିସୋଡ୍ ଆରମ୍ଭ କରିବା ଆଗରୁ ହିଁ ତୁମେ କହିଦେଲ ଖୁନୀ କିଏ। ମୁଁ ପୂରା ସପ୍ତାହ ସେଥିପାଇଁ ଅପେକ୍ଷା କରିଥିଲି।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਮੈਂ ਆਖ਼ਰੀ ਐਪੀਸੋਡ ਸ਼ੁਰੂ ਵੀ ਨਹੀਂ ਕੀਤਾ ਸੀ ਕਿ ਤੁਸੀਂ ਦੱਸ ਦਿੱਤਾ ਕਾਤਲ ਕੌਣ ਹੈ। ਮੈਂ ਸਾਰਾ ਹਫ਼ਤਾ ਉਸ ਦੀ ਉਡੀਕ ਕੀਤੀ ਸੀ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powiedziałeś mi, kto zabił, zanim w ogóle włączyłam ostatni odcinek. Czekałam na niego cały tydzień."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você me contou quem era o assassino antes mesmo de eu começar o último episódio. Passei a semana inteira esperando esse episódio."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disseste-me quem era o assassino antes de eu sequer ter começado o último episódio. Estive a semana inteira à espera dele."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mi-ai zis cine e criminalul înainte să încep măcar ultimul episod. L-am așteptat toată săptămâna."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ты рассказал, кто убийца, когда я ещё даже не начала последнюю серию. Я ждала её целую неделю."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prezradil si mi, kto je vrah, ešte predtým, ako som si pustila poslednú časť. Celý týždeň som sa na ňu tešila."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povedal si mi, kdo je morilec, še preden sem sploh začela zadnjo epizodo. Ves teden sem čakala nanjo."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du berättade vem mördaren var innan jag ens hade börjat på sista avsnittet. Jag hade väntat på det hela veckan."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "கடைசி எபிசோடை நான் தொடங்குவதற்கு முன்பே கொலையாளி யார் என்று சொல்லிவிட்டாய். அதற்காக வாரம் முழுக்கக் காத்திருந்தேன்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "నేను ఆఖరి ఎపిసోడ్ మొదలుపెట్టకముందే మీరు హంతకుడు ఎవరో చెప్పేశారు. వారమంతా దాని కోసమే ఎదురుచూశాను."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไปบอกว่าใครเป็นฆาตกร ทั้งที่เรายังไม่ได้เปิดดูตอนจบเลย อุตส่าห์รอมาทั้งสัปดาห์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son bölümü açmadan katilin kim olduğunu söyledin. Bütün hafta onu bekliyordum."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ти розповів мені, хто вбивця, ще до того, як я почала останню серію. Я чекала на неї цілий тиждень."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "میں نے آخری قسط ابھی شروع بھی نہیں کی تھی اور تم نے بتا دیا کہ قاتل کون ہے۔ میں پورا ہفتہ اس کا انتظار کر رہی تھی۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mình còn chưa mở tập cuối thì bạn đã nói ai là hung thủ. Mình chờ tập đó cả tuần đấy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我最后一集还没点开，你就把凶手是谁说出来了。我等这一集等了一整个星期。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我最後一集都還沒開始看，你就跟我說兇手是誰。那集我等了一整個禮拜。"
          }
        }
      }
    },
