          "stringUnit" : {
            "state" : "translated",
            "value" : "ಅಥವಾ ಈಗಲೇ ನಿಮ್ಮ ಕಡೆಯ ಮಾತಿನ ಮೇಲೆಯೇ ತೀರ್ಪು ಪಡೆಯಿರಿ"
