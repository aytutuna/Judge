        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ba giám khảo AI phân xử riêng rẽ, nếu sát nút sẽ gọi thêm giám khảo. Chờ chừng một phút nhé."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "三位 AI 评委分别裁决，票数接近时还会加派评委。稍等一分钟。"
