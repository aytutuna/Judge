        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내 이야기만 듣고 판사들이 바로 판결해요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "നിങ്ങൾ പറയൂ, ജഡ്ജിമാർ ഉടൻ വിധി പറയും."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "तुम्ही सांगा, परीक्षक लगेच निकाल देतात."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anda bercerita, dan hakim terus memutuskan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du forteller, og dommerne avgjør med en gang."
