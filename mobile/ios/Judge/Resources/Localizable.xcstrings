        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log ind for at få en dom. En ny konto får sin første dom gratis."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melde dich an, um ein Urteil zu bekommen. Neue Konten erhalten das erste Urteil gratis."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Συνδέσου για να ζητήσεις απόφαση. Κάθε νέος λογαριασμός παίρνει την πρώτη του απόφαση δωρεάν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign in to get a verdict. A new account gets its first verdict free."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión para obtener un veredicto. Con una cuenta nueva, el primero es gratis."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
