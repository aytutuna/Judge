        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esa solicitud llegó desde un sitio que no reconocemos. Asegúrate de tener la app actualizada y vuelve a intentarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emme tunnista, mistä pyyntö tuli. Varmista, että sovellus on ajan tasalla, ja yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette demande provient d’une source qu’on ne reconnaît pas. Vérifie que l’appli est à jour et réessaie."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આ વિનંતી કોઈ અજાણી જગ્યાએથી આવી. ઍપ અપડેટ કરેલી છે એની ખાતરી કરીને ફરી પ્રયાસ કરો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הבקשה הגיעה ממקום שאנחנו לא מזהים. כדאי לוודא שהאפליקציה מעודכנת ולנסות שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह अनुरोध किसी अनजान जगह से आया है। पक्का कर लें कि ऐप का नया वर्शन इंस्टॉल है, फिर कोशिश करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taj je zahtjev stigao s mjesta koje ne prepoznajemo. Provjeri imaš li najnoviju verziju aplikacije i pokušaj ponovno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez a kérés számunkra ismeretlen helyről érkezett. Nézd meg, hogy naprakész-e az app, és próbáld újra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permintaan itu datang dari tempat yang tidak kami kenali. Pastikan aplikasimu sudah diperbarui, lalu coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa richiesta arriva da un posto che non riconosciamo. Assicurati che l'app sia aggiornata e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "見覚えのない場所から送られたリクエストです。アプリが最新版になっているか確認して、もう一度お試しください。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಈ ವಿನಂತಿ ನಮಗೆ ಗೊತ್ತಿಲ್ಲದ ಕಡೆಯಿಂದ ಬಂದಿದೆ. ಆ್ಯಪ್ ಅಪ್‌ಡೇಟ್ ಆಗಿದೆಯೇ ಎಂದು ನೋಡಿ ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "알 수 없는 곳에서 온 요청이에요. 앱이 최신 버전인지 확인하고 다시 시도해 주세요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഞങ്ങൾക്ക് പരിചയമില്ലാത്ത ഒരിടത്തുനിന്നാണ് ഈ അഭ്യർത്ഥന വന്നത്. ആപ്പ് അപ്ഡേറ്റ് ചെയ്തിട്ടുണ്ടെന്ന് ഉറപ്പാക്കി വീണ്ടും ശ്രമിക്കൂ."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ही विनंती आम्हाला ओळख नसलेल्या ठिकाणाहून आली. ॲप अपडेट केलेले आहे ना ते पाहा आणि पुन्हा प्रयत्न करा."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permintaan itu datang dari tempat yang kami tidak kenali. Pastikan aplikasi anda sudah dikemas kini, kemudian cuba lagi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den forespørselen kom fra et sted vi ikke kjenner igjen. Sjekk at appen er oppdatert, og prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dat verzoek kwam van een plek die we niet kennen. Zorg dat de app is bijgewerkt en probeer het opnieuw."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଏହି ଅନୁରୋଧ ଆମେ ଚିହ୍ନୁନଥିବା ଜାଗାରୁ ଆସିଲା। ଆପ୍‌ଟି ଅପଡେଟ୍ ହୋଇଛି କି ନାହିଁ ଦେଖି ପୁଣି ଚେଷ୍ଟା କରନ୍ତୁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਇਹ ਬੇਨਤੀ ਕਿਸੇ ਅਣਜਾਣ ਥਾਂ ਤੋਂ ਆਈ ਹੈ। ਪੱਕਾ ਕਰ ਲਓ ਕਿ ਐਪ ਅੱਪਡੇਟ ਕੀਤੀ ਹੋਈ ਹੈ, ਫਿਰ ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To żądanie przyszło z nieznanego miejsca. Sprawdź, czy masz najnowszą wersję aplikacji, i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esse pedido veio de um lugar que não reconhecemos. Confira se o app está atualizado e tente de novo."
