        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ജഡ്ജിമാർ എന്തെങ്കിലും കാണാതെ പോയോ? അത് ചേർത്താൽ അവർ വീണ്ടും വിധി പറയും. ആദ്യത്തെ വിധി രേഖയിൽ തന്നെ ഉണ്ടാകും."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "परीक्षकांकडून काही सुटले? ते जोडा, म्हणजे परीक्षक पुन्हा निकाल देतील. पहिला निकाल नोंदीत राहतो."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ada yang hakim terlepas pandang? Tambahkan dan mereka akan memutuskan semula. Keputusan pertama kekal dalam rekod."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gikk dommerne glipp av noe? Legg det til, så dømmer de på nytt. Den første dommen blir liggende i historikken."
