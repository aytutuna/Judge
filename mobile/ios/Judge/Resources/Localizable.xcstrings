    "app.example.thermostat.a" : {
      "comment" : "Generated by mobile/shared/strings/export-strings.ts from lib/i18n.ts. Do not edit.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الحرارة هنا 19 درجة، وأشعر بالبرد حتى وأنا ألبس كنزة. رفع التدفئة إلى 22 ليس مبالغة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এসি 19 ডিগ্রিতে চলছে, চাদর গায়ে দিয়েও আমার শীত করছে। 22 করে দিলে কী এমন হয়?"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí dins fa 19 graus i tinc fred fins i tot amb la dessuadora. Pujar la calefacció a 22 no és cap bogeria."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je tu 19 stupňů a je mi zima i v mikině. Pustit topení na 22 není žádné šílenství."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der er 19 grader herinde, og jeg fryser selv i hættetrøje. Det er da ikke vanvittigt at skrue op på 22."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier drin sind 19 Grad, und mir ist sogar im Hoodie kalt. Die Heizung auf 22 zu drehen ist doch nicht übertrieben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Έχει 19 βαθμούς εδώ μέσα και κρυώνω ακόμα και με φούτερ. Δεν είναι τρελό να ανεβάσουμε τη θέρμανση στους 22."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It's 19 degrees in here and I'm cold even in a hoodie. Turning it up to 22 isn't crazy."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí dentro hace 19 grados y tengo frío incluso con sudadera. Poner la calefacción a 22 no es ninguna locura."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Täällä on 19 astetta, ja minulla on kylmä hupparissakin. Ei ole mitenkään hullua nostaa lämpöä 22 asteeseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il fait 19 °C ici et j’ai froid même avec un sweat. Monter le chauffage à 22, ce n’est pas exagéré."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AC 18 ડિગ્રી પર છે અને હૂડી પહેરીને પણ મને ઠંડી લાગે છે. 24 કરવામાં કંઈ ખોટું નથી."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יש פה 19 מעלות וקר לי אפילו עם קפוצ'ון. להעלות את המזגן ל-22 זה לא מוגזם."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AC 19 डिग्री पर है और मुझे हुडी में भी ठंड लग रही है। 22 कर देना कोई ज़्यादती नहीं है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovdje je 19 stupnjeva i hladno mi je čak i u dukserici. Pojačati grijanje na 22 nije nikakva ludost."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "19 fok van itt bent, és még kapucnis pulóverben is fázom. Nem őrültség feltekerni 22-re."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AC-nya disetel 18 derajat dan aku kedinginan padahal sudah pakai hoodie. Menaikkannya ke 24 itu nggak berlebihan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui dentro ci sono 19 gradi e ho freddo anche con la felpa. Alzare il termostato a 22 non è una follia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この部屋、19℃しかないんだよ。パーカーを着てても寒いの。暖房を22℃にするくらい、別におかしくないでしょ。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನೀನು AC ಅನ್ನು 19 ಡಿಗ್ರಿಗೆ ಇಟ್ಟಿದ್ದೀಯ, ಸ್ವೆಟರ್ ಹಾಕಿದರೂ ನನಗೆ ಚಳಿ ಆಗುತ್ತಿದೆ. 24ಕ್ಕೆ ಏರಿಸುವುದು ಅತಿಯೇನಲ್ಲ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "집 안이 19도라서 후드티를 입어도 추워요. 보일러를 22도로 올리는 게 그렇게 무리는 아니잖아요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "എസി 19 ഡിഗ്രിയിലാണ്, ഹൂഡി ഇട്ടിട്ടും എനിക്ക് തണുക്കുന്നു. 22 ആക്കുന്നത് അത്ര വലിയ കാര്യമൊന്നുമല്ലല്ലോ."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एसी 18 अंशांवर आहे आणि स्वेटर घालूनही मला थंडी वाजतेय. 24 वर ठेवणे काही अवाजवी नाही."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aircond ni 19°C, saya pakai hoodie pun masih sejuk. Naikkan ke 24 bukannya melampau pun."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det er 19 grader her inne, og jeg fryser selv i hettegenser. Å skru opp til 22 er ikke galskap."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het is hier 19 graden en ik heb het zelfs in een hoodie koud. De thermostaat op 22 zetten is echt niet overdreven."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AC 19 ଡିଗ୍ରୀରେ ଚାଲିଛି, ଚାଦର ଘୋଡ଼ାଇଲେ ବି ମୋତେ ଥଣ୍ଡା ଲାଗୁଛି। 22 କରିଦେବା କିଛି ଅଜବ କଥା ନୁହେଁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਇੱਥੇ 19 ਡਿਗਰੀ ਹੈ ਅਤੇ ਮੈਨੂੰ ਹੂਡੀ ਪਾ ਕੇ ਵੀ ਠੰਢ ਲੱਗ ਰਹੀ ਹੈ। ਹੀਟਰ 22 ’ਤੇ ਕਰਨਾ ਕੋਈ ਪਾਗਲਪਣ ਨਹੀਂ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jest tu 19 stopni i marznę nawet w bluzie. Podkręcenie ogrzewania do 22 to żadna przesada."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ar está em 19 graus e eu estou com frio até de moletom. Subir para 22 não é nenhum absurdo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estão 19 graus cá dentro e tenho frio mesmo de camisola com capuz. Pôr o aquecimento nos 22 não é nenhum exagero."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sunt 19 grade aici și mi-e frig și cu hanoracul pe mine. Nu e o nebunie să dăm căldura la 22."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здесь 19 градусов, я мёрзну даже в худи. Поднять до 22 — не такая уж дикость."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je tu 19 stupňov a je mi zima aj v mikine. Dať kúrenie na 22 predsa nie je žiadne šialenstvo."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tukaj je 19 stopinj in me zebe celo v puloverju s kapuco. Gretje naviti na 22 res ni nič pretiranega."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det är 19 grader här inne och jag fryser fast jag har luvtröja på mig. Att höja till 22 är väl inte orimligt."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AC 19 டிகிரியில் ஓடுகிறது, ஹூடி போட்டிருந்தும் எனக்குக் குளிர்கிறது. 22-க்கு வைப்பது ஒன்றும் பெரிய விஷயம் இல்லை."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AC 19 డిగ్రీల మీద ఉంది, దుప్పటి కప్పుకున్నా చలేస్తోంది. 24కి పెంచమనడం ఏమీ అతి కాదు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แอร์ตั้งไว้ 22 องศา ห่มผ้าแล้วยังหนาวอยู่เลย ปรับเป็น 25 ก็ไม่ได้เกินไปหรอก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İçerisi 19 derece, kapüşonluyla bile üşüyorum. Kombiyi 22'ye almak abartı değil."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тут 19 градусів, і мені холодно навіть у худі. Підкрутити до 22 — це ж не якась примха."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AC 18 پر لگا ہے اور مجھے چادر اوڑھ کر بھی ٹھنڈ لگ رہی ہے۔ اسے 24 پر کر دینا کوئی زیادتی نہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phòng đang 29°C, mình nóng toát mồ hôi. Hạ điều hòa xuống 25°C có gì quá đâu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "屋里才 19 度，我穿着卫衣还冷。把空调调到 22 度不算过分吧。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "冷氣開 22 度，我穿帽T還是冷。調到 26 度不過分吧。"
          }
        }
      }
    },
