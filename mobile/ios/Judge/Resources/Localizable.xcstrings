    "app.example.lastSlice.a" : {
      "comment" : "Generated by mobile/shared/strings/export-strings.ts from lib/i18n.ts. Do not edit.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قبل أن يبدأ الفيلم قلت: «القطعة الأخيرة لي». الجميع سمعني."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সিনেমা শুরুর আগেই বলে রেখেছিলাম, পিৎজার শেষ স্লাইসটা আমার। সবাই শুনেছে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abans que comencés la pel·li vaig dir que l'últim tros de pizza era meu. Tothom em va sentir."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ještě než začal film, řekl jsem, že poslední kousek je můj. Všichni to slyšeli."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inden filmen startede, sagde jeg, at det sidste stykke pizza var mit. Alle hørte det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich hab schon vor dem Film gesagt: „Das letzte Stück Pizza ist meins!“ Alle haben es gehört."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πριν αρχίσει η ταινία είπα «το τελευταίο κομμάτι είναι δικό μου». Όλοι με άκουσαν."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I called dibs on the last slice before the movie started. Everyone heard me."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dije que la última porción era para mí antes de que empezara la película. Todo el mundo me oyó."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varasin viimeisen palan jo ennen kuin leffa alkoi. Kaikki kuulivat sen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "J’ai dit « la dernière part est pour moi » avant le début du film. Tout le monde m’a entendu."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ફિલ્મ શરૂ થઈ એ પહેલાં જ મેં કહી દીધું હતું કે પિઝાનો છેલ્લો પીસ મારો. બધાએ સાંભળ્યું હતું."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "שריינתי את המשולש האחרון עוד לפני שהסרט התחיל. כולם שמעו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़िल्म शुरू होने से पहले ही मैंने कह दिया था कि आख़िरी स्लाइस मेरा है। सबने सुना था।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prije filma sam rekao „zadnji komad je moj“. Svi su me čuli."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Még a film előtt lestoppoltam az utolsó szeletet. Mindenki hallotta."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sebelum filmnya mulai, aku sudah bilang “potongan terakhir punyaku”. Semua orang dengar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima che iniziasse il film ho detto “l'ultima fetta è mia”. L'hanno sentito tutti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "映画が始まる前に「ピザの最後の1切れは俺の」って言ったよね。みんな聞いてたし。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಸಿನಿಮಾ ಶುರುವಾಗುವ ಮೊದಲೇ “ಪಿಜ್ಜಾದ ಕೊನೆಯ ಪೀಸ್ ನನ್ನದು” ಅಂತ ಹೇಳಿದ್ದೆ. ಎಲ್ಲರಿಗೂ ಕೇಳಿಸಿತ್ತು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "영화 시작하기 전에 “마지막 피자 한 조각은 내 거”라고 찜했어요. 다들 들었어요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "പിസ്സയുടെ അവസാനത്തെ കഷണം എനിക്കാണെന്ന് സിനിമ തുടങ്ങും മുമ്പേ ഞാൻ പറഞ്ഞതാണ്. എല്ലാവരും കേട്ടതാണ്."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिनेमा सुरू होण्याआधीच मी “शेवटचा स्लाइस माझा” असे सांगितले होते. सगळ्यांनी ऐकले होते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saya dah cop potongan pizza terakhir sebelum filem mula. Semua orang dengar."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeg tinget det siste pizzastykket før filmen begynte. Alle hørte det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ik riep al “laatste stuk is voor mij” voordat de film begon. Iedereen heeft het gehoord."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ସିନେମା ଆରମ୍ଭ ହେବା ଆଗରୁ ମୁଁ କହିଥିଲି, “ଶେଷ ପିଜ୍ଜା ପିସ୍ ମୋର”। ସମସ୍ତେ ଶୁଣିଥିଲେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਫ਼ਿਲਮ ਸ਼ੁਰੂ ਹੋਣ ਤੋਂ ਪਹਿਲਾਂ ਹੀ ਮੈਂ ਕਹਿ ਦਿੱਤਾ ਸੀ: “ਪੀਜ਼ੇ ਦਾ ਆਖ਼ਰੀ ਟੁਕੜਾ ਮੇਰਾ।” ਸਾਰਿਆਂ ਨੇ ਸੁਣਿਆ ਸੀ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaklepałem ostatni kawałek pizzy, zanim zaczął się film. Wszyscy słyszeli."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eu falei “o último pedaço é meu” antes de o filme começar. Todo mundo ouviu."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disse «a última fatia é minha» antes de o filme começar. Toda a gente ouviu."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am zis „ultima felie e a mea” înainte să înceapă filmul. Toată lumea m-a auzit."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я ещё до начала фильма сказала, что последний кусок мой. Все слышали."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ešte pred začiatkom filmu som povedal, že posledný kúsok je môj. Všetci to počuli."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Še pred filmom sem rekel: „Zadnji kos je moj.“ Vsi so slišali."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jag paxade sista pizzabiten innan filmen började. Alla hörde mig."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "படம் தொடங்குவதற்கு முன்பே கடைசி பீட்சா துண்டு எனக்குத்தான் என்று சொல்லிவிட்டேன். எல்லோரும் கேட்டார்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "సినిమా మొదలవకముందే చివరి పిజ్జా ముక్క నాదే అని చెప్పాను. అందరూ విన్నారు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เราจองชิ้นสุดท้ายไว้ตั้งแต่ก่อนหนังเริ่ม ทุกคนก็ได้ยิน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Film başlamadan \"son dilim benim\" dedim. Herkes duydu."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Я ще до початку фільму сказав, що останній шматок піци мій. Усі чули."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فلم شروع ہونے سے پہلے ہی میں نے کہہ دیا تھا کہ آخری سلائس میرا ہے۔ سب نے سنا تھا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mình xí miếng pizza cuối từ trước khi phim chiếu. Cả đám đều nghe."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "电影开场前我就说了“最后一块披萨是我的”，大家都听见了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "電影開始前我就喊了「最後一片披薩是我的」，大家都有聽到。"
          }
        }
      }
    },
