            "value" : "Δεν μπορούμε να βρούμε τους κριτές αυτή τη στιγμή. Περίμενε ένα λεπτό και ξαναδοκίμασε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We can't reach the judges right now. Give it a minute and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los jueces no responden ahora mismo. Espera un minuto y vuelve a intentarlo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emme saa juuri nyt yhteyttä tuomareihin. Odota hetki ja yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de joindre les juges pour l’instant. Attends une minute et réessaie."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "અત્યારે જજ સુધી પહોંચી શકાતું નથી. એકાદ મિનિટ પછી ફરી પ્રયાસ કરો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אין לנו כרגע קשר עם השופטים. אפשר לנסות שוב בעוד דקה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभी जजों तक पहुँच नहीं पा रहे। एक मिनट रुककर फिर कोशिश करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trenutačno ne možemo doći do sudaca. Pričekaj minutu pa pokušaj ponovno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Most nem érjük el a bírákat. Várj egy percet, és próbáld újra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para hakim sedang tidak bisa dihubungi. Tunggu sebentar, lalu coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al momento non riusciamo a raggiungere i giudici. Aspetta un minuto e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いま審査員に接続できません。少し待ってからもう一度お試しください。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಈಗ ತೀರ್ಪುಗಾರರನ್ನು ಸಂಪರ್ಕಿಸಲು ಆಗುತ್ತಿಲ್ಲ. ಒಂದು ನಿಮಿಷ ಬಿಟ್ಟು ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금은 판사들과 연결이 안 돼요. 잠시 후 다시 시도해 주세요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ഇപ്പോൾ ജഡ്ജിമാരെ കിട്ടുന്നില്ല. ഒരു മിനിറ്റ് കഴിഞ്ഞ് വീണ്ടും ശ്രമിക്കൂ."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आत्ता परीक्षकांपर्यंत पोहोचता येत नाही. एखादे मिनिट थांबून पुन्हा प्रयत्न करा."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kami tidak dapat menghubungi hakim sekarang. Tunggu seminit dan cuba lagi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi får ikke kontakt med dommerne akkurat nå. Vent et minutt og prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We kunnen de rechters nu niet bereiken. Wacht even en probeer het opnieuw."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଏବେ ବିଚାରକଙ୍କ ପାଖରେ ପହଞ୍ଚିପାରୁନାହୁଁ। ଟିକେ ରହି ପୁଣି ଚେଷ୍ଟା କରନ୍ତୁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਇਸ ਵੇਲੇ ਜੱਜਾਂ ਤੱਕ ਪਹੁੰਚ ਨਹੀਂ ਹੋ ਰਹੀ। ਇੱਕ ਮਿੰਟ ਰੁਕ ਕੇ ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie możemy teraz połączyć się z sędziami. Odczekaj chwilę i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não estamos conseguindo falar com os juízes agora. Espere um minuto e tente de novo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não conseguimos falar com os juízes neste momento. Espera um minuto e tenta outra vez."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Judecătorii nu răspund acum. Mai așteaptă un minut și încearcă din nou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сейчас не получается связаться с судьями. Подождите минуту и попробуйте снова."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So sudcami sa teraz nevieme spojiť. Počkaj chvíľu a skús to znova."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Do sodnikov trenutno ne moremo. Počakaj minutko in poskusi znova."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi når inte domarna just nu. Vänta en minut och försök igen."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "இப்போது நடுவர்களைத் தொடர்புகொள்ள முடியவில்லை. ஒரு நிமிடம் கழித்து மீண்டும் முயலுங்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఇప్పుడు జడ్జీలను చేరుకోలేకపోతున్నాం. ఒక నిమిషం ఆగి మళ్లీ ప్రయత్నించండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
