        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connecte-toi pour obtenir un verdict. Avec un nouveau compte, le premier verdict est offert."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ચુકાદો મેળવવા સાઇન ઇન કરો. નવા એકાઉન્ટનો પહેલો ચુકાદો મફત છે."
