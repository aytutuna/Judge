        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ tidak perlu akaun untuk menulis versinya. Anda berdua tidak akan nampak tulisan satu sama lain sehingga keputusan keluar."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
