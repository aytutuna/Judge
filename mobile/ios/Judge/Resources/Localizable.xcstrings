    "pricing.note" : {
      "comment" : "Generated by mobile/shared/strings/export-strings.ts from lib/i18n.ts. Do not edit.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الأسعار بالدولار الأمريكي. الدفع غير متاح بعد، لذا لا يمكن شراء شيء اليوم."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "দাম মার্কিন ডলারে। পেমেন্ট এখনও চালু হয়নি, তাই আজ কিছু কেনা যাবে না।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els preus són en dòlars dels EUA. Encara no s'accepten pagaments, així que avui no es pot comprar res."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceny jsou v amerických dolarech. Platby zatím nejsou spuštěné, takže dnes nejde nic koupit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Priserne er i amerikanske dollars. Betaling er ikke åbnet endnu, så der kan ikke købes noget i dag."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preise in US-Dollar. Zahlungen sind noch nicht freigeschaltet, du kannst heute also noch nichts kaufen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι τιμές είναι σε δολάρια ΗΠΑ. Οι πληρωμές δεν έχουν ανοίξει ακόμα, οπότε προς το παρόν δεν αγοράζεται τίποτα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prices are in US dollars. Payments aren't open yet, so nothing can be bought today."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los precios están en dólares estadounidenses. Los pagos aún no están abiertos, así que hoy no se puede comprar nada."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinnat ovat Yhdysvaltain dollareina. Maksaminen ei ole vielä mahdollista, joten mitään ei voi vielä ostaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prix en dollars américains. Les paiements ne sont pas encore ouverts, donc rien ne peut être acheté pour l’instant."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "કિંમતો અમેરિકન ડૉલરમાં છે. ચુકવણી હજી શરૂ થઈ નથી, એટલે આજે કંઈ ખરીદી શકાતું નથી."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "המחירים בדולר אמריקאי. התשלומים עוד לא פתוחים, אז אי אפשר לקנות כלום היום."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कीमतें अमेरिकी डॉलर में हैं। पेमेंट अभी शुरू नहीं हुए हैं, इसलिए आज कुछ भी ख़रीदा नहीं जा सकता।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cijene su u američkim dolarima. Plaćanje još nije omogućeno, pa zasad ništa ne možeš kupiti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az árak amerikai dollárban értendők. A fizetés még nem érhető el, így egyelőre semmit sem lehet megvenni."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harga dalam dolar AS. Pembayaran belum dibuka, jadi untuk saat ini belum ada yang bisa dibeli."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I prezzi sono in dollari USA. I pagamenti non sono ancora attivi, quindi per ora non si può acquistare nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "価格は米ドル表示です。まだ決済を受け付けていないため、現在は購入できません。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಬೆಲೆಗಳು ಅಮೆರಿಕನ್ ಡಾಲರ್‌ಗಳಲ್ಲಿವೆ. ಪಾವತಿಗಳು ಇನ್ನೂ ಆರಂಭವಾಗಿಲ್ಲ, ಹಾಗಾಗಿ ಇಂದು ಏನನ್ನೂ ಖರೀದಿಸಲು ಆಗುವುದಿಲ್ಲ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가격은 미국 달러 기준이에요. 아직 결제가 열리지 않아서 지금은 구매할 수 없어요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "വിലകൾ യുഎസ് ഡോളറിലാണ്. പേയ്‌മെന്റുകൾ ഇതുവരെ തുടങ്ങിയിട്ടില്ല, അതുകൊണ്ട് ഇന്ന് ഒന്നും വാങ്ങാനാവില്ല."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किमती अमेरिकी डॉलरमध्ये आहेत. पेमेंट अजून सुरू झालेले नाही, त्यामुळे आज काहीही विकत घेता येणार नाही."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Harga dalam dolar AS. Pembayaran belum dibuka, jadi tiada apa yang boleh dibeli hari ini."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prisene er i amerikanske dollar. Betaling er ikke åpnet ennå, så ingenting kan kjøpes i dag."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prijzen zijn in Amerikaanse dollars. Betalen kan nog niet, dus vandaag is er nog niets te koop."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ମୂଲ୍ୟ US ଡଲାରରେ। ପେମେଣ୍ଟ ଏଯାଏଁ ଚାଲୁ ହୋଇନାହିଁ, ତେଣୁ ଆଜି କିଛି କିଣିହେବ ନାହିଁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਕੀਮਤਾਂ ਅਮਰੀਕੀ ਡਾਲਰ ਵਿੱਚ ਹਨ। ਭੁਗਤਾਨ ਹਾਲੇ ਸ਼ੁਰੂ ਨਹੀਂ ਹੋਏ, ਇਸ ਲਈ ਅੱਜ ਕੁਝ ਵੀ ਖ਼ਰੀਦਿਆ ਨਹੀਂ ਜਾ ਸਕਦਾ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceny w dolarach amerykańskich. Płatności jeszcze nie działają, więc dziś nic nie da się kupić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preços em dólares americanos. Os pagamentos ainda não estão abertos, então nada pode ser comprado hoje."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os preços estão em dólares americanos. Os pagamentos ainda não abriram, por isso hoje não é possível comprar nada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prețurile sunt în dolari americani. Plățile nu sunt încă active, așa că azi nu poți cumpăra nimic."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цены указаны в долларах США. Оплата пока не открыта, так что сегодня купить ничего нельзя."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceny sú v amerických dolároch. Platby ešte nie sú spustené, takže dnes sa nedá nič kúpiť."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cene so v ameriških dolarjih. Plačila še niso odprta, zato danes ni mogoče ničesar kupiti."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Priserna är i amerikanska dollar. Betalningar är inte öppna än, så inget kan köpas i dag."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "விலைகள் அமெரிக்க டாலரில். பணம் செலுத்துதல் இன்னும் தொடங்கவில்லை, அதனால் இன்று எதையும் வாங்க முடியாது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ధరలు US డాలర్లలో ఉన్నాయి. పేమెంట్లు ఇంకా మొదలవలేదు, కాబట్టి ఈరోజు ఏదీ కొనలేరు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ราคาเป็นดอลลาร์สหรัฐ ยังไม่เปิดให้ชำระเงิน ตอนนี้จึงยังซื้ออะไรไม่ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiyatlar ABD doları cinsinden. Ödemeler henüz açılmadı, yani bugün bir şey satın alınamıyor."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ціни в доларах США. Оплата ще недоступна, тож поки що нічого купити не можна."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قیمتیں امریکی ڈالر میں ہیں۔ ادائیگیاں ابھی شروع نہیں ہوئیں، اس لیے آج کچھ خریدا نہیں جا سکتا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giá tính bằng đô la Mỹ. Chưa mở thanh toán nên hôm nay chưa mua được gì."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "价格以美元计。目前还没开放付款，暂时买不了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "價格以美元計價。目前尚未開放付款，所以現在還買不到。"
          }
        }
      }
    },
