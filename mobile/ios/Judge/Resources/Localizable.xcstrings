    "app.example.lastSlice.b" : {
      "comment" : "Generated by mobile/shared/strings/export-strings.ts from lib/i18n.ts. Do not edit.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يصح أن تقول «هذه لي» ثم لا تلمسها ساعتين. ظلّت في مكانها تبرد، فأكلتها أنا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“আমার” বলে দুই ঘণ্টা ছুঁয়েও না দেখলে তো হবে না। ওটা পড়ে পড়ে ঠান্ডা হচ্ছিল, তাই খেয়ে ফেলেছি।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No pots dir que és teu i després passar-te dues hores sense tocar-lo. Era allà refredant-se, així que me'l vaig menjar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nemůžeš si něco zabrat a pak na to dvě hodiny nesáhnout. Jen to tam leželo a chladlo, tak jsem to snědla."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Man kan ikke kalde det sit og så lade det ligge i to timer. Det lå bare og blev koldt, så jeg spiste det."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst nicht „meins!“ rufen und es dann zwei Stunden nicht anrühren. Es lag nur rum und wurde kalt, also hab ich’s gegessen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν γίνεται να λες «δικό μου» και μετά να μην το αγγίζεις δύο ώρες. Καθόταν εκεί και κρύωνε, οπότε το έφαγα."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can't call dibs and then not touch it for two hours. It was just sitting there going cold, so I ate it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No puedes decir que es tuya y luego no tocarla en dos horas. Estaba ahí enfriándose, así que me la comí."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ei voi varata palaa ja sitten jättää sitä koskematta kahdeksi tunniksi. Se vain jäähtyi siinä, joten söin sen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu ne peux pas réserver une part et ne pas y toucher pendant deux heures. Elle était là à refroidir, alors je l’ai mangée."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“મારો” કહીને બે કલાક સુધી હાથ પણ ન લગાડાય. એ ત્યાં પડ્યો પડ્યો ઠંડો થતો હતો, એટલે મેં ખાઈ લીધો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אי אפשר לשריין משולש ואז לא לגעת בו שעתיים. הוא סתם עמד שם והתקרר, אז אכלתי אותו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“मेरा है” बोलकर दो घंटे तक हाथ भी न लगाओ, ऐसे नहीं चलता। वह वहीं पड़ा-पड़ा ठंडा हो रहा था, तो मैंने खा लिया।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne možeš reći „moj je“ i onda ga ne taknuti dva sata. Samo je stajao i hladio se, pa sam ga pojela."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem lehet lestoppolni valamit, aztán két órán át hozzá se nyúlni. Csak ott hűlt, úgyhogy megettem."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nggak bisa dong bilang “punyaku” terus dianggurin dua jam. Pizzanya dibiarkan sampai dingin, jadi aku makan saja."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non puoi dire “è mia” e poi non toccarla per due ore. Era lì che si raffreddava, quindi l'ho mangiata io."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「俺の」って言っておいて、2時間も手をつけないのはなしでしょ。ずっと置きっぱなしで冷めてたから、食べちゃった。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“ನನ್ನದು” ಅಂತ ಹೇಳಿ ಎರಡು ಗಂಟೆ ಮುಟ್ಟದೇ ಇರುವುದು ಸರಿಯಲ್ಲ. ಅದು ಅಲ್ಲೇ ಬಿದ್ದು ತಣ್ಣಗಾಗುತ್ತಿತ್ತು, ಅದಕ್ಕೇ ನಾನು ತಿಂದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "찜만 해 놓고 두 시간 동안 손도 안 대면 어떡해요. 그냥 식어 가고 있길래 제가 먹었어요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“എനിക്കാണ്” എന്ന് പറഞ്ഞിട്ട് രണ്ടു മണിക്കൂർ തൊടാതിരുന്നാൽ പറ്റില്ലല്ലോ. അത് അവിടെയിരുന്ന് തണുത്തുപോകുകയായിരുന്നു, അതുകൊണ്ട് ഞാൻ കഴിച്ചു."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“माझा” म्हणायचे आणि मग दोन तास त्याला हातही लावायचा नाही, असे चालत नाही. तो तिथेच पडून थंड होत होता, म्हणून मी खाल्ला."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Takkanlah cop lepas tu dua jam tak sentuh. Dah sejuk terbiar kat situ, jadi saya makanlah."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan ikke tinge noe og så la det ligge urørt i to timer. Det lå bare der og ble kaldt, så jeg spiste det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt niet roepen dat het van jou is en het dan twee uur laten liggen. Het lag daar maar koud te worden, dus ik heb het opgegeten."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“ମୋର” କହି ଦୁଇ ଘଣ୍ଟା ଛୁଇଁବ ନାହିଁ, ଏମିତି ଚଳେ ନାହିଁ। ସେଇଟା ସେଠି ପଡ଼ି ପଡ଼ି ଥଣ୍ଡା ହେଉଥିଲା, ତେଣୁ ମୁଁ ଖାଇଦେଲି।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“ਮੇਰਾ” ਕਹਿ ਕੇ ਫਿਰ ਦੋ ਘੰਟੇ ਹੱਥ ਨਾ ਲਾਉਣਾ, ਇਹ ਨਹੀਂ ਚੱਲਦਾ। ਉਹ ਉੱਥੇ ਪਿਆ-ਪਿਆ ਠੰਢਾ ਹੋ ਰਿਹਾ ਸੀ, ਤਾਂ ਮੈਂ ਖਾ ਲਿਆ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie możesz czegoś zaklepać, a potem nie tknąć tego przez dwie godziny. Leżał tam i stygł, więc go zjadłam."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não vale falar que é seu e passar duas horas sem encostar. Estava lá esfriando, aí eu comi."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não podes dizer que é tua e depois não lhe tocar durante duas horas. Estava ali a arrefecer, por isso comi-a."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nu poți s-o declari a ta și apoi să n-o atingi două ore. Stătea acolo și se răcea, așa că am mâncat-o eu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нельзя застолбить кусок и два часа к нему не притрагиваться. Он просто лежал и остывал, вот я его и съел."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nemôžeš si niečo zabrať a potom sa toho dve hodiny ani nedotknúť. Ležalo to tam a chladlo, tak som to zjedla."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne moreš si rezervirati kosa in se ga potem dve uri ne dotakniti. Kar ležal je tam in se hladil, zato sem ga pojedla."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Man kan inte paxa något och sedan inte röra det på två timmar. Den låg bara där och kallnade, så jag åt upp den."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“எனக்குத்தான்” என்று சொல்லிவிட்டு இரண்டு மணி நேரம் அதைத் தொடாமலே இருந்தால் எப்படி? அது அங்கேயே ஆறிக்கொண்டிருந்தது, அதனால் நான் சாப்பிட்டேன்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“నాది” అని చెప్పి రెండు గంటలు దాన్ని ముట్టుకోకపోతే ఎలా? అది అలాగే పడి చల్లారిపోతుంటే నేను తినేశాను."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จองแล้วปล่อยทิ้งไว้ 2 ชั่วโมงไม่แตะเลยแบบนี้ไม่นับนะ วางอยู่ตรงนั้นจนเย็นชืด เราก็เลยกินซะเลย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Benim\" deyip iki saat dokunmamak olmaz. Orada soğuyup duruyordu, ben de yedim."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не можна застовпити шматок і дві години його не чіпати. Він просто лежав і холонув, тож я його з’їла."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یہ نہیں چلتا کہ “میرا ہے” کہہ کر دو گھنٹے ہاتھ بھی نہ لگاؤ۔ وہ وہیں پڑا ٹھنڈا ہو رہا تھا، تو میں نے کھا لیا۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xí rồi để đó hai tiếng không đụng tới thì không tính. Nó nằm đó nguội ngắt, nên mình ăn luôn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "说了“是我的”，然后两个小时都不碰，这可不行。放在那儿都凉了，我就吃了。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "喊了「我的」卻兩個小時都不碰，哪有這樣的。披薩放在那邊都快冷掉了，我就吃掉了。"
          }
        }
      }
    },
