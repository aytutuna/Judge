        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquest enllaç d'invitació no funciona. Potser s'ha desactivat o n'hi falta un tros."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenhle odkaz na pozvánku nefunguje. Možná byl vypnutý, nebo z něj kus chybí."
          }
