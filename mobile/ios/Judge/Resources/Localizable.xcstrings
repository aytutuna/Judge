        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଏଠାରେ ୱେବ୍‌ରେ ଯାଞ୍ଚ ହେବା ଭଳି କିଛି ନାହିଁ: ଏଥିର ତଥ୍ୟ କେବଳ ଜଡ଼ିତ ଲୋକଙ୍କ ଭିତରେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਇੱਥੇ ਵੈੱਬ ’ਤੇ ਜਾਂਚਣ ਲਈ ਕੁਝ ਨਹੀਂ ਸੀ: ਇਸ ਦੇ ਤੱਥ ਉਨ੍ਹਾਂ ਲੋਕਾਂ ਵਿਚਾਲੇ ਦੀ ਗੱਲ ਹਨ ਜੋ ਇਸ ਵਿੱਚ ਸ਼ਾਮਲ ਹਨ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nic tu nie da się sprawdzić w sieci: fakty w tej sprawie znają tylko zaangażowane osoby."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada aqui dava para checar na web: os fatos desta ficam entre as pessoas envolvidas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aqui não há nada que se possa verificar na web: os factos desta ficam entre as pessoas envolvidas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimic de aici nu se putea verifica pe web: faptele din disputa asta îi privesc doar pe cei implicați."
