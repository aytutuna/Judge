        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "નામ સેવ ન થઈ શક્યાં. ફરી પ્રયાસ કરો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "לא הצלחנו לשמור את השמות. אפשר לנסות שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नाम सेव नहीं हो पाए। फिर कोशिश करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nismo uspjeli spremiti imena. Pokušaj ponovno."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem sikerült menteni a neveket. Próbáld újra."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nama gagal disimpan. Coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non siamo riusciti a salvare i nomi. Riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名前を保存できませんでした。もう一度お試しください。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಹೆಸರುಗಳನ್ನು ಉಳಿಸಲು ಆಗಲಿಲ್ಲ. ಮತ್ತೆ ಪ್ರಯತ್ನಿಸಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이름을 저장하지 못했어요. 다시 시도해 주세요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "പേരുകൾ സേവ് ചെയ്യാനായില്ല. വീണ്ടും ശ്രമിക്കൂ."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नावे सेव्ह करता आली नाहीत. पुन्हा प्रयत्न करा."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kami tidak dapat menyimpan nama. Cuba lagi."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi fikk ikke lagret navnene. Prøv igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We konden de namen niet opslaan. Probeer het opnieuw."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ନାମ ସେଭ୍ କରିପାରିଲୁ ନାହିଁ। ପୁଣି ଚେଷ୍ଟା କରନ୍ତୁ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਨਾਂ ਸੇਵ ਨਹੀਂ ਹੋ ਸਕੇ। ਦੁਬਾਰਾ ਕੋਸ਼ਿਸ਼ ਕਰੋ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się zapisać imion. Spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não conseguimos salvar os nomes. Tente de novo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não conseguimos guardar os nomes. Tenta outra vez."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N-am putut salva numele. Încearcă din nou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось сохранить имена. Попробуйте ещё раз."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mená sa nepodarilo uložiť. Skús to znova."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imen nismo mogli shraniti. Poskusi znova."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi kunde inte spara namnen. Försök igen."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "பெயர்களைச் சேமிக்க முடியவில்லை. மீண்டும் முயலுங்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "పేర్లు సేవ్ చేయలేకపోయాం. మళ్లీ ప్రయత్నించండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บันทึกชื่อไม่ได้ ลองอีกครั้ง"
