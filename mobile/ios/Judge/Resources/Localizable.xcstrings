        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tento odkaz s pozvánkou nefunguje. Možno bol vypnutý alebo z neho kus chýba."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta povezava za povabilo ne deluje. Morda je izklopljena ali pa ji manjka del."
