    "placeholder" : {
      "comment" : "Generated by mobile/shared/strings/export-strings.ts from lib/i18n.ts. Do not edit.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ماذا حدث؟ مَن يقول ماذا، ولماذا؟\n\nاكتب رواية الطرف الآخر كما كان سيرويها هو. وفي كل الأحوال، يبني القضاة أقوى حجة لكلا الطرفين."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কী হয়েছিল? কে কী বলছে, আর কেন?\n\nঅন্যজনের কথাটা তিনি যেভাবে বলতেন, সেভাবেই লিখুন। বিচারকেরা এমনিতেও দুই পক্ষেরই সবচেয়ে জোরালো যুক্তি দাঁড় করান।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Què va passar? Qui diu què, i per què?\n\nExplica la postura de l'altra persona tal com ho faria ella. De totes maneres, els jutges presenten totes dues postures en la seva versió més sòlida."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Co se stalo? Kdo co tvrdí a proč?\n\nPopiš i pohled druhé strany tak, jak by to řekla ona. Soudci tak jako tak postaví za obě strany co nejsilnější argumenty."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvad skete der? Hvem siger hvad, og hvorfor?\n\nSkriv også den andens side, sådan som den anden selv ville fortælle den. Dommerne fremstiller under alle omstændigheder begge sider så stærkt som muligt."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was ist passiert? Wer sagt was, und warum?\n\nGib die Sicht der anderen Person so wieder, wie sie es sagen würde. Die Richter suchen so oder so für beide Seiten die stärksten Argumente."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Τι έγινε; Ποιος λέει τι και γιατί;\n\nΓράψε και την άποψη του άλλου όπως θα την έλεγε ο ίδιος. Οι κριτές έτσι κι αλλιώς χτίζουν την πιο δυνατή εκδοχή και για τις δύο πλευρές."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What happened? Who says what, and why?\n\nPut the other person's side the way they'd say it. The judges build the strongest case for both sides either way."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué pasó? ¿Quién dice qué y por qué?\n\nCuenta la postura de la otra persona como la contaría ella. De todos modos, los jueces presentan cada postura en su versión más sólida."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitä tapahtui? Kuka sanoo mitä ja miksi?\n\nKirjoita toisen kanta niin kuin hän itse sen sanoisi. Tuomarit rakentavat joka tapauksessa kummallekin puolelle vahvimman mahdollisen perustelun."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qu’est-ce qui s’est passé ? Qui dit quoi, et pourquoi ?\n\nDonne aussi la version d’en face, telle que l’autre la raconterait. De toute façon, les juges construisent la meilleure défense possible pour chaque camp."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "શું થયું? કોણ શું કહે છે, અને કેમ?\n\nસામેવાળાની વાત પણ એ જે રીતે કહે એ રીતે લખો. જજ આમેય બંને બાજુની સૌથી મજબૂત દલીલ તૈયાર કરે છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מה קרה? מי אומר מה, ולמה?\n\nכדאי לתאר את הצד השני במילים שלו. השופטים ממילא בונים את הטיעון הכי חזק לכל צד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्या हुआ? कौन क्या कह रहा है, और क्यों?\n\nसामने वाले की बात वैसे ही लिखें जैसे वे ख़ुद कहते। जज वैसे भी दोनों पक्षों की सबसे मज़बूत दलील तैयार करते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Što se dogodilo? Tko što tvrdi i zašto?\n\nNapiši i stajalište druge osobe onako kako bi ga ona iznijela. Suci ionako za obje strane sastavljaju najjači mogući argument."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mi történt? Ki mit mond, és miért?\n\nA másik fél álláspontját úgy írd le, ahogy ő mondaná. A bírák így is, úgy is mindkét oldal mellett a lehető legerősebb érveket sorakoztatják fel."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apa yang terjadi? Siapa bilang apa, dan kenapa?\n\nTulis versi pihak lain seperti yang akan dia katakan sendiri. Apa pun yang kamu tulis, para hakim tetap menyusun argumen terkuat untuk kedua pihak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cos'è successo? Chi dice cosa, e perché?\n\nRiporta la posizione dell'altra persona come la racconterebbe lei. I giudici costruiscono comunque la versione più forte di entrambe le parti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何がありましたか？　誰が何を、なぜ言っていますか？\n\n相手の言い分も、相手が言いそうな形で書いてください。どのみち審査員は、両方の言い分をいちばん強い形にしてから検討します。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಏನಾಯಿತು? ಯಾರು ಏನು ಹೇಳುತ್ತಾರೆ, ಯಾಕೆ?\n\nಎದುರಿನವರ ವಾದವನ್ನು ಅವರು ಹೇಳುವ ಹಾಗೆಯೇ ಬರೆಯಿರಿ. ಹೇಗಿದ್ದರೂ ತೀರ್ಪುಗಾರರು ಎರಡೂ ಕಡೆಯ ವಾದವನ್ನು ಅತ್ಯಂತ ಬಲವಾದ ರೂಪದಲ್ಲಿ ಕಟ್ಟುತ್ತಾರೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무슨 일이 있었나요? 누가 뭐라고 하는지, 왜 그렇게 생각하는지 써 주세요.\n\n상대방 입장도 그 사람이 말할 법한 그대로 적어 주세요. 어떻게 쓰든 판사들은 양쪽 주장을 가장 설득력 있는 형태로 다시 세워 봐요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "എന്താണ് സംഭവിച്ചത്? ആര് എന്ത് പറയുന്നു, എന്തുകൊണ്ട്?\n\nമറ്റേയാളുടെ ഭാഗം അവർ പറയുന്നതുപോലെ തന്നെ എഴുതൂ. എന്തായാലും രണ്ടു ഭാഗത്തിനും വേണ്ടി ഏറ്റവും ശക്തമായ വാദം ജഡ്ജിമാർ തന്നെ ഒരുക്കും."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "काय घडले? कोण काय म्हणते, आणि का?\n\nसमोरच्याची बाजू ते जशी मांडतील तशीच लिहा. परीक्षक तसेही दोन्ही बाजूंची सर्वात भक्कम मांडणी करतात."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apa yang berlaku? Siapa kata apa, dan kenapa?\n\nTulis pandangan pihak satu lagi seperti yang dia sendiri akan katakan. Walau apa pun, hakim akan membina hujah paling kuat untuk kedua-dua pihak."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hva skjedde? Hvem sier hva, og hvorfor?\n\nGjengi den andres syn slik vedkommende selv ville sagt det. Dommerne gjør uansett begge sider så sterke som mulig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wat is er gebeurd? Wie zegt wat, en waarom?\n\nBeschrijf de kant van de ander zoals die het zelf zou zeggen. De rechters zetten hoe dan ook beide kanten zo sterk mogelijk neer."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "କ'ଣ ହେଲା? କିଏ କ'ଣ କହୁଛି, ଆଉ କାହିଁକି?\n\nଅନ୍ୟ ଜଣଙ୍କ କଥା ସେ ଯେମିତି କହନ୍ତେ ସେମିତି ଲେଖନ୍ତୁ। ବିଚାରକମାନେ ଯେମିତି ହେଉ ଦୁଇ ପକ୍ଷର ସବୁଠୁ ମଜବୁତ ଯୁକ୍ତି ଗଢ଼ନ୍ତି।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਕੀ ਹੋਇਆ? ਕੌਣ ਕੀ ਕਹਿੰਦਾ ਹੈ, ਅਤੇ ਕਿਉਂ?\n\nਦੂਜੀ ਧਿਰ ਦੀ ਗੱਲ ਉਵੇਂ ਹੀ ਲਿਖੋ ਜਿਵੇਂ ਉਹ ਆਪ ਕਹਿਣਗੇ। ਜੱਜ ਹਰ ਹਾਲ ਵਿੱਚ ਦੋਵਾਂ ਪੱਖਾਂ ਨੂੰ ਉਨ੍ਹਾਂ ਦੇ ਸਭ ਤੋਂ ਤਕੜੇ ਰੂਪ ਵਿੱਚ ਰੱਖਦੇ ਹਨ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Co się stało? Kto co mówi i dlaczego?\n\nOpisz stanowisko drugiej osoby tak, jak sama by je przedstawiła. Sędziowie i tak zbudują najmocniejsze argumenty dla obu stron."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que aconteceu? Quem diz o quê, e por quê?\n\nConte o lado da outra pessoa do jeito que ela contaria. De qualquer forma, os juízes montam a versão mais forte dos dois lados."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que aconteceu? Quem diz o quê, e porquê?\n\nConta o lado da outra pessoa como ela o contaria. Seja como for, os juízes montam a melhor defesa para os dois lados."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce s-a întâmplat? Cine ce susține și de ce?\n\nScrie varianta celeilalte persoane așa cum ar spune-o ea. Judecătorii construiesc oricum cel mai puternic argument pentru ambele părți."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Что случилось? Кто что говорит и почему?\n\nОпишите позицию другого человека так, как её описал бы он сам. Судьи в любом случае выстроят самые сильные доводы для обеих сторон."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Čo sa stalo? Kto tvrdí čo a prečo?\n\nNapíš aj pohľad druhej strany tak, ako by ho podala ona. Sudcovia tak či tak zostavia čo najsilnejšie argumenty pre obe strany."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaj se je zgodilo? Kdo kaj trdi in zakaj?\n\nPlat druge osebe napiši tako, kot bi jo povedala sama. Sodniki tako ali tako za obe plati sestavijo najmočnejši argument."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vad hände? Vem säger vad, och varför?\n\nBeskriv den andras sida så som hen själv skulle säga det. Domarna bygger ändå upp den starkaste versionen av båda sidor."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "என்ன நடந்தது? யார் என்ன சொல்கிறார்கள், ஏன்?\n\nமற்றவரின் தரப்பை அவரே சொல்வது போல் எழுதுங்கள். எப்படியிருந்தாலும் நடுவர்கள் இரு தரப்புக்கும் வலுவான வாதத்தை உருவாக்குவார்கள்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఏం జరిగింది? ఎవరు ఏమంటున్నారు, ఎందుకు?\n\nఅవతలి వ్యక్తి వాదనను వాళ్లు ఎలా చెబుతారో అలాగే రాయండి. ఎలాగూ జడ్జీలు రెండు వైపుల వాదననూ వీలైనంత బలంగా నిలబెడతారు."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เกิดอะไรขึ้น? ใครพูดว่าอะไร และเพราะอะไร?\n\nเล่าฝั่งของอีกคนแบบที่เขาจะพูดเอง ยังไงกรรมการก็จะหาเหตุผลที่หนักแน่นที่สุดให้ทั้งสองฝ่าย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne oldu? Kim ne diyor, neden?\n\nKarşı tarafın görüşünü onun anlatacağı gibi yaz. Yargıçlar zaten iki tarafı da en güçlü hâliyle ele alır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Що сталося? Хто що каже і чому?\n\nОпиши позицію іншої людини так, як її сформулювала б вона сама. Судді все одно вибудують найсильнішу версію для обох сторін."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کیا ہوا؟ کون کیا کہتا ہے، اور کیوں؟\n\nدوسرے کی بات ویسے ہی لکھیں جیسے وہ خود کہتے۔ جج ہر حال میں دونوں طرف کی مضبوط ترین دلیل تیار کرتے ہیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chuyện gì đã xảy ra? Ai nói gì, vì sao?\n\nHãy kể cả lý lẽ của bên kia, theo đúng cách họ sẽ nói. Dù thế nào, giám khảo cũng sẽ dựng lập luận mạnh nhất cho cả hai bên."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "发生了什么？谁怎么说，为什么？\n\n对方的观点，也照对方自己的口吻写上。无论如何，评委都会替双方把理由讲到最有力。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "發生了什麼事？誰說了什麼、為什麼？\n\n把對方的說法照對方會講的方式寫出來。反正評審都會替雙方找出最有力的論點。"
          }
        }
      }
    },
