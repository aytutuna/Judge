    "mode.nowHint" : {
      "comment" : "Generated by mobile/shared/strings/export-strings.ts from lib/i18n.ts. Do not edit.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ترويها أنت، ويحكم القضاة فورًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি বলবেন, বিচারকেরা সঙ্গে সঙ্গে রায় দেবেন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu ho expliques i els jutges decideixen a l'instant."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Popíšeš to ty a soudci rozhodnou hned."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du fortæller, og dommerne dømmer med det samme."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du erzählst, die Richter urteilen sofort."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το λες εσύ και οι κριτές αποφασίζουν αμέσως."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You tell it, and the judges rule right away."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tú lo cuentas y los jueces deciden enseguida."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinä kerrot, ja tuomarit ratkaisevat heti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu racontes, et les juges tranchent tout de suite."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "તમે કહો, અને જજ તરત ચુકાદો આપે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מספרים, והשופטים מכריעים מיד."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप बताएँ, और जज तुरंत फ़ैसला कर देंगे।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti ispričaš, a suci odmah presude."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te elmondod, a bírák pedig azonnal döntenek."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamu yang cerita, hakim langsung memutuskan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Racconti tu, e i giudici decidono subito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたが書いて、審査員がすぐに判定します。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನೀವು ಹೇಳುತ್ತೀರಿ, ತೀರ್ಪುಗಾರರು ತಕ್ಷಣ ತೀರ್ಪು ಕೊಡುತ್ತಾರೆ."
