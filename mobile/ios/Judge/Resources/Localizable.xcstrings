    "app.example.seat.b" : {
      "comment" : "Generated by mobile/shared/strings/export-strings.ts from lib/i18n.ts. Do not edit.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "طولي 190 سم، وركبتاي ملتصقتان بمقعدك أصلًا. كان يمكنك على الأقل أن تسألي قبل أن تُميليه إلى آخره."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আমি 6 ফুট 3 ইঞ্চি লম্বা, হাঁটু এমনিতেই আপনার সিটে ঠেকে আছে। একদম পেছনে নামানোর আগে অন্তত একবার জিজ্ঞেস করতে পারতেন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faig 1,90 i ja tinc els genolls clavats al teu seient. Com a mínim podries preguntar abans de tirar-lo del tot enrere."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Měřím metr devadesát a kolena už teď opírám o tvoje sedadlo. Mohla ses aspoň zeptat, než jsi ho sklopila úplně dozadu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeg er 1,91, og mine knæ trykker allerede mod dit sæde. Du kunne i det mindste have spurgt, før du lænede det helt tilbage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich bin 1,90 m groß, und meine Knie drücken jetzt schon gegen deinen Sitz. Du könntest wenigstens fragen, bevor du die Lehne ganz nach hinten kippst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Είμαι 1,90 και τα γόνατά μου ήδη ακουμπάνε στη θέση σου. Θα μπορούσες τουλάχιστον να ρωτήσεις πριν τη ρίξεις τελείως πίσω."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I'm 6'3\" and my knees are already pressed into your seat. You could at least ask before dropping it all the way back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mido un metro noventa y ya tengo las rodillas pegadas a tu asiento. Por lo menos podrías preguntar antes de echarlo del todo hacia atrás."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olen 190-senttinen, ja polveni painavat jo valmiiksi penkkiäsi. Olisit voinut edes kysyä, ennen kuin laskit selkänojan ihan pohjaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je mesure 1,90 m et mes genoux sont déjà collés à ton siège. Tu aurais au moins pu demander avant de le baisser à fond."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "મારી હાઇટ 6 ફૂટ 3 ઇંચ છે, અને મારા ઘૂંટણ પહેલેથી તમારી સીટમાં દબાય છે. છેક પાછળ નમાવતાં પહેલાં ઓછામાં ઓછું પૂછી તો શકો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אני מטר תשעים, והברכיים שלי כבר תקועות בגב המושב שלך. יכולת לפחות לשאול לפני שהורדת אותו עד הסוף."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मेरा कद 6 फ़ुट 3 इंच है और मेरे घुटने पहले ही आपकी सीट में गड़ रहे हैं। सीट पूरी पीछे करने से पहले आप कम से कम पूछ तो सकती थीं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visok sam 190 cm i koljena mi se već zabijaju u tvoje sjedalo. Mogla si me barem pitati prije nego što ga spustiš do kraja."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "190 centi vagyok, és a térdem már így is az ülésednek nyomódik. Legalább megkérdezhetnéd, mielőtt teljesen hátradöntöd."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tinggiku 190 cm dan lututku sudah menempel ke kursimu. Paling nggak tanya dulu sebelum merebahkannya sampai mentok."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sono alto 1,90 e ho già le ginocchia schiacciate contro il tuo sedile. Potevi almeno chiedere prima di abbassarlo fino in fondo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "身長が190cmあって、膝がもう前の座席に当たっているんです。いちばん後ろまで倒す前に、ひと言くらい声をかけてくれてもいいでしょう。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ನಾನು 190 ಸೆಂ.ಮೀ. ಎತ್ತರ ಇದ್ದೇನೆ, ನನ್ನ ಮಂಡಿಗಳು ಈಗಾಗಲೇ ನಿಮ್ಮ ಸೀಟಿಗೆ ಒತ್ತಿಕೊಂಡಿವೆ. ಪೂರ್ತಿ ಹಿಂದಕ್ಕೆ ಬಾಗಿಸುವ ಮೊದಲು ಕನಿಷ್ಠ ಒಂದು ಮಾತು ಕೇಳಬಹುದಿತ್ತು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저는 키가 190cm라 무릎이 이미 앞좌석에 닿아 있어요. 끝까지 젖히기 전에 한마디라도 물어볼 수 있었잖아요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "എനിക്ക് 190 സെന്റിമീറ്റർ പൊക്കമുണ്ട്, എന്റെ മുട്ടുകൾ ഇപ്പോൾ തന്നെ നിങ്ങളുടെ സീറ്റിൽ തട്ടിനിൽക്കുകയാണ്. മുഴുവനായി പിന്നോട്ട് ചായ്ക്കും മുമ്പ് ഒന്ന് ചോദിക്കുകയെങ്കിലും ചെയ്യാമായിരുന്നു."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "माझी उंची 190 सेंमी आहे आणि माझे गुडघे आधीच तुझ्या सीटला टेकले आहेत. सीट पूर्ण मागे ढकलण्याआधी निदान एकदा विचारायला तरी हवे होते."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saya tinggi 190 cm dan lutut saya dah tertekan pada kerusi awak. Sekurang-kurangnya tanyalah dulu sebelum rebahkan sampai habis."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeg er 191 cm, og knærne mine presser allerede mot setet ditt. Du kunne i det minste spurt før du la det helt bakover."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ik ben 1,91 m en mijn knieën zitten nu al tegen je stoel. Je kunt op z'n minst even vragen voordat je hem helemaal naar achteren zet."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ମୁଁ 6 ଫୁଟ 3 ଇଞ୍ଚ ଡେଙ୍ଗା, ମୋ ଆଣ୍ଠୁ ଆଗରୁ ଆପଣଙ୍କ ସିଟ୍‌ରେ ଚିପି ହେଉଛି। ପୂରା ପଛକୁ ଢଳାଇବା ଆଗରୁ ଅନ୍ତତଃ ଥରେ ପଚାରିପାରିଥାନ୍ତେ।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਮੇਰਾ ਕੱਦ 6 ਫ਼ੁੱਟ 3 ਇੰਚ ਹੈ ਅਤੇ ਮੇਰੇ ਗੋਡੇ ਪਹਿਲਾਂ ਹੀ ਤੁਹਾਡੀ ਸੀਟ ਨਾਲ ਲੱਗੇ ਹੋਏ ਹਨ। ਪੂਰੀ ਪਿੱਛੇ ਕਰਨ ਤੋਂ ਪਹਿਲਾਂ ਘੱਟੋ-ਘੱਟ ਪੁੱਛ ਤਾਂ ਲੈਂਦੇ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mam 190 cm wzrostu, a kolana i tak już wbijają mi się w twój fotel. Mogłaś chociaż zapytać, zanim odchyliłaś go do oporu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eu tenho 1,90 m e meus joelhos já estão encostados na sua poltrona. Você podia pelo menos perguntar antes de reclinar tudo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tenho 1,90 m e já tenho os joelhos encostados ao teu assento. Podias ao menos perguntar antes de o reclinares todo para trás."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Am 1,90 m și am deja genunchii lipiți de scaunul tău. Puteai măcar să întrebi înainte să-l lași complet pe spate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У меня рост 190, колени и так упираются в твоё кресло. Могла бы хоть спросить, прежде чем откидывать его до упора."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mám 190 centimetrov a kolená mám už teraz zapreté o tvoje sedadlo. Mohla si sa aspoň opýtať, skôr než si ho sklopila úplne dozadu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visok sem 1,91 m in s koleni že tako tiščim v tvoj sedež. Lahko bi vsaj vprašala, preden ga spustiš čisto nazaj."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jag är 191 cm lång och knäna trycker redan mot ditt säte. Du kunde åtminstone fråga innan du fäller det ända bak."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "நான் 190 செ.மீ. உயரம், என் முழங்கால்கள் ஏற்கெனவே உங்கள் சீட்டில் அழுந்திக்கொண்டிருக்கின்றன. முழுவதுமாகப் பின்னால் சாய்ப்பதற்கு முன் ஒரு வார்த்தை கேட்டிருக்கலாமே."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "నేను ఆరడుగుల పైనే ఉంటాను, నా మోకాళ్లు ఇప్పటికే మీ సీటుకు ఆనుకుని ఉన్నాయి. పూర్తిగా వెనక్కి వాల్చే ముందు కనీసం ఒక మాట అడగొచ్చు కదా."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เราสูงตั้ง 190 เซนติเมตร เข่าก็ดันเบาะข้างหน้าอยู่แล้ว จะเอนสุดก็น่าจะถามกันก่อนสักคำ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boyum 1,90, dizlerim zaten koltuğuna değiyor. Sonuna kadar yatırmadan önce en azından sorabilirdin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У мене зріст 191 см, і коліна вже впираються в твоє крісло. Можна було б хоча б спитати, перш ніж відкидати його до кінця."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "میرا قد 6 فٹ 3 انچ ہے اور میرے گھٹنے پہلے ہی آپ کی سیٹ سے لگے ہوئے ہیں۔ سیٹ پوری پیچھے کرنے سے پہلے کم از کم پوچھ تو سکتی تھیں۔"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mình cao 1m90, đầu gối đã tì sát vào lưng ghế bạn rồi. Ít ra bạn cũng nên hỏi trước khi ngả hết cỡ chứ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我身高一米九，膝盖本来就顶着你的椅背了。你一下子放到底之前，至少问一声吧。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我身高 190 公分，膝蓋早就頂到你的椅背了。你要整個倒到底之前，至少可以先問一下吧。"
          }
        }
      }
    },
