        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invitationslinket virker ikke. Det er måske slået fra, eller en del af det mangler."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Einladungslink funktioniert nicht. Vielleicht wurde er deaktiviert, oder ein Teil fehlt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτός ο σύνδεσμος πρόσκλησης δεν λειτουργεί. Ίσως απενεργοποιήθηκε ή λείπει κάποιο κομμάτι του."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This invite link doesn't work. It may have been turned off, or part of it is missing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este enlace de invitación no funciona. Puede que se haya desactivado o que le falte una parte."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä kutsulinkki ei toimi. Se on ehkä poistettu käytöstä, tai osa siitä puuttuu."
