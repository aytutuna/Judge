          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "মামলাটা খুঁজে পাওয়া গেল না। হয়তো মুছে ফেলা হয়েছে, বা এটা অন্য কোনো অ্যাকাউন্টের।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hem trobat aquest cas. Potser s'ha eliminat o és d'un altre compte."
