    "appeal.refused" : {
      "comment" : "Generated by mobile/shared/strings/export-strings.ts from lib/i18n.ts. Do not edit.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رفض القضاة إعادة النظر بهذا التوضيح. عاد الحكم المخصوم إلى رصيدك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই তথ্য নিয়ে বিচারকেরা আবার বিচার করতে রাজি হননি। আপনার ক্রেডিট ফেরত এসেছে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els jutges no han volgut tornar a jutjar amb aquest context. T'hem tornat el crèdit."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S tímhle kontextem soudci znovu soudit odmítli. Kredit se ti vrátil."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dommerne ville ikke dømme igen med den kontekst. Du har fået din kredit tilbage."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Richter wollten mit diesem Kontext nicht neu urteilen. Dein Credit ist wieder da."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι κριτές δεν δέχτηκαν νέα κρίση με αυτές τις πληροφορίες. Η χρέωση ακυρώθηκε."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The judges wouldn't re-judge with that context. Your credit is back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los jueces no quisieron volver a juzgar con ese contexto. Te hemos devuelto el crédito."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuomarit eivät suostuneet ratkaisemaan uudelleen noilla tiedoilla. Tuomio palautettiin saldoosi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les juges ont refusé de rejuger avec ce contexte. Ton crédit t’a été rendu."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "જજોએ એ વિગત સાથે ફરી ફેંસલો કરવાની ના પાડી. તમારી ક્રેડિટ પાછી આવી ગઈ."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "השופטים סירבו לשפוט מחדש עם ההקשר הזה. הקרדיט חזר לחשבון."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जजों ने इस जानकारी के साथ दोबारा फ़ैसला करने से मना कर दिया। आपका क्रेडिट वापस आ गया है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suci nisu htjeli ponovno presuditi s tim kontekstom. Kredit ti je vraćen."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A bírák ezzel a kiegészítéssel nem voltak hajlandók újra dönteni. Visszakaptad a kreditedet."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hakim menolak menilai ulang dengan konteks itu. Kreditmu sudah kembali."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I giudici non hanno voluto rivalutare con quel contesto. Il tuo credito è tornato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "審査員はこの補足での再判定を見送りました。クレジットは戻りました。"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಆ ವಿವರದೊಂದಿಗೆ ಮರುತೀರ್ಪು ಕೊಡಲು ತೀರ್ಪುಗಾರರು ಒಪ್ಪಲಿಲ್ಲ. ನಿಮ್ಮ ಕ್ರೆಡಿಟ್ ವಾಪಸ್ ಬಂದಿದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "판사들이 이 맥락으로는 다시 판결하지 않기로 했어요. 크레딧을 돌려 드렸어요."
          }
        },
        "ml" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ആ വിവരം വെച്ച് വീണ്ടും വിധിക്കാൻ ജഡ്ജിമാർ തയ്യാറായില്ല. നിങ്ങളുടെ ക്രെഡിറ്റ് തിരികെ കിട്ടി."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "त्या माहितीसह परीक्षकांनी पुन्हा निकाल द्यायला नकार दिला. तुमचे क्रेडिट परत आले."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hakim tidak mahu menilai semula dengan konteks itu. Kredit anda sudah dikembalikan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dommerne ville ikke dømme på nytt med den konteksten. Du har fått kreditten tilbake."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De rechters wilden met die aanvulling niet opnieuw oordelen. Je credit is terug."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ବିଚାରକମାନେ ସେହି ବିବରଣୀ ସହ ପୁଣି ବିଚାର କରିବାକୁ ମନା କଲେ। ଆପଣଙ୍କ କ୍ରେଡିଟ୍ ଫେରିଆସିଛି।"
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ਜੱਜਾਂ ਨੇ ਉਸ ਵੇਰਵੇ ਨਾਲ ਦੁਬਾਰਾ ਫ਼ੈਸਲਾ ਕਰਨ ਤੋਂ ਨਾਂਹ ਕਰ ਦਿੱਤੀ। ਤੁਹਾਡਾ ਕ੍ਰੈਡਿਟ ਵਾਪਸ ਆ ਗਿਆ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sędziowie odmówili ponownej oceny z tym kontekstem. Werdykt wrócił do twojej puli."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os juízes não quiseram rejulgar com esse contexto. Seu crédito voltou."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os juízes recusaram-se a julgar de novo com esse contexto. O teu crédito foi devolvido."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Judecătorii n-au vrut să judece din nou cu acest context. Ți-ai primit creditul înapoi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Судьи отказались пересматривать дело с такими подробностями. Вердикт вернулся на баланс."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sudcovia s týmto kontextom odmietli posúdiť spor znova. Kredit sa ti vrátil."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
