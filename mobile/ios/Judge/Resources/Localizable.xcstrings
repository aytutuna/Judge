        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ఒక ఇమేజ్. టెక్స్ట్ చదివి, పేర్లు దాచేస్తాం, ఇమేజ్‌ను ఎప్పుడూ ఉంచుకోం."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพิ่มได้ 1 ภาพ เราอ่านข้อความ ซ่อนชื่อ และไม่เก็บภาพไว้เลย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tek görsel. Yazıyı okuyor, isimleri gizliyor, görseli hiç saklamıyoruz."
