      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رابط الدعوة هذا لا يعمل. ربما أُوقف، أو أن جزءًا منه ناقص."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই আমন্ত্রণ লিংক কাজ করছে না। হয়তো বন্ধ করে দেওয়া হয়েছে, বা লিংকের কিছু অংশ বাদ পড়েছে।"
