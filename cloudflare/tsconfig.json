{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["esnext"],
    "types": ["@cloudflare/workers-types"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "paths": { "@/*": ["../*"] }
  },
  "include": ["*.ts", "../lib/sliding-window.ts", "../lib/worker-env.ts", "../lib/sentry.ts", "../lib/originals/removed.ts", "../lib/body-cap.ts"],
  "exclude": ["env.ts"]
}
