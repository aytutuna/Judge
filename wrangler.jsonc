// Judge on Cloudflare Workers (phase 1: built and proven on staging only).
// Secrets are never listed here; their names are in deploy/cloudflare/README.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "judge",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "judge" }],
  "d1_databases": [{ "binding": "DB", "database_name": "judge", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "judge-backups" }],
  "durable_objects": {
    "bindings": [
      { "name": "RATE_LIMITER", "class_name": "RateLimiter" },
      { "name": "JOBS", "class_name": "JobRunner" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RateLimiter", "JobRunner"] }],
  "triggers": { "crons": ["*/5 * * * *", "17 3 * * *", "30 3 * * *"] },
  // Judging runs for minutes inside a request made by a JobRunner; CPU time
  // only counts while code runs, not while it waits for the AI service.
  "limits": { "cpu_ms": 300000 },
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "vars": { "CLOUDFLARE_PROXY": "1" },

  "env": {
    "staging": {
      "name": "judge-staging",
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "judge-staging" }],
      "d1_databases": [{ "binding": "DB", "database_name": "judge-staging", "migrations_dir": "migrations" }],
      "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "judge-staging-backups" }],
      "durable_objects": {
        "bindings": [
          { "name": "RATE_LIMITER", "class_name": "RateLimiter" },
          { "name": "JOBS", "class_name": "JobRunner" }
        ]
      },
      "triggers": { "crons": ["*/5 * * * *", "17 3 * * *", "30 3 * * *"] },
      "limits": { "cpu_ms": 300000 },
      "observability": { "enabled": true, "logs": { "invocation_logs": false } },
      "vars": { "CLOUDFLARE_PROXY": "1" }
    }
  }
}
