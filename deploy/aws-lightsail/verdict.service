# Verdict web app (Next.js) on 127.0.0.1:3000, behind Caddy.
# Installed to /etc/systemd/system/ by update.sh; edits there are overwritten.
#
# Run exactly ONE instance: rate limits are decided in this process's memory
# (and logged to /run/verdict so a restart keeps them), so a second copy would
# double every limit.

[Unit]
Description=Verdict web app
Documentation=https://github.com/aytutuna/Verdict
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=verdict
Group=verdict
# /opt/verdict/current is a symlink to the active release; it is resolved
# each time the service starts, so a restart picks up a new release.
WorkingDirectory=/opt/verdict/current
EnvironmentFile=/etc/verdict/verdict.env
# V8 heap cap, well under MemoryMax so Node collects garbage before the
# kernel steps in.
Environment=NODE_OPTIONS=--max-old-space-size=256
Environment=NEXT_TELEMETRY_DISABLED=1
# Listen on loopback only: the internet reaches the app through Caddy, never
# directly, so X-Forwarded-For is always Caddy's.
ExecStart=/usr/bin/node /opt/verdict/current/node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3000
Restart=always
RestartSec=5
# On stop, `next start` refuses new connections, then finishes the verdicts
# still judging in the background (after()) before it exits. A verdict ends
# within about 5 minutes, so wait that long instead of killing it; a stop or
# restart takes longer only while something is judging.
TimeoutStopSec=320
# /run/verdict holds the rate-limit log (RATE_LIMIT_DB in the env file). It
# is kept when the app stops or restarts and cleared only by a reboot, and it
# never reaches the disk, backups or snapshots.
RuntimeDirectory=verdict
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes

# 512 MB instance: leave room for Caddy and the OS.
MemoryHigh=350M
MemoryMax=400M

# Hardening. The whole file system is read-only for the app except its
# database directory, /run/verdict and the active release's .next directory
# (Next.js writes its runtime cache under .next).
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/verdict /opt/verdict/current/.next
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=
UMask=0027

[Install]
WantedBy=multi-user.target
