# Error spike check (errors.sh); started every 5 minutes by
# verdict-errors.timer. Installed to /etc/systemd/system/ by update.sh;
# edits there are overwritten.
#
# Runs as root from the root-owned checkout (never from /opt/verdict/current,
# which the app user can write): it reads Caddy's access log and the journal.

[Unit]
Description=Check Judge for error spikes

[Service]
Type=oneshot
EnvironmentFile=/etc/verdict/verdict.env
ExecStart=/usr/bin/bash /opt/verdict/repo/deploy/aws-lightsail/errors.sh
StateDirectory=verdict-alerts
StateDirectoryMode=0700
Nice=10

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
UMask=0077
