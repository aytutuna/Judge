# Runs verdict-cloudflare-ips.service once a week.
# Installed to /etc/systemd/system/ by update.sh only while CLOUDFLARE_PROXY=1;
# edits there are overwritten.

[Unit]
Description=Weekly refresh of the Cloudflare address ranges for Verdict

[Timer]
OnCalendar=weekly
RandomizedDelaySec=6h
# Catch up after the server was off at the scheduled time.
Persistent=true

[Install]
WantedBy=timers.target
