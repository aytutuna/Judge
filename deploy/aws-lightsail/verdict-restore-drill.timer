# Runs verdict-restore-drill.service on the 1st of every month, after that
# night's backup. Installed to /etc/systemd/system/ by update.sh; edits there
# are overwritten.

[Unit]
Description=Monthly Judge restore drill

[Timer]
OnCalendar=*-*-01 05:00:00
RandomizedDelaySec=30min
Persistent=true

[Install]
WantedBy=timers.target
