{
  "receiver": "email",
  "group_by": ["alertname"],
  "repeat_interval": "24h",
  "routes": [
    {
      "receiver": "email",
      "object_matchers": [["alertname", "=~", "DatasourceError|DatasourceNoData"]],
      "repeat_interval": "4h"
    },
    {
      "receiver": "pushover-critical",
      "object_matchers": [["severity", "=", "critical"]],
      "repeat_interval": "1h",
      "continue": true
    },
    {
      "receiver": "ntfy",
      "object_matchers": [["severity", "=", "critical"]],
      "repeat_interval": "1h",
      "continue": true
    },
    {
      "receiver": "email",
      "object_matchers": [["severity", "=", "critical"]],
      "repeat_interval": "1h"
    }
  ]
}
