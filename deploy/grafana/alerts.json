{
  "folder": {
    "uid": "judge",
    "title": "judge"
  },
  "groups": [
    {
      "title": "critical",
      "folderUid": "judge",
      "interval": 60,
      "rules": [
        {
          "uid": "judge-no-metrics",
          "title": "No metrics from the server",
          "folderUID": "judge",
          "ruleGroup": "critical",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "${PROM_UID}",
              "model": {
                "refId": "A",
                "expr": "absent_over_time(up{app=\"judge\"}[3m])",
                "instant": true,
                "range": false
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "A",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "for": "0s",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "severity": "critical"
          },
          "annotations": {
            "summary": "No metrics from the Judge server for 3 minutes: it is down, or Alloy stopped.",
            "description": "If the site still answers, on the server: systemctl status alloy; journalctl -u alloy -n 50. If not, restart the server from the provider's console."
          },
          "isPaused": false
        },
        {
          "uid": "judge-site-down",
          "title": "Site down",
          "folderUID": "judge",
          "ruleGroup": "critical",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "${PROM_UID}",
              "model": {
                "refId": "A",
                "expr": "count by (job, instance) (probe_success{job=~\"judge-site|judge-health\"} == 0)",
                "instant": true,
                "range": false
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "A",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gte",
                      "params": [
                        2
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "for": "3m",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "severity": "critical"
          },
          "annotations": {
            "summary": "{{ $labels.instance }} fails from {{ $values.A.Value }} probes.",
            "description": "On the server: systemctl status verdict caddy; journalctl -u verdict -n 100; journalctl -u caddy -n 50. HTTP 403 while the site works means Cloudflare (Bot Fight Mode or a challenge rule) blocks the probes."
          },
          "isPaused": false
        },
        {
          "uid": "judge-app-alert",
          "title": "App alert",
          "folderUID": "judge",
          "ruleGroup": "critical",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "queryType": "instant",
              "relativeTimeRange": {
                "from": 120,
                "to": 0
              },
              "datasourceUid": "${LOKI_UID}",
              "model": {
                "refId": "A",
                "expr": "sum by (kind) (count_over_time({app=\"judge\", unit=\"verdict.service\"} |= \"[alert:\" | regexp `^\\[alert:(?P<kind>[a-z_]+)\\]` [2m]))",
                "queryType": "instant"
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "A",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "for": "0s",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "severity": "critical"
          },
          "annotations": {
            "summary": "The app logged [alert:{{ $labels.kind }}].",
            "description": "provider_credit: add credit or raise the spend limit in the provider's console. provider_auth: put a working ANTHROPIC_API_KEY in /etc/verdict/verdict.env (on HTTP 403, check the key's workspace and permissions), then sudo systemctl restart verdict. provider_config: fix CLAUDE_MODEL or CLAUDE_MODEL_LITE there and restart. On the server: journalctl -u verdict -p err --since -1h"
          },
          "isPaused": false
        },
        {
          "uid": "judge-app-inactive",
          "title": "App not running",
          "folderUID": "judge",
          "ruleGroup": "critical",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "${PROM_UID}",
              "model": {
                "refId": "A",
                "expr": "node_systemd_unit_state{app=\"judge\", name=\"verdict.service\", state=\"active\"}",
                "instant": true,
                "range": false
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "A",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "conditions": [
                  {
                    "evaluator": {
                      "type": "lt",
                      "params": [
                        1
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "for": "6m",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "severity": "critical"
          },
          "annotations": {
            "summary": "verdict.service has not been active for 6 minutes.",
            "description": "On the server: systemctl status verdict; journalctl -u verdict -n 100. A deploy that fails its health check rolls back on its own; run sudo verdict-update to see why."
          },
          "isPaused": false
        },
        {
          "uid": "judge-disk-full",
          "title": "Disk full",
          "folderUID": "judge",
          "ruleGroup": "critical",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "${PROM_UID}",
              "model": {
                "refId": "A",
                "expr": "100 * (1 - node_filesystem_avail_bytes{app=\"judge\", fstype=~\"ext4|xfs|btrfs\"} / node_filesystem_size_bytes{app=\"judge\", fstype=~\"ext4|xfs|btrfs\"})",
                "instant": true,
                "range": false
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "A",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "conditions": [
                  {
                    "evaluator": {
                      "type": "gte",
                      "params": [
                        90
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "for": "5m",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "severity": "critical"
          },
          "annotations": {
            "summary": "The disk at {{ $labels.mountpoint }} is {{ humanize $values.A.Value }}% full.",
            "description": "Once it is full, the database and the backups stop working. On the server: sudo du -xh --max-depth=2 / | sort -h | tail -n 15"
          },
          "isPaused": false
        },
        {
          "uid": "judge-cert-expiry",
          "title": "Certificate expiring",
          "folderUID": "judge",
          "ruleGroup": "critical",
          "condition": "C",
          "data": [
            {
              "refId": "A",
              "relativeTimeRange": {
                "from": 600,
                "to": 0
              },
              "datasourceUid": "${PROM_UID}",
              "model": {
                "refId": "A",
                "expr": "min by (instance) (probe_ssl_earliest_cert_expiry{job=\"judge-site\"} - time()) / 86400",
                "instant": true,
                "range": false
              }
            },
            {
              "refId": "C",
              "datasourceUid": "__expr__",
              "model": {
                "refId": "C",
                "type": "threshold",
                "expression": "A",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "conditions": [
                  {
                    "evaluator": {
                      "type": "lt",
                      "params": [
                        10
                      ]
                    }
                  }
                ]
              }
            }
          ],
          "for": "10m",
          "noDataState": "OK",
          "execErrState": "Error",
          "labels": {
            "severity": "critical"
          },
          "annotations": {
            "summary": "The certificate for {{ $labels.instance }} expires in {{ humanize $values.A.Value }} days.",
            "description": "Caddy renews about 30 days ahead, so renewal has been failing: journalctl -u caddy -n 200 | grep -i -e acme -e certificate; often DNS or a firewall blocking port 80/443. Behind Cloudflare this is Cloudflare's certificate; the watcher still checks Caddy's own."
          },
          "isPaused": false
        }
      ]
    },
