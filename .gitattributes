# Deploy files run on Linux: keep LF line endings even in Windows checkouts.
*.sh text eol=lf
Caddyfile text eol=lf
*.service text eol=lf
*.timer text eol=lf
# The bundled scene is compared byte for byte by build-scene.ts --check.
mobile/android/app/src/main/assets/scene/index.html -text -diff
mobile/ios/Judge/Resources/Scene/index.html -text -diff
# Generated by mobile/shared/*/export-*.ts and compared byte for byte by --check.
mobile/android/app/src/main/res/values/strings.xml text eol=lf
mobile/android/app/src/main/res/values-tr/strings.xml text eol=lf
mobile/android/app/src/main/java/com/okjudge/judge/i18n/Strings.kt text eol=lf
mobile/ios/Judge/Resources/Localizable.xcstrings text eol=lf
mobile/ios/Judge/Generated/L10n.swift text eol=lf
mobile/shared/fixtures/*.json text eol=lf
