# Copy to .env and fill in. NEVER commit real keys.
# REQUIRED — get a key at https://aistudio.google.com/apikey. Without it the app refuses to judge.
GEMINI_API_KEY=""

# Storage. Local development and tests use a libSQL file.
DATABASE_URL="file:./dev.db"
# Production (Vercel): set both to use Turso instead; DATABASE_URL is then ignored.
# Create them with `turso db show --url <db>` and `turso db tokens create <db>`.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""
