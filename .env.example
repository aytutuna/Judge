# Copy to .env and fill in. NEVER commit real keys.
# On Vercel, set the same variables under Project -> Settings -> Environment Variables.
# On AWS Lightsail, deploy/aws-lightsail/setup.sh writes them to /etc/verdict/verdict.env.

# --- Model (required) ---------------------------------------------------------
# Get a key at https://console.anthropic.com. Without it the app refuses to judge.
ANTHROPIC_API_KEY=""

# --- Storage ------------------------------------------------------------------
# Empty = local SQLite file ./dev.db. On a single server (Lightsail guide) a file
# such as file:/var/lib/verdict/verdict.db; on Vercel your Turso URL, e.g.
# libsql://verdict-<you>.turso.io
DATABASE_URL=""
# Turso database token (only needed for a libsql:// URL).
DATABASE_AUTH_TOKEN=""

# --- Stored originals (required in production) --------------------------------
# Encrypts every stored original text, name map and share-page display name,
# and the Sign in with Apple refresh tokens kept for revocation on account
# deletion (AES-256-GCM). 32 random bytes, base64: openssl rand -base64 32
# Back it up apart from the database (e.g. a password manager): losing it makes
# the stored originals unreadable; leaking it with a database copy exposes them.
# Empty in development = a fixed development key. Empty in production =
# originals and display names are NOT stored (verdicts still work; logged).
ORIGINALS_KEY=""
# Older keys, comma-separated, used only to decrypt after rotating ORIGINALS_KEY.
ORIGINALS_KEY_PREVIOUS=""
# Append-only log of removals (ids and times only), kept outside the database
# so a restored backup can have them re-applied (scripts/originals.ts
# replay-removals). Empty = removals.log beside a local database file;
# "off" = no log.
REMOVAL_LOG=""

# --- Abuse and cost limits ------------------------------------------------------
# Upstash Redis (REST) for rate limits shared across all server instances.
# Empty = in-memory limits, which only hold within one process (fine locally and
# on a single-process server such as the Lightsail guide's; not on Vercel).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Secret key for hashing visitor IPs in the rate-limit store (any long random
# string, e.g. `openssl rand -hex 32`). Empty = the Upstash token is used.
RATE_LIMIT_SALT=""

# --- Bot check (Cloudflare Turnstile) -------------------------------------------
# Site key: shown to browsers. Empty = no widget is rendered.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
# Secret key: server-side verification. Empty = verification skipped (local dev).
TURNSTILE_SECRET_KEY=""

# --- Public site ----------------------------------------------------------------
# Public origin for canonical links, link previews, robots.txt and the sitemap,
# e.g. https://verdict.example.org. Empty = the Vercel production domain, else
# http://localhost:3000. Read at build time: redeploy after changing it.
NEXT_PUBLIC_SITE_URL=""
# Inbox shown on /privacy for questions and removal requests. Empty (or an
# example.com placeholder) = the contact section is hidden. Build time too.
CONTACT_EMAIL=""

# --- Accounts and Premium -------------------------------------------------------
# All optional: without them the free site runs exactly as before.
# Signs session cookies: at least 32 random characters (openssl rand -base64 32).
# Required in production for accounts and Premium; locally a development secret
# is used when empty.
BETTER_AUTH_SECRET=""
# Public origin for sign-in callbacks, e.g. https://verdict.example.org.
# Empty = NEXT_PUBLIC_SITE_URL, else the local host (development).
BETTER_AUTH_URL=""
# Google sign-in: an OAuth client of type "Web application" with redirect URI
# <origin>/api/auth/callback/google.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Extra accepted Google ID-token audiences for the future mobile app.
GOOGLE_IOS_CLIENT_ID=""
GOOGLE_ANDROID_CLIENT_ID=""
# Sign in with Apple (web): Services ID, team id, key id, and the whole
# AuthKey_<KEYID>.p8 file base64-encoded on one line (base64 -w0 AuthKey_XXXX.p8).
# Return URL to register: <origin>/api/auth/callback/apple
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY_BASE64=""
# iOS bundle id: accepted for native Sign in with Apple, and the client id the
# app's authorization code is exchanged with (POST /api/v1/auth/apple/code) so
# the token can be revoked when the account is deleted. The Apple key above must
# be enabled for the primary App ID that groups the Services ID and this app.
APPLE_APP_BUNDLE_ID=""
# Email sign-in links via Resend (https://resend.com). EMAIL_FROM must be on a
# domain verified in Resend, e.g. "Judge <signin@okjudge.com>".
RESEND_API_KEY=""
EMAIL_FROM=""
# Store reviewers' test account: this address always gets this 6-digit code in
# the apps' email sign-in and no email is sent to it. Needs email sign-in above.
# Use a dedicated address on your own domain. See the README.
REVIEW_ACCOUNT_EMAIL=""
REVIEW_ACCOUNT_CODE=""
# 1 = show a test sign-in for local testing. Works only under
# `npm run dev:login` (next dev bound to 127.0.0.1, so other machines on the
# network cannot reach it), never in a production build, and only for
# requests to localhost / 127.0.0.1 / [::1]. Plain `npm run dev` listens on
# every interface, so the test sign-in stays off there.
DEV_LOGIN=""
# Premium switches and limits (defaults in brackets).
# PREMIUM_ENABLED="1"            # 0 turns Premium off
# PREMIUM_DAILY_CAP="500"        # premium verdicts per UTC day; 0 pauses Premium
# PREMIUM_JUDGE_MODELS="claude-sonnet-5-5,claude-sonnet-5-5,claude-haiku-5-5"
# PREMIUM_SONNET_EFFORT="medium" # low, medium or high
# PREMIUM_FACTCHECK_MODEL="claude-haiku-5-5"
# PREMIUM_FACTCHECK_MAX_SEARCHES="3"
# Store purchases (in-app purchases through RevenueCat; see README "Purchases").
# 1 = GET /api/v1/config reports pricing.purchasesEnabled: true (the apps show
# their buy buttons). Empty = false.
PURCHASES_ENABLED=""
# The Authorization header RevenueCat sends to /api/v1/webhooks/revenuecat:
# in the RevenueCat dashboard set it to "Bearer <this value>". Any long random
# string (openssl rand -hex 32). Empty = the webhook answers 503.
REVENUECAT_WEBHOOK_SECRET=""
# 1 = also apply SANDBOX purchases (TestFlight, Play test tracks). Never on the
# live server: sandbox purchases are free.
# ALLOW_SANDBOX_PURCHASES=""
# Two-sided cases and appeals, and screenshot evidence (both need Premium).
# CASES_ENABLED="1"              # 0 turns two-sided cases and appeals off
# EVIDENCE_ENABLED="1"           # 0 turns screenshot evidence off
# EVIDENCE_MODEL="claude-haiku-5-5"  # vision model that transcribes evidence images

# --- Error reports (Sentry) -----------------------------------------------------
# Project DSN (Settings -> Client Keys). Empty = no error reports are sent.
# Server errors use SENTRY_DSN at run time; browser errors use
# NEXT_PUBLIC_SENTRY_DSN, read at build time. Usually both hold the same DSN.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Source map upload at build time, so browser stack traces are readable. Only
# when all three are set; the maps are deleted from the build after the upload.
# The token is an organization auth token (Settings -> Auth Tokens). Only the
# build uses it: on the Lightsail server verdict.service removes it from the
# running app's environment.
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# --- Optional tuning (uncomment to override the defaults) -----------------------
# Judge and crux-trial model.
# CLAUDE_MODEL="claude-haiku-5-5"
# Anonymizer model.
# CLAUDE_MODEL_LITE="claude-haiku-5-5"
# Thinking depth for judge and trial calls: low, medium or high.
# JUDGE_EFFORT="medium"
# Self-consistency runs per verdict (1-3).
# JUDGE_RUNS="3"
# Extra judges (0-4) called in when a verdict's confidence is low; their votes
# are counted with the first round. About $0.002 per escalated verdict at 2.
# Set to 0 to turn escalation off.
# JUDGE_EXTRA_RUNS="2"
# Escalate when the first round's confidence (1-5) is at or below this.
# JUDGE_ESCALATE_AT="2"
# Set to 0 to skip the crux cross-examination (up to 2 extra calls per verdict).
# CRUX_TRIAL="1"
